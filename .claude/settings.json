{
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/foreground-only.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "implementer",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/implementer-gate.sh\"",
            "timeout": 900,
            "statusMessage": "Running the quality gate"
          }
        ]
      }
    ]
  }
}
