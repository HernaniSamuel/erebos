// `core::arch` on riscv32 (ADR 0080): the part of `core` that needs an
// instruction of the target, written with `asm` (ADR 0079). The compiler reads
// this file only for `riscv32imac-unknown-none-elf`; `rt/arch/armv7m.ers` is
// its counterpart.
//
// A portable item is declared in every file of `core::arch` with the same
// kind, name and signature, so that a program using only portable items
// builds for every target. The list below is read by `tests/e2e.rs`, which
// checks that the files agree, that each line is the declaration it lists and
// that a program calling every item builds; one line per item, each starting
// with `// portable:`. Every other item of this file is specific to this
// target, and a program that names one builds only for it.
//
// portable: pub fn compiler_fence()
// portable: pub fn fence()
// portable: pub fn enable_interrupts()
// portable: pub fn wait_for_interrupt()
// portable: pub fn interrupts_enabled() -> bool

// --- Fences (ADR 0081) -------------------------------------------------------

// Emits no instruction: no access to memory that other code can see moves
// across it in the generated code. It orders nothing in the hardware. The
// `asm` has no memory option, so it is ordered like any `asm`.
pub fn compiler_fence() {
    asm("", options(nostack, preserves_flags));
}

// A compiler fence and a hardware fence: every access to memory or to a
// device before it, ordinary or volatile, is observed by every other observer
// before any access after it. `fence iorw, iorw` orders input, output, reads
// and writes, where LLVM's own `fence` leaves I/O out.
pub fn fence() {
    asm("fence iorw, iorw", options(nostack, preserves_flags));
}

// --- Interrupts (ADR 0086) ---------------------------------------------------

// Lets maskable handlers run: `csrsi mstatus, 8` sets `mstatus.MIE`. Each source
// has its own enable (`mie`), which is the program's. The `asm` has no memory
// option, so this is a compiler fence: statics written before it are in memory.
// Inside a critical section or a handler it ends that protection.
pub fn enable_interrupts() {
    asm("csrsi mstatus, 8", options(nostack, preserves_flags));
}

// Runs `wfi`, a compiler fence too. It may return for no reason, so it belongs in
// a loop; inside a `critical` block it returns for a pending interrupt, which
// runs at the end of the block (ADR 0086).
pub fn wait_for_interrupt() {
    asm("wfi", options(nostack, preserves_flags));
}

// Reads `mstatus.MIE`, and nothing else: whether a source is enabled (`mie`) is
// not part of the answer. False in a critical section.
pub fn interrupts_enabled() -> bool {
    let mut mstatus: u32 = 0;
    asm("csrr {}, mstatus", out(reg) mstatus, options(nostack, preserves_flags));
    (mstatus & 8) != 0
}

// --- Critical sections (ADR 0086) --------------------------------------------

// What a `critical` block calls where it starts and where it ends, on every
// path out of it. The compiler names them by their path, and their `__` keeps
// a program from naming them, so `critical` stays the only form. Neither `asm`
// has a memory option, so both are compiler fences, as ADR 0078 asks of the
// block's entry and exit.

// Clears `mstatus.MIE` and returns what it was (`csrrci` reads the old value),
// in bit 3: 8 if interrupts were enabled, 0 if not.
fn __critical_enter() -> u32 {
    let mut was: u32 = 0;
    asm("csrrci {}, mstatus, 8", out(reg) was, options(nostack, preserves_flags));
    was & 8
}

// Sets back what `__critical_enter` returned: `csrs` sets `MIE` if `was` is 8
// and changes nothing if it is 0, so a block entered masked leaves it masked.
fn __critical_exit(was: u32) {
    asm("csrs mstatus, {}", in(reg) was, options(nostack, preserves_flags));
}

// --- The reset entry (ADR 0083) ----------------------------------------------

// What runs first, at the origin of the code's region: the compiler puts it in
// the section `.text.start`, which the linker script places there alone (ADR
// 0057), and names it by its path, as it names `PanicInfo`. It is private and
// `#[export]`, so its symbol is `_start` and no program can name it. It does
// exactly this, in this order, and nothing else (ADR 0030):
//
// 1. Mask interrupts (`csrci mstatus, 8`, ADR 0086), so that the entry function
//    starts masked also when a program jumps back to `_start`, and no handler
//    sees `.bss` and `.data` half done. The program enables them when it is
//    ready (`enable_interrupts`).
// 2. Set the stack pointer to the top of the stack. Nothing before this point
//    may use the stack, and nothing here does.
// 3. Fill `.bss` with zeros, a word at a time between the linker script's
//    symbols, testing the bound before the first word.
// 4. Copy `.data` from its load address, in the same way. This comes after
//    `.bss` only because both are independent; neither reads the other.
// 5. Jump to the entry function, which is the first compiled code to run, so
//    every static holds its value when it starts. `tail` (`auipc` and `jalr`)
//    reaches the whole address space, where `j` reached only 1 MiB.
//
// The linker script's symbols are written by name: declaring them as `extern
// static`s to name them with `sym` would check nothing more. The labels are
// local, as ADR 0079 asks of every template.
#[export]
#[naked]
fn _start() -> ! {
    asm(
        "csrci mstatus, 8",
        "la sp, __stack_end",
        "la t0, __bss_start",
        "la t1, __bss_end",
        "1:",
        "bgeu t0, t1, 2f",
        "sw zero, 0(t0)",
        "addi t0, t0, 4",
        "j 1b",
        "2:",
        "la t0, __data_start",
        "la t1, __data_end",
        "la t2, __data_load",
        "3:",
        "bgeu t0, t1, 4f",
        "lw t3, 0(t2)",
        "sw t3, 0(t0)",
        "addi t0, t0, 4",
        "addi t2, t2, 4",
        "j 3b",
        "4:",
        "tail {}",
        sym entry,
        options(noreturn),
    );
}
