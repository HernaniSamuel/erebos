// `core::arch` on thumbv7m (ADR 0080): the part of `core` that needs an
// instruction of the target, written with `asm` (ADR 0079). The compiler reads
// this file only for `thumbv7m-none-eabi`; `rt/arch/riscv32.ers` is its
// counterpart.
//
// A portable item is declared in every file of `core::arch` with the same
// kind, name and signature, so that a program using only portable items
// builds for every target. The list below is read by `tests/e2e.rs`, which
// checks that the files agree, that each line is the declaration it lists and
// that a program calling every item builds; one line per item, each starting
// with `// portable:`. Every other item of this file is specific to this
// target, and a program that names one builds only for it.
//
// portable: pub fn compiler_fence()
// portable: pub fn fence()

// --- Fences (ADR 0081) -------------------------------------------------------

// Emits no instruction: no access to memory that other code can see moves
// across it in the generated code. It orders nothing in the hardware. The
// `asm` has no memory option, so it is ordered like any `asm`.
pub fn compiler_fence() {
    asm("", options(nostack, preserves_flags));
}

// A compiler fence and a hardware fence: every access to memory or to a
// device before it, ordinary or volatile, is observed by every other observer
// before any access after it. `dmb sy` is the full system barrier.
pub fn fence() {
    asm("dmb sy", options(nostack, preserves_flags));
}

// --- The EABI's 64-bit division (ADR 0080) ----------------------------------
//
// C code that divides 64-bit values on this target calls these, which clang
// names by the ARM EABI: the dividend is in `r0`-`r1` and the divisor in
// `r2`-`r3`, and the quotient comes back in `r0`-`r1` and the remainder in
// `r2`-`r3`, which no signature of Erebos can say, so they are naked. Each
// keeps `r4` and `lr`, makes a 16-byte frame (the stack stays 8-aligned, as
// the C ABI wants at a call) with the pointer for the remainder at its
// bottom, the fifth word of the call, and the remainder's own place above it,
// and calls the function of `core::builtins` that divides, with the arguments
// it was given in `r0`-`r3`. Nothing calls them from Erebos, which divides
// through the functions of ADR 0076. A zero divisor is not checked (C leaves
// it undefined, and `__aeabi_ldiv0` is not called).

#[export]
#[naked]
fn __aeabi_uldivmod() {
    asm(
        "push {{r4, lr}}",
        "sub sp, sp, #16",
        "add r4, sp, #8",
        "str r4, [sp]",
        "bl {div}",
        "ldrd r2, r3, [sp, #8]",
        "add sp, sp, #16",
        "pop {{r4, pc}}",
        div = sym crate::builtins::__erebos_udivmoddi4,
        options(noreturn),
    );
}

#[export]
#[naked]
fn __aeabi_ldivmod() {
    asm(
        "push {{r4, lr}}",
        "sub sp, sp, #16",
        "add r4, sp, #8",
        "str r4, [sp]",
        "bl {div}",
        "ldrd r2, r3, [sp, #8]",
        "add sp, sp, #16",
        "pop {{r4, pc}}",
        div = sym crate::builtins::__erebos_divmoddi4,
        options(noreturn),
    );
}
