// `core::arch` on thumbv7m (ADR 0080): the part of `core` that needs an
// instruction of the target, written with `asm` (ADR 0079). The compiler reads
// this file only for `thumbv7m-none-eabi`; `rt/arch/riscv32.ers` is its
// counterpart.
//
// A portable item is declared in every file of `core::arch` with the same
// kind, name and signature, so that a program using only portable items
// builds for every target. The list below is read by `tests/e2e.rs`, which
// checks that the files agree, that each line is the declaration it lists and
// that a program calling every item builds; one line per item, each starting
// with `// portable:`. Every other item of this file is specific to this
// target, and a program that names one builds only for it.
//
// portable: pub fn compiler_fence()
// portable: pub fn fence()
// portable: pub fn enable_interrupts()
// portable: pub fn wait_for_interrupt()
// portable: pub fn interrupts_enabled() -> bool

// --- Fences (ADR 0081) -------------------------------------------------------

// Emits no instruction: no access to memory that other code can see moves
// across it in the generated code. It orders nothing in the hardware. The
// `asm` has no memory option, so it is ordered like any `asm`.
pub fn compiler_fence() {
    asm("", options(nostack, preserves_flags));
}

// A compiler fence and a hardware fence: every access to memory or to a
// device before it, ordinary or volatile, is observed by every other observer
// before any access after it. `dmb sy` is the full system barrier.
pub fn fence() {
    asm("dmb sy", options(nostack, preserves_flags));
}

// --- Interrupts (ADR 0086) ---------------------------------------------------

// Lets maskable handlers run: `cpsie i` clears `PRIMASK`. Each source has its
// own enable (SysTick's `TICKINT`, the NVIC), which is the program's. The `asm`
// has no memory option, so this is a compiler fence: statics written before it
// are in memory. Inside a critical section or a handler it ends that
// protection.
pub fn enable_interrupts() {
    asm("cpsie i", options(nostack, preserves_flags));
}

// Runs `wfi`, a compiler fence too. It may return for no reason, so it belongs in
// a loop; inside a `critical` block it returns for a pending interrupt, which
// runs at the end of the block (ADR 0086).
pub fn wait_for_interrupt() {
    asm("wfi", options(nostack, preserves_flags));
}

// Reads the mask state and nothing else: true when `PRIMASK` is 0 and `IPSR` is
// 0, so that a handler finds it false, as on riscv32. It does not read `BASEPRI`
// or `FAULTMASK`, which a program of this model leaves at 0 (ADR 0078), nor
// whether a source is enabled. False in a critical section.
pub fn interrupts_enabled() -> bool {
    let mut primask: u32 = 0;
    let mut ipsr: u32 = 0;
    asm(
        "mrs {}, primask",
        "mrs {}, ipsr",
        out(reg) primask,
        out(reg) ipsr,
        options(nostack, preserves_flags),
    );
    primask == 0 && ipsr == 0
}

// --- The reset entry (ADR 0083) ----------------------------------------------

// What runs first: the compiler puts it in the section `.text.start`, which
// the linker script places after the vector table's section, `.vector_table`
// (ADR 0074), whose second word is its address. It is private and `#[export]`,
// so its symbol is `_start` and no program can name it. It does exactly this,
// in this order, and nothing else (ADR 0030):
//
// 1. Mask interrupts (`cpsid i`, ADR 0086), so that the entry function starts
//    masked as on riscv32, also when a program jumps back to `_start`, and no
//    handler sees `.bss` and `.data` half done. The program enables them when
//    it is ready (`enable_interrupts`).
// 2. Set the stack pointer to the top of the stack. Nothing before this point
//    may use the stack, and nothing here does.
// 3. Fill `.bss` with zeros, a word at a time between the linker script's
//    symbols, testing the bound before the first word.
// 4. Copy `.data` from its load address, in the same way. This comes after
//    `.bss` only because both are independent; neither reads the other.
// 5. Jump to the entry function, which is the first compiled code to run, so
//    every static holds its value when it starts. Each address is loaded with
//    a `movw`/`movt` pair, which needs no literal pool kept inside the
//    section, and reaches the whole address space; a Thumb function's symbol
//    has bit 0 set, as `bx` needs.
//
// The linker script's symbols are written by name: declaring them as `extern
// static`s to name them with `sym` would check nothing more. The labels are
// local, as ADR 0079 asks of every template.
#[export]
#[naked]
fn _start() -> ! {
    asm(
        "cpsid i",
        "movw r0, :lower16:__stack_end",
        "movt r0, :upper16:__stack_end",
        "mov sp, r0",
        "movw r0, :lower16:__bss_start",
        "movt r0, :upper16:__bss_start",
        "movw r1, :lower16:__bss_end",
        "movt r1, :upper16:__bss_end",
        "movs r2, #0",
        "1:",
        "cmp r0, r1",
        "bhs 2f",
        "str r2, [r0], #4",
        "b 1b",
        "2:",
        "movw r0, :lower16:__data_start",
        "movt r0, :upper16:__data_start",
        "movw r1, :lower16:__data_end",
        "movt r1, :upper16:__data_end",
        "movw r2, :lower16:__data_load",
        "movt r2, :upper16:__data_load",
        "3:",
        "cmp r0, r1",
        "bhs 4f",
        "ldr r3, [r2], #4",
        "str r3, [r0], #4",
        "b 3b",
        "4:",
        "movw r0, :lower16:{0}",
        "movt r0, :upper16:{0}",
        "bx r0",
        sym entry,
        options(noreturn),
    );
}

// --- The EABI's 64-bit division (ADR 0080) ----------------------------------
//
// C code that divides 64-bit values on this target calls these, which clang
// names by the ARM EABI: the dividend is in `r0`-`r1` and the divisor in
// `r2`-`r3`, and the quotient comes back in `r0`-`r1` and the remainder in
// `r2`-`r3`, which no signature of Erebos can say, so they are naked. Each
// keeps `r4` and `lr`, makes a 16-byte frame (the stack stays 8-aligned, as
// the C ABI wants at a call) with the pointer for the remainder at its
// bottom, the fifth word of the call, and the remainder's own place above it,
// and calls the function of `core::builtins` that divides, with the arguments
// it was given in `r0`-`r3`. Nothing calls them from Erebos, which divides
// through the functions of ADR 0076. A zero divisor is not checked (C leaves
// it undefined, and `__aeabi_ldiv0` is not called).

#[export]
#[naked]
fn __aeabi_uldivmod() {
    asm(
        "push {{r4, lr}}",
        "sub sp, sp, #16",
        "add r4, sp, #8",
        "str r4, [sp]",
        "bl {div}",
        "ldrd r2, r3, [sp, #8]",
        "add sp, sp, #16",
        "pop {{r4, pc}}",
        div = sym crate::builtins::__erebos_udivmoddi4,
        options(noreturn),
    );
}

#[export]
#[naked]
fn __aeabi_ldivmod() {
    asm(
        "push {{r4, lr}}",
        "sub sp, sp, #16",
        "add r4, sp, #8",
        "str r4, [sp]",
        "bl {div}",
        "ldrd r2, r3, [sp, #8]",
        "add sp, sp, #16",
        "pop {{r4, pc}}",
        div = sym crate::builtins::__erebos_divmoddi4,
        options(noreturn),
    );
}
