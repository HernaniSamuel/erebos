// Runtime support functions (ADR 0020), the module `core::builtins`
// (ADR 0052).
//
// LLVM emits calls to these functions, named as in libgcc/compiler-rt, the
// C library and the ARM EABI, for operations the target has no instruction
// for. They are compiled into every program, in plain Erebos, so nothing
// runs that the repository does not show (ADR 0002). Each is `#[export]`, so
// that its symbol is the name LLVM calls (ADR 0051); `memcpy`, `memmove` and
// `memset` are also `pub`, offered to programs as `core::memcpy` and so on.
// The `__erebos_` helpers are private and keep their paths as symbols
// (`core.builtins.__erebos_udivmod64`). The compiler marks every function of
// `core` `no-builtins`, so LLVM does not turn their loops back into calls.

// --- Memory ---------------------------------------------------------------
//
// Copies and fills of large arrays and structs become calls to these, and
// at `-O` so do copy and fill loops. Byte by byte: small and obviously
// right; speed can come later.

#[export]
pub fn memcpy(dest: *mut u8, src: *const u8, n: usize) -> *mut u8 {
    let mut i: usize = 0;
    while i < n {
        dest[i] = src[i];
        i += 1;
    }
    dest
}

// Like `memcpy`, but the two areas may overlap: copying backwards when the
// destination is above the source never overwrites bytes not yet copied.
#[export]
pub fn memmove(dest: *mut u8, src: *const u8, n: usize) -> *mut u8 {
    if (dest as usize) < (src as usize) {
        return memcpy(dest, src, n);
    }
    let mut i: usize = n;
    while i > 0 {
        i -= 1;
        dest[i] = src[i];
    }
    dest
}

// `c` is a C `int`; only its low byte is stored.
#[export]
pub fn memset(dest: *mut u8, c: i32, n: usize) -> *mut u8 {
    let byte: u8 = c as u8;
    let mut i: usize = 0;
    while i < n {
        dest[i] = byte;
        i += 1;
    }
    dest
}

// --- ARM EABI memory functions ----------------------------------------------
//
// On ARM EABI targets LLVM copies, moves and fills memory through these
// instead of `memcpy`, `memmove` and `memset` (ADR 0074). They are defined on
// every target, and nothing calls them on riscv32, except C code that names
// them. Each calls the general function and ignores the alignment promise of
// its `4` and `8` forms (a destination, and a source, aligned to 4 or 8
// bytes): byte by byte, it needs none. None returns a value.

#[export]
fn __aeabi_memcpy(dest: *mut u8, src: *const u8, n: usize) {
    memcpy(dest, src, n);
}

#[export]
fn __aeabi_memcpy4(dest: *mut u8, src: *const u8, n: usize) {
    memcpy(dest, src, n);
}

#[export]
fn __aeabi_memcpy8(dest: *mut u8, src: *const u8, n: usize) {
    memcpy(dest, src, n);
}

#[export]
fn __aeabi_memmove(dest: *mut u8, src: *const u8, n: usize) {
    memmove(dest, src, n);
}

#[export]
fn __aeabi_memmove4(dest: *mut u8, src: *const u8, n: usize) {
    memmove(dest, src, n);
}

#[export]
fn __aeabi_memmove8(dest: *mut u8, src: *const u8, n: usize) {
    memmove(dest, src, n);
}

// `memset`'s `n` and `c` swapped: the EABI puts the length before the value.
// Only the low byte of `c` is stored.
#[export]
fn __aeabi_memset(dest: *mut u8, n: usize, c: i32) {
    memset(dest, c, n);
}

#[export]
fn __aeabi_memset4(dest: *mut u8, n: usize, c: i32) {
    memset(dest, c, n);
}

#[export]
fn __aeabi_memset8(dest: *mut u8, n: usize, c: i32) {
    memset(dest, c, n);
}

// A fill with zero: no value argument.
#[export]
fn __aeabi_memclr(dest: *mut u8, n: usize) {
    memset(dest, 0, n);
}

#[export]
fn __aeabi_memclr4(dest: *mut u8, n: usize) {
    memset(dest, 0, n);
}

#[export]
fn __aeabi_memclr8(dest: *mut u8, n: usize) {
    memset(dest, 0, n);
}

// --- 64-bit division --------------------------------------------------------
//
// No target divides 64-bit values in one instruction, and these are what
// `/` and `%` on u64 and i64 call. Who calls them depends on the target's
// `div64` (ADR 0076): where it is true, as on riscv32, LLVM does, when it
// does not expand the division inline, and so does C code linked into the
// program; where it is false, code generation calls them for every such
// division, since LLVM's call would use a convention C cannot write. They
// must not use `/` or `%` on 64-bit values themselves. A zero divisor never
// reaches them, since division checks happen before the call (ADR 0007).

// Restoring binary long division: one quotient bit per step, from the top.
// Returns the remainder if `remainder` is true, otherwise the quotient.
fn __erebos_udivmod64(n: u64, d: u64, remainder: bool) -> u64 {
    let mut quotient: u64 = 0;
    let mut rest: u64 = 0;
    let mut bit: u32 = 64;
    while bit > 0 {
        bit -= 1;
        rest = (rest << 1) | ((n >> bit) & 1);
        if rest >= d {
            rest -= d;
            quotient |= 1 << bit;
        }
    }
    if remainder { rest } else { quotient }
}

// The magnitude of a signed value; `0 - MIN` wraps to MIN, which is 2^63
// as a u64, so every value has its exact magnitude.
fn __erebos_magnitude64(x: i64) -> u64 {
    if x < 0 { (0 - x) as u64 } else { x as u64 }
}

#[export]
fn __udivdi3(n: u64, d: u64) -> u64 {
    __erebos_udivmod64(n, d, false)
}

#[export]
fn __umoddi3(n: u64, d: u64) -> u64 {
    __erebos_udivmod64(n, d, true)
}

// Signed division truncates toward zero: the quotient is negative when
// exactly one operand is.
#[export]
fn __divdi3(a: i64, b: i64) -> i64 {
    let magnitude: u64 = __erebos_udivmod64(__erebos_magnitude64(a), __erebos_magnitude64(b), false);
    if (a < 0) != (b < 0) { 0 - magnitude as i64 } else { magnitude as i64 }
}

// The remainder takes the sign of the dividend.
#[export]
fn __moddi3(a: i64, b: i64) -> i64 {
    let magnitude: u64 = __erebos_udivmod64(__erebos_magnitude64(a), __erebos_magnitude64(b), true);
    if a < 0 { 0 - magnitude as i64 } else { magnitude as i64 }
}
