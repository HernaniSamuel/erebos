// emit: typeck
// A `static` is never written: assigning it or taking a `*mut` address is
// an error. `#[align(N)]` on a static follows the struct rules (ADR 0030).
static LIMIT: u32 = 10;
static mut COUNT: u32 = 0;

#[align(3)]
static ODD: u32 = 0;
#[align(2)]
static LOW: u32 = 0;
#[align(4_294_967_296)]
static HIGH: u8 = 0;
#[align(64)]
static mut FINE: u32 = 0;

fn writes() {
    LIMIT = 5;
    LIMIT += 1;
    let p: *mut u32 = &raw mut LIMIT;
    COUNT = 5;
    let q: *mut u32 = &raw mut COUNT;
    let r: *const u32 = &raw const LIMIT;
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
