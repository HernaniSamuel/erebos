// emit: typeck
// References to peripherals and clusters (ADR 0110). `&P` and `&mut P`, with
// `P` a peripheral, and `&P.c`, `&mut P.c`, `&P.cs[i]` and `&mut P.cs[i]`, with
// `c` a cluster and `cs` a cluster array, are `&T` and `&mut T` with `T` the
// peripheral type. Registers are reached through them as through a pointer to
// `T`: read where the mode has `read`, written through a `&mut` where it has
// `write`, a compound assignment needing both. A driver takes `&mut Uart16550`
// instead of `*mut Uart16550`, a reader takes `&Uart16550`, and a `&mut`
// converts to a `&`. A reference to a peripheral type is also made from
// another, `&mut (*p).ctx[i]` and `&mut *u`, and casts to a raw pointer.
peripheral Uart16550 {
    read rbr: u8 at 0,
    write thr: u8 at 0,
    read write ier: u8 at 1,
    read lsr: u8 at 5,
}

peripheral Context {
    read write threshold: u32 at 0,
    read claim: u32 at 4,
    read write words: [u16; 3] at 0x10 step 4,
}

peripheral Plic {
    read write priority: [u32; 96] at 0,
    ctx: [Context; 2] at 0x1000 step 0x100,
    first: Context at 0x2000,
}

peripheral UART0: Uart16550 at 0x1000_0000;
peripheral PLIC: Plic at 0x0C00_0000;

// The driver and its reader of the plan: a `&mut` is lent, a `&` is lent.
fn ready(u: &Uart16550) -> bool {
    ((*u).lsr & 0x20) != 0
}

fn putc(u: &mut Uart16550, byte: u8) {
    while !ready(u) {}
    (*u).thr = byte;
    (*u).ier |= 1;
}

// A peripheral, borrowed and lent; a reference kept in a variable.
fn peripheral() -> u8 {
    putc(&mut UART0, b'h');
    let shared: &Uart16550 = &UART0;
    let byte: u8 = (*shared).rbr;
    let mutable: &mut Uart16550 = &mut UART0;
    (*mutable).ier = 0;
    putc(mutable, byte);
    byte
}

// A reference to the type, made from another: a reborrow, and a pointer.
fn reborrow(u: &mut Uart16550) -> bool {
    putc(&mut *u, 1);
    let r: &Uart16550 = &*u;
    let p: *mut Uart16550 = &raw mut *u;
    (*p).ier = 2;
    ready(r)
}

fn cast(u: &mut Uart16550) -> *mut Uart16550 {
    u as *mut Uart16550
}

// The registers of a cluster and of a cluster array's element, through a
// reference to the cluster's type, and the register array of a cluster.
fn threshold(c: &mut Context, j: usize, v: u32) -> u32 {
    (*c).threshold = v;
    (*c).threshold += 1;
    (*c).words[j] = v as u16;
    (*c).claim + (*c).words[1] as u32
}

fn claim(c: &Context) -> u32 {
    (*c).claim + (*c).threshold
}

fn clusters(i: usize) -> u32 {
    let a: u32 = threshold(&mut PLIC.first, i, 1);
    let b: u32 = threshold(&mut PLIC.ctx[i], 0, 2);
    let c: u32 = threshold(&mut PLIC.ctx[1], 1, 3);
    let d: &Context = &PLIC.first;
    let e: &Context = &PLIC.ctx[i];
    let f: &mut Context = &mut PLIC.ctx[0];
    (*f).threshold = 4;
    a + b + c + claim(d) + claim(e) + claim(f)
}

// A reference to the whole PLIC: its registers, its register array, and the
// clusters below it, which are borrowed in turn.
fn plic(p: &mut Plic, i: usize) -> u32 {
    (*p).priority[i] = 1;
    (*p).first.threshold = 2;
    (*p).ctx[i].threshold = 3;
    let c: &mut Context = &mut (*p).ctx[i];
    let d: &Context = &(*p).first;
    (*c).threshold + claim(d)
}

fn lend_plic() -> u32 {
    plic(&mut PLIC, 1)
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
