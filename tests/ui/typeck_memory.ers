// emit: typeck
// The memory map with its values computed (ADR 0057), here from constants
// and a function called at compile time, shows first in the dump: regions
// in source order, origins in hexadecimal, then the placements.
const KIB: usize = 1024;
const FLASH_BASE: usize = 0x0800_0000;

fn kib(n: usize) -> usize {
    n * KIB
}

memory {
    stack in RAM { size: 2 * KIB }
    region FLASH { origin: FLASH_BASE, size: kib(64) }
    region RAM { origin: 0x2000_0000, size: kib(16) }
    region SRAM2 { origin: 0x2000_0000 + kib(16), size: 16 * KIB }
    data in RAM;
    code in FLASH;
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
