// emit: typeck
fn add(a: u32, b: u32) -> u32 {
    a + b
}

fn fib(n: u32) -> u32 {
    let mut previous: u32 = 0;
    let mut current: u32 = 1;
    let mut i: u32 = 0;
    while i < n {
        let next: u32 = previous + current;
        previous = current;
        current = next;
        i += 1;
    }
    previous
}

fn countdown(mut n: u8) -> bool {
    while n > 0 {
        n -= 1;
    }
    is_zero(n)
}

fn is_zero(x: u8) -> bool {
    x == 0
}

fn calls() -> u32 {
    add(1, fib(10))
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
