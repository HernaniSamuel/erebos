// emit: typeck
// Until M3.4a step 4 types accesses to register arrays and clusters, such an
// access is `{error}`: reported as `ty::register-array-access` where the
// type has a layout (`Uart`), and silent where it has none, that being
// reported (`Bad`'s `[u64; 2]` is `ty::register-type`). Never a panic nor an
// accepted program. Step 4 replaces this test with the real checks.
peripheral Uart {
    read write r: [u32; 2] at 0,
    sub: Block at 0x20,
}

peripheral Bad {
    read write wide: [u64; 2] at 0x10,
}

peripheral Block {
    read write data: u32 at 0,
}

peripheral UART: Uart at 0x1000_0000;
peripheral BAD: Bad at 0x2000_0000;

fn narrow() -> u32 { UART.r[0] }

fn wide() -> u64 { BAD.wide[0] }

fn cluster() -> u32 { UART.sub.data }

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
