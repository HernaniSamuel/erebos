// emit: typeck
// Registers with fields (ADR 0060): a register's type may be a bit-field
// struct or an enum without payloads on `u8`, `u16` or `u32`, as wide as
// that integer. Such a register is read and written whole, with literals
// and `..` too; its fields are read through it, and assigned or
// compound-assigned in a `read write` register, from a peripheral and
// through a pointer to its peripheral type. Registers whose reads have
// effects, their own (`read modifies`) or a field's of their type
// (`read clears`), are read explicitly, whole and by field, and written
// whole; a `write` register's read effect makes no field assignment wrong
// that its mode allows. Write effects only matter to compound assignments
// in volatile places: a field with one is assigned with `=`, and a
// compound assignment to it in ordinary memory, a local, is accepted, as
// are a field and a compound assignment to a local of a type whose fields
// have read effects. The dump shows the registers' read effects.
enum WordLength: u8 { Five = 0, Six = 1, Seven = 2, Eight = 3 }

enum Mode: u8 { Off = 0, On = 1 }

enum Speed: u16 { Slow = 0, Fast = 0x100 }

struct Lcr: u8 {
    pub word_length: WordLength at 0..=1 = .Five,
    pub two_stop_bits: bool at 2 = false,
    pub parity: bool at 3 = false,
    pub dlab: bool at 7 = false,
}

struct Lsr: u8 {
    pub data_ready: bool at 0,
    pub overrun: bool at 1 read clears,
    pub thr_empty: bool at 5,
}

struct Fcr: u8 {
    pub enable: bool at 0 = false,
    pub clear_rx: bool at 1 write 1 sets,
    pub trigger: u8 at 6..=7 = 0,
}

struct Status: u32 {
    pub enable: bool at 0 = false,
    pub count: u8 at 8..=15 = 0,
    pub overrun: bool at 16 write 1 clears,
    pub done: bool at 17 write 1 clears,
}

peripheral Uart {
    read rbr: u8 at 0 read modifies,
    write thr: u8 at 0,
    write fcr: Fcr at 2 read modifies,
    read write lcr: Lcr at 3,
    read lsr: Lsr at 5,
    read write mode: Mode at 6,
}

peripheral Timer {
    read write status: Status at 0,
    read write speed: Speed at 4,
}

peripheral UART0: Uart at 0x1000_0000;

peripheral TIMER0: Timer at 0x2000_0000;

// Whole reads and writes, of literals with and without `..` and of a
// value read before.
fn wholes() -> Lcr {
    let lcr: Lcr = UART0.lcr;
    UART0.lcr = Lcr { word_length: .Eight, .. };
    UART0.lcr = Lcr { word_length: .Eight, two_stop_bits: false, parity: true, dlab: false };
    UART0.lcr = lcr;
    UART0.fcr = Fcr { enable: true, .. };
    UART0.mode = .On;
    let mode: Mode = UART0.mode;
    TIMER0.speed = Speed::Fast;
    TIMER0.status = Status { count: 3, .. };
    lcr
}

// Field reads, assignments and compound assignments from a peripheral.
fn fields() -> bool {
    UART0.lcr.dlab = true;
    UART0.lcr.word_length = .Seven;
    let length: WordLength = UART0.lcr.word_length;
    TIMER0.status.count += 1;
    TIMER0.status.count <<= 2;
    TIMER0.status.enable = true;
    // `=` to a field with a write effect, and to another field.
    TIMER0.status.overrun = true;
    TIMER0.status.done = false;
    UART0.lcr.dlab && TIMER0.status.count > 4
}

// The same through a pointer to the peripheral type.
fn through(u: *mut Uart, t: *mut Timer) -> u8 {
    (*u).lcr.parity = false;
    (*u).lcr.dlab |= true;
    (*t).status.count -= 1;
    (*t).status.done = true;
    (*t).status.count
}

// Registers whose reads have effects, read explicitly: whole and by field,
// as values and in conditions; written whole.
fn effects() -> u8 {
    let byte: u8 = UART0.rbr;
    let lsr: Lsr = UART0.lsr;
    while !UART0.lsr.thr_empty {}
    if UART0.lsr.data_ready {
        return UART0.rbr;
    }
    UART0.fcr = Fcr { clear_rx: true, .. };
    UART0.thr = byte;
    if lsr.overrun { 1 } else { 0 }
}

// Through volatile pointers: reads of a type whose fields have read
// effects, and field and compound assignments of types whose reads have
// none, with `=` to a write-effect field.
fn through_volatile(l: *mut volatile Lsr, s: *mut volatile Status, c: *mut volatile Lcr) -> bool {
    let lsr: Lsr = *l;
    *l = lsr;
    (*s).count += 1;
    (*s).overrun = true;
    (*c).dlab = true;
    (*l).overrun
}

// In ordinary memory effects mean nothing.
fn ordinary(mut status: Status, mut lsr: Lsr) -> Status {
    status.overrun |= true;
    status.count += 1;
    lsr.overrun = false;
    lsr.data_ready |= true;
    status
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
