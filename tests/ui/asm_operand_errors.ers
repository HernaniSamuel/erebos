// The operands of `asm` that type checking rejects (ADR 0079): types no
// register holds (`ty::asm-operand-type`), places an output cannot be stored
// in, and what `sym` and `const` take.
enum Mode: u8 {
    Run = 0,
    Stop = 1,
}

struct Flags: u8 {
    on: bool at 0,
    level: u8 at 1..=3,
}

struct Wide {
    a: u32,
}

const LIMIT: u32 = 3;

static mut COUNTER: u32 = 0;

static FIXED: u32 = 0;

mod inner {}

fn handler() {}

fn types(a: u64, b: bool, c: Mode, d: Flags, e: [u8; 4], f: *const [u8], g: Wide, h: i64) {
    unsafe { asm("{}", in(reg) a); }
    unsafe { asm("{}", in(reg) b); }
    unsafe { asm("{}", in(reg) c); }
    unsafe { asm("{}", in(reg) d); }
    unsafe { asm("{}", in(reg) e); }
    unsafe { asm("{}", in(reg) f); }
    unsafe { asm("{}", in(reg) g); }
    unsafe { asm("{}", in(reg) ()); }
    unsafe { asm("{}", in(reg) h); }
    // Converted with `as`, they are operands.
    unsafe { asm("{} {} {}", in(reg) b as u8, in(reg) c as u8, in(reg) a as u32); }
}

// A literal has no expected type, in an input and in `const`.
fn literals() {
    unsafe { asm("{}", in(reg) 3); }
    unsafe { asm("{}", const 3); }
    unsafe { asm("{} {}", in(reg) 3 as u32, const 3 as u8); }
}

fn outputs(a: u64, b: bool, p: *const u32) {
    let mut wide: u64 = 0;
    let mut flag: bool = false;
    let mut fine: u32 = 0;
    unsafe { asm("{}", out(reg) wide); }
    unsafe { asm("{}", lateout(reg) flag); }
    unsafe { asm("{}", inout(reg) wide); }
    unsafe { asm("{}", inout(reg) a => fine); }
    unsafe { asm("{}", inout(reg) b => _); }
    // Places that cannot be written.
    let immutable: u32 = 0;
    unsafe { asm("{}", out(reg) immutable); }
    unsafe { asm("{}", out(reg) FIXED); }
    unsafe { asm("{}", out(reg) *p); }
    unsafe { asm("{}", out(reg) 3 as u32); }
    unsafe { asm("{}", inout(reg) immutable => immutable); }
    unsafe { asm("{}", inout(reg) immutable); }
    unsafe { asm("{}", inout(reg) 3 as u32); }
    unsafe { asm("{}", inout(reg) LIMIT); }
    // A bit field is no place in memory.
    let mut flags: Flags = Flags { on: false, level: 0 };
    unsafe { asm("{}", out(reg) flags.level); }
    unsafe { asm("{}", inout(reg) flags.level); }
    unsafe { asm("{}", inout(reg) fine => flags.level); }
    // Accepted: a field, a pointer's target, a static, a dropped output.
    unsafe { asm("{}", inout(reg) fine); }
    unsafe { asm("{}", out(reg) COUNTER); }
    unsafe { asm("{}", out(reg) _); }
}

// The two sides of `inout ... =>` have one type.
fn two_types(x: u32, y: u8, p: *const u8) {
    let mut small: u8 = 0;
    let mut big: u32 = 0;
    let mut ptr: *const u8 = p;
    unsafe { asm("{}", inout(reg) x => small); }
    unsafe { asm("{}", inout(reg) y => big); }
    unsafe { asm("{}", inout(reg) p => ptr); }
    unsafe { asm("{}", inout(reg) p => big); }
    unsafe { asm("{}", inout(reg) x => big); }
}

fn symbols() {
    unsafe { asm("{}", sym LIMIT); }
    unsafe { asm("{}", sym Wide); }
    unsafe { asm("{}", sym inner); }
    unsafe { asm("{}", sym Mode); }
    unsafe { asm("{}", sym Mode::Run); }
    unsafe { asm("{}", sym Flags); }
    unsafe { asm("{}", sym FIXED); }
    unsafe { asm("{}", sym COUNTER); }
    unsafe { asm("{}", sym handler); }
}

fn constants() {
    unsafe { asm("{}", const true); }
    unsafe { asm("{}", const Mode::Run); }
    unsafe { asm("{}", const b"ab"); }
    unsafe { asm("{}", const LIMIT); }
    unsafe { asm("{}", const 1 as u64); }
}

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
