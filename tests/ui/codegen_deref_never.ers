// emit: llvm-ir
// Regression (found by fuzzing): dereferencing or indexing an expression of
// type `!` crashed the compiler. The pointer is never computed, so the place
// has type `!` too.
fn index() -> u8 {
    let x: u8 = (loop {})[0];
    x
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { * loop {} }

// Also found by fuzzing: a field of an expression of type `!`.
struct S { b: u8 }

fn field() -> u8 {
    on_panic().b
}
