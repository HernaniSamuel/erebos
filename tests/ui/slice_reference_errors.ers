// emit: typeck
// What a reference to a slice cannot do. `*s` is no value; a `&` is not
// written through, nor borrowed `&mut`; a reference
// casts to the raw slice and a pointer to its first element, not to an
// integer, and is not compared; `[&u8]`, `[Uart]` and `[!]` are the errors
// they are behind a pointer; and a reference is held only by a parameter or a
// `let` without `mut` (ADR 0105, 0108).
struct Holder {
    s: &mut [u8],
}

peripheral Uart {
    read write data: u32 at 0,
}

fn whole(s: &[u8], t: &mut [u8]) {
    let a: [u8; 1] = *s;
    *t = *s;
    *s;
}

fn writes(s: &[u8], p: *const [u8]) {
    (*s)[0] = 1;
    let a: &mut [u8] = &mut *s;
    let b: &mut [u8] = &mut *p;
    let c: &mut u8 = &mut (*s)[0];
}

fn casts(s: &[u8], t: &mut [u8]) {
    let a: usize = s as usize;
    let b: *const [u16] = s as *const [u16];
    let c: &[u8] = t as &[u8];
}

fn compares(s: &[u8], t: &[u8]) -> bool {
    s == t
}

fn mut_parameter(mut s: &mut [u8]) {}

fn mut_variable(t: &mut [u8]) {
    let mut s: &mut [u8] = t;
}

fn elements(a: &[&u8], b: &[Uart], c: &mut [!], d: &[Holder]) {}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
