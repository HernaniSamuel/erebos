// emit: ast
// A range in an index (ADR 0108): `a..b`, `a..` and `..b` between `[` and
// `]`, on a variable, a field, an element, `*p`, a static, a byte string and
// a call; a range of a range; `&raw const` and `&` of one. `..` binds more
// loosely than every operator and `as`, and exists nowhere else.
fn forms(buf: [u8; 8], n: usize, m: u32, s: *const [u8], r: &[u8], pair: Pair) {
    let a: &[u8] = &buf[2..6];
    let b: &[u8] = &buf[2..];
    let c: &[u8] = &buf[..6];
    let d: &[u8] = &pair.items[n..];
    let e: &[u8] = &(*s)[1..n];
    let f: &[u8] = &(*r)[..n];
    let g: &[u8] = &TABLE[1..3];
    let h: &[u8] = &b"hello"[1..];
    let i: &[u8] = &make()[..2];
    let j: &[u8] = &(*s)[1..][..2];
    let k: &[u8] = &buf[1..7][2..4][1..2];
    let l: *const [u8] = &raw const (*s)[..4];
    let o: &[u8] = &buf[buf[0] as usize..buf[1] as usize];
}

// Operators and `as` inside a bound, and the bound of an index inside a range.
fn bounds(buf: [u8; 8], a: usize, b: u32, c: usize) {
    let p: &[u8] = &buf[a + 1..b as usize];
    let q: &[u8] = &buf[a * 2..c - 1];
    let r: &[u8] = &buf[b as usize..];
    let s: &[u8] = &buf[..a + c];
    let t: &[u8] = &buf[a << 1..(c | 1) + 2];
    let u: u8 = buf[a + 1];
}
