// target: thumbv7m-none-eabi
// emit: llvm-ir
// The reset entry of ARMv7-M (ADR 0074, 0083): the compiler's `module asm`
// holds only the two words of the vector table, in the section
// `.vector_table`: the initial stack pointer and `_start`. `_start` is `core`'s
// naked function, in `rt/arch/armv7m.ers`, which `--emit=llvm-ir` leaves
// out, so it is not here.
entry fn reset_main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
