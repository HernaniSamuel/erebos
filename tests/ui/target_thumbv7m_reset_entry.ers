// target: thumbv7m-none-eabi
// emit: llvm-ir
// The reset entry of ARMv7-M (ADR 0074) is `module asm`: two words of a
// vector table, the initial stack pointer and `_start` (bit 0 set by the
// assembler, `.thumb_func`), then `_start`, which sets the stack pointer,
// zeroes `.bss`, copies `.data` and jumps to the entry function by a
// register, with `.ltorg` for the literal pool of its `ldr =` loads.
entry fn reset_main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
