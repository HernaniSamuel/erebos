// target: thumbv7m-none-eabi
// emit: llvm-ir
// opt: both
// The same table with a panic function that takes no parameter (ADR 0085, 0053):
// one default handler, `__erebos_unhandled`, serves every word no handler
// serves, and no information is built.
use core::arch::Vector;

static mut TICKS: u32 = 0;

interrupt fn tick() at Vector::SysTick {
    TICKS += 1;
}

mod drivers {
    pub interrupt fn pend() at core::arch::Vector::PendSV {
        super::TICKS = 0;
    }

    #[export]
    pub interrupt fn svc() at core::arch::Vector::SVCall {}
}

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
