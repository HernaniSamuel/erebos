// emit: llvm-ir
// `sym entry` in the template of an `asm` (ADR 0083): the entry function's
// symbol, whatever its module and name. The entry function is `app.main`, in
// a module, so the template shows its path symbol. A function, a naked
// function and a named operand name it. The thumbv7m counterpart is
// `asm_sym_entry_thumbv7m.ers`.
fn jump() -> ! {
    asm("j {}", sym entry, options(noreturn));
}

#[naked]
fn naked_jump() -> ! {
    asm("tail {}", sym entry, options(noreturn));
}

fn named() -> ! {
    asm("la t0, {main}", "jr t0", main = sym entry, options(noreturn));
}

mod app {
    entry fn main() -> ! {
        super::jump()
    }
}

panic fn on_panic() -> ! { loop {} }
