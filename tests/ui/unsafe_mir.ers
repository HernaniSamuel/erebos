// emit: mir
// An `unsafe` block lowers as a plain block (ADR 0119): `with_block` and
// `without_block` have the same body but for where the `unsafe` blocks are,
// and the same MIR; the same for a block that is a value, a statement, nested,
// and one that holds `return`, `break` and `continue`. Each block holds a call
// to `touch`, an unsafe operation, as every block must (`without_block` keeps
// each call in a block of its own and the rest of its statements outside).
unsafe fn touch() {}

fn without_block(p: *mut u32, n: u32) -> u32 {
    unsafe { touch(); }
    *p = n;
    let mut i: u32 = 0;
    loop {
        unsafe { touch(); }
        if i == n { break; }
        i += 1;
        if i == 3 { continue; }
        *p += i;
    }
    unsafe { touch(); }
    if n == 7 { return *p; }
    unsafe { touch(); }
    { *p }
}

fn with_block(p: *mut u32, n: u32) -> u32 {
    unsafe {
        touch();
        *p = n;
    }
    let mut i: u32 = 0;
    loop {
        unsafe {
            touch();
            if i == n { break; }
            i += 1;
            if i == 3 { continue; }
            *p += i;
        }
    }
    unsafe {
        touch();
        if n == 7 { return *p; }
    }
    unsafe { touch(); { *p } }
}

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
