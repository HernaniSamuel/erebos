// emit: mir
// A slice in the payload of a result must lie inside its static (ADR 0031),
// and only the payload of the variant the tag names is a value
// (ADR 0039): the same bytes under a variant whose payload is a pointer
// and a length are no slice, and are accepted.
static BYTES: [u8; 4] = [1, 2, 3, 4];

enum View: u8 { Bytes(*const [u8]) = 0, Raw(*const u8, usize) = 1 }

const WHOLE: View = View::Bytes(&raw const BYTES);
const PAST_END: View = View::Bytes(slice(&raw const BYTES[1], 4));
const RAW: View = View::Raw(&raw const BYTES[1], 4);
static VIEWS: [View; 2] = [View::Raw(&raw const BYTES[3], 9), View::Bytes(slice(&raw const BYTES[3], 2))];

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
