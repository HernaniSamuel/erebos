// target: thumbv7m-none-eabi
// `ty::asm-register` on thumbv7m (ADR 0079): the registers of this target,
// each reserved one by each of its names, and a riscv32 name.
fn unknown(x: u32) {
    unsafe { asm("", in("r16") x); }
    unsafe { asm("", in("s0") x); }
    unsafe { asm("", in("a0") x); }
    // The names this target has.
    unsafe { asm("", in("r0") x, in("r1") x, in("sb") x, in("sl") x, in("fp") x, in("ip") x); }
    unsafe { asm("", in("lr") x, lateout("r14") _); }
}

fn reserved(x: u32) {
    unsafe { asm("", in("r6") x); }
    unsafe { asm("", in("r7") x); }
    unsafe { asm("", in("r13") x); }
    unsafe { asm("", in("sp") x); }
    unsafe { asm("", in("r15") x); }
    unsafe { asm("", in("pc") x); }
    unsafe { asm("", out("r6") _); }
    unsafe { asm("", inout("sp") x => _); }
}

fn twice(x: u32) {
    unsafe { asm("", in("r0") x, in("r1") x, in("r0") x); }
    unsafe { asm("", out("r2") _, out("r2") _); }
    unsafe { asm("", in("r12") x, out("ip") _); }
    unsafe { asm("", in("r12") x, lateout("ip") _); }
    unsafe { asm("", in("lr") x, in("r14") x); }
    // A shared register does not hide a conflict with a later operand.
    unsafe { asm("", in("r0") x, lateout("r0") _, lateout("r0") _); }
    unsafe { asm("", in("r0") x, lateout("r0") _, out("r0") _); }
}

fn clobber(x: u32) {
    let mut v: u32 = 0;
    unsafe { asm("{}", out(reg) v, clobber_abi("C")); }
    unsafe { asm("", out("r4") v, lateout("r0") _, in("r3") x, clobber_abi("C")); }
}

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
