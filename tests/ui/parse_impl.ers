struct Ring {
    count: usize,
}

impl Ring {
    pub fn new() -> Self {
        Self { count: 0 }
    }

    fn take(self) -> usize {
        self.count
    }

    pub fn grow(mut self, by: usize) -> Self {
        self.count = self.count + by;
        self
    }

    pub fn count(&self) -> usize {
        self.count
    }

    #[align(16)]
    pub fn push(&mut self, n: usize,) {
        self.count += n;
    }

    #[naked]
    fn raw(&self) -> ! {
        asm("ret", options(noreturn));
    }

    fn pointers(a: *const Self, b: &mut Self) -> Self {
        Self::new()
    }
}

impl Ring {}

enum Mode: u8 {
    Off = 0,
    Run = 1,
}

impl Mode {
    fn default() -> Self {
        Self::Run
    }

    fn is_off(&self) -> bool {
        match *self {
            Self::Off => true,
            Self::Run => false,
        }
    }
}

