// emit: llvm-ir
// opt: both
// Each check passes the panic function the address of its own
// `core::PanicInfo`, private read-only data whose `file` points to the
// file's name, stored once for the checks of this file; the names of
// `core`'s files are left out of the dump, like `core` (ADR 0052, 0053).
// The panic function hands the address it receives to C, so that with
// `-O` the data and what a frame's `PanicInfo` holds stay.
fn divide(a: u32, b: u32) -> u32 {
    a / b
}

fn element(a: [u8; 4], i: usize) -> u8 {
    a[i]
}

// An `assert` with a message fills a `PanicInfo` in its frame instead, on
// the failing path, with the message computed there (ADR 0053).
fn checked(x: u32, m: *const [u8]) {
    assert(x < 10, m);
}

extern fn report(info: *const core::PanicInfo);

entry fn main() -> ! { loop {} }
panic fn on_panic(info: *const core::PanicInfo) -> ! {
    report(info);
    loop {}
}
