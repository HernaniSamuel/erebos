// emit: typeck
// What a `match` rejects (ADR 0037): scrutinees other than integers,
// `bool` and enums, a literal scrutinee, which has no type, patterns of
// another type than the scrutinee's, with no conversion, and arms that
// leave values unmatched.
struct Pair { a: u8, b: u8 }
const WIDE: u16 = 1;

fn halt() -> ! { loop {} }

fn scrutinees(p: *const u8, s: *const [u8], pair: Pair, a: [u8; 2]) {
    match p { _ => {} }
    match s { _ => {} }
    match pair { _ => {} }
    match a { _ => {} }
    match () { _ => {} }
    match halt() { _ => {} }
    match 3 { _ => {} }
}

fn patterns(x: u8, w: u32, b: bool) {
    match x {
        WIDE => {}
        300 => {}
        -1 => {}
        true => {}
        _ => {}
    }
    match x {
        let n: u16 => {}
    }
    match w {
        b'q' => {}
        false => {}
        _ => {}
    }
    match b {
        0 => {}
        b'a' => {}
        _ => {}
    }
}

fn non_exhaustive(x: u8, b: bool) -> u32 {
    let c: u32 = match b {
        true => 1,
    };
    let d: u32 = match b {};
    match x {
        0 => c,
        1 | 2 => d,
    }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
