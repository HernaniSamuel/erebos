// emit: typeck
// target: thumbv7m-none-eabi
// Calling a fence at compile time is `eval::asm` (ADR 0081), and the
// diagnostic is at the `asm` inside `core::arch`, whose file is the target's:
// `rt/arch/armv7m.ers` here, `rt/arch/riscv32.ers` in
// `fence_comptime.ers`.
fn ordered() -> u32 {
    core::arch::fence();
    1
}

const FENCED: u32 = comptime { ordered() };

const COMPILER_FENCED: u32 = comptime {
    core::arch::compiler_fence();
    2
};

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
