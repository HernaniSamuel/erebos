// emit: llvm-ir
// Temporary, until step 3 of M4.1 generates inline assembly: a program that
// type checks and holds an `asm` expression is reported by code generation.
fn pause() {
    asm("wfi", options(nomem, nostack));
}

entry fn main() -> ! {
    pause();
    loop {}
}

panic fn on_panic() -> ! { loop {} }
