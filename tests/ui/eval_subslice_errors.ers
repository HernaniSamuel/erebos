// emit: mir
// A range out of bounds at compile time calls the panic function, which is an
// error there (ADR 0108): one past the length of a slice, a start after the
// end, and a range or an index past the end of a sub-slice but inside its
// base. A range at the length is valid.
static TABLE: [u8; 4] = [1, 2, 3, 4];

fn at_the_length() -> usize {
    let s: &[u8] = &TABLE[1..];
    len(&(*s)[3..3]) + len(&(*s)[3..])
}
const VALID: usize = at_the_length();

fn end_past_length(n: usize) -> usize {
    let s: &[u8] = &TABLE;
    len(&(*s)[..n])
}
const END_PAST: usize = end_past_length(5);

fn start_after_end(a: usize) -> usize {
    let s: &[u8] = &TABLE;
    len(&(*s)[a..2])
}
const START_AFTER: usize = start_after_end(3);

fn index_past_sub_slice() -> u8 {
    let s: &[u8] = &TABLE;
    (*s)[1..3][2]
}
const INDEX_PAST: u8 = index_past_sub_slice();

fn range_past_sub_slice() -> usize {
    let s: &[u8] = &TABLE;
    len(&(*s)[1..3][1..3])
}
const RANGE_PAST: usize = range_past_sub_slice();

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
