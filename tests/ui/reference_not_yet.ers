// emit: mir
// What cannot be borrowed yet (ADR 0105, left to M5.4c): a place through a
// `volatile` pointer, a peripheral and a cluster. A `static`, a `static mut`
// (ADR 0110) and a place through a pointer that is not `volatile` can; so can
// the address of any of these with `&raw`.
static mut COUNTER: u32 = 0;
static FIXED: u32 = 4;
extern static CONST_OUTSIDE: u32;

struct Pair {
    a: u32,
    b: u32,
}

peripheral Context {
    read write threshold: u32 at 0,
}

peripheral Plic {
    ctx: [Context; 2] at 0x1000 step 0x100,
    first: Context at 0x2000,
}

peripheral PLIC: Plic at 0x0C00_0000;

peripheral Uart {
    read write data: u32 at 0,
}

peripheral UART0: Uart at 0x1000_0000;

fn volatile_pointer(v: *mut volatile u32, w: *const volatile Pair) {
    &*v;
    &mut *v;
    &(*w).a;
}

fn devices() {
    &UART0;
    &PLIC.ctx[1];
    &PLIC.first;
}

fn accepted(p: *mut u32) -> u32 {
    let a: &u32 = &FIXED;
    let b: &u32 = &CONST_OUTSIDE;
    let c: &mut u32 = &mut *p;
    *a + *b + *c
}

fn addresses() {
    &raw const COUNTER;
    &raw mut COUNTER;
    &raw mut UART0;
}

entry fn main() -> ! {
    loop {}
}

panic fn on_panic() -> ! {
    loop {}
}
