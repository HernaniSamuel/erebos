// emit: llvm-ir
// An entry function in a module, named like a function of the root module
// declared before it: LLVM keeps `main` for that one and names the entry
// function `main.1`, which `_start` jumps to (ADR 0012, 0049).
fn main() -> u32 { 7 }

mod app {
    entry fn main() -> ! {
        let x: u32 = super::main();
        loop {}
    }
}

panic fn on_panic() -> ! { loop {} }
