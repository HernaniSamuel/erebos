// emit: ast
// `..` alone and `..=` in an index are errors, each with a help (ADR 0108); a
// range is no expression anywhere else.
fn whole(buf: [u8; 8]) {
    let a: &[u8] = &buf[..];
}

fn closed(buf: [u8; 8], n: usize) {
    let b: &[u8] = &buf[1..=n];
}

fn closed_from_start(buf: [u8; 8], n: usize) {
    let c: &[u8] = &buf[..=n];
}

fn expression(n: usize) {
    let d: usize = 1..n;
}
