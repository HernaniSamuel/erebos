// emit: mir
// Which enums a `match` needs, per position (ADR 0040). In a function
// computing a value of an enum, a `match` that names a value of that enum
// at a payload position, through a variant or a constant, or a variant of
// another enum at one of its positions, needs all its values: a cycle,
// reported once. Only `_` and `let` at its positions need none. A `match`
// that needs the values of an enum with a repeated value, here at a
// payload position, is not checked, with or without a catch-all arm, and
// its function cannot be evaluated: only the enum's error is reported,
// and the assert below, which would fail if it were, reports nothing.
enum G: u8 { A = nested_variant(1), B = 1 }
enum Holder: u8 { Of(G) = 0, Empty = 1 }

fn nested_variant(x: u8) -> u8 {
    if x == 0 { match Holder::Empty { Holder::Of(G::B) => 0, _ => 1 } } else { 5 }
}

enum GC: u8 { A = nested_const(1), B = 1 }
enum HolderC: u8 { Of(GC) = 0, Empty = 1 }
const GC_B: GC = GC::B;

fn nested_const(x: u8) -> u8 {
    if x == 0 { match HolderC::Empty { HolderC::Of(GC_B) => 0, _ => 1 } } else { 5 }
}

enum GO: u8 { A = other_variant(1), B = 1 }
enum Mode: u8 { Off = 0, Run = 1 }
enum H: u8 { X(Mode) = 0 }
enum HolderO: u8 { Of(GO) = 0, Empty = 1 }

fn other_variant(x: u8) -> u8 {
    if x == 0 { match HolderO::Empty { HolderO::Of(H::X(Mode::Run)) => 0, _ => 1 } } else { 5 }
}

// No cycle: the positions of `GW` hold only `_` and `let`.
enum GW: u8 { A = wildcards(1), B = 1 }
enum HolderW: u8 { Of(GW, u8) = 0, Empty = 1 }

fn wildcards(x: u8) -> u8 {
    if x == 0 {
        match HolderW::Empty {
            HolderW::Of(_, 3) => 0,
            HolderW::Of(let g: GW, _) => 1,
            HolderW::Empty => 2,
        }
    } else {
        5
    }
}

comptime {
    assert(GW::A as u8 == 5);
}

enum Twice: u8 { Off = 0, Run = 0, Sleep = 1 }
enum Msg: u8 { Nop = 0, SetMode(Twice) = 1 }

fn set_mode(m: Msg) -> u8 {
    match m {
        Msg::SetMode(Twice::Run) => 1,
        _ => 2,
    }
}

comptime {
    assert(set_mode(Msg::Nop) == 1);
}

// Nor is one without arms on an enum with payloads and a repeated value.
enum TwiceMsg: u8 { A = 0, B(u8) = 0 }

fn no_arms(t: TwiceMsg) -> u8 {
    match t {}
}

comptime {
    assert(no_arms(TwiceMsg::A) == 1);
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
