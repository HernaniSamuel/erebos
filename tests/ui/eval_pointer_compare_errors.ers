// emit: mir
// Pointer comparisons whose run-time answer is not known at compile time
// are `eval::pointer-compare`; comparing or reading through a pointer to a
// variable of a returned call is `eval::dangling-pointer` (ADR 0030).
const PAST_END: bool = past_end();
const ZERO_SIZED: bool = zero_sized();
const ACROSS: bool = across();
const WRAPPED: bool = wrapped();
const WITH_ADDRESS: bool = with_address();
const DANGLING_COMPARE: bool = addr(1) == addr(2);
const DANGLING_READ: u32 = *addr(1);

fn past_end() -> bool {
    let a: u32 = 1;
    let b: u32 = 2;
    let p: *const u32 = &raw const a;
    &raw const p[1] == &raw const b
}

fn zero_sized() -> bool {
    let a: u32 = 1;
    let e: [u32; 0] = [];
    &raw const a as *const u8 == &raw const e as *const u8
}

fn across() -> bool {
    let a: u32 = 1;
    let b: u32 = 2;
    &raw const a < &raw const b
}

fn wrapped() -> bool {
    let t: [u8; 4] = [1, 2, 3, 4];
    let p: *const u8 = &raw const t as *const u8;
    &raw const p[0xFFFF_FFFF] < p
}

fn with_address() -> bool {
    let a: u32 = 1;
    &raw const a == 0x1000 as *const u32
}

fn addr(x: u32) -> *const u32 {
    let v: u32 = x;
    &raw const v
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
