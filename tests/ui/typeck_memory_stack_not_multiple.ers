// emit: typeck
// A stack whose size is not a multiple of the target's stack alignment, 16
// on riscv32, is `ty::stack-size` (ADR 0057), at its size.
memory {
    region FLASH { origin: 0x8000_0000, size: 0x1_0000 }
    region RAM { origin: 0x8400_0000, size: 0x1_0000 }
    code in FLASH;
    data in RAM;
    stack in RAM { size: 8 }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
