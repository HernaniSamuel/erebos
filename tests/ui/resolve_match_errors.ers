// emit: hir
// A bare name in a pattern is always a constant (ADR 0037): anything else
// is `resolve::not-a-constant`, including a local variable that shadows a
// constant, and a name that names nothing is `resolve::unknown-name`. A
// `let` alternative binds a name the others must bind (ADR 0041).
// `Enum::Variant` is resolved as in an expression.
const LIMIT: u8 = 10;
static LEVEL: u8 = 3;
struct Point { x: u8 }
enum Mode: u8 { Off = 0 }

fn helper() {}

fn names(x: u8, limit: u8) -> u8 {
    let LIMIT: u8 = 4;
    match x {
        LEVEL => 1,
        helper => 2,
        Point => 3,
        Mode => 4,
        LIMIT => 5,
        limit => 6,
        LIMTI => 7,
        _ => 8,
    }
}

fn alternatives(x: u8) -> u8 {
    match x {
        1 | let n: u8 => n,
    }
}

fn paths(m: Mode) -> u8 {
    match m {
        Mode::Nope => 1,
        Moder::Off => 2,
        Point::A => 3,
        LIMIT::A => 4,
        LEVEL::A => 5,
        helper::A => 6,
        _ => 7,
    }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
