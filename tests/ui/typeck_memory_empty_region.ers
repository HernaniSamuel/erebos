// emit: typeck
// A region of size 0 is `ty::empty-region` (ADR 0057), at its size, whether
// something is placed in it or not.
memory {
    region FLASH { origin: 0x8000_0000, size: 0x1_0000 }
    region RAM { origin: 0x8400_0000, size: 0x1_0000 }
    region SPARE { origin: 0x8800_0000, size: 0 }
    region DATA { origin: 0x8c00_0000, size: 0x0 }
    code in FLASH;
    data in DATA;
    stack in RAM { size: 0x1000 }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
