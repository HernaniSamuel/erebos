// emit: typeck
// The rule is checked on MIR (ADR 0115), so a program that breaks it still has
// a dump at `--emit=typeck` and earlier stages.
use core::arch::Vector;

peripheral Bank {
    read write data: u32 at 0,
}

peripheral DEVICE: Bank at 0x1000_0000;

interrupt fn tick() at Vector::MachineTimer {
    DEVICE.data += 1;
}

entry fn main() -> ! {
    DEVICE.data = 0;
    loop {}
}

panic fn on_panic() -> ! { loop {} }
