// emit: typeck
// What a `match` on an enum rejects (ADR 0037): missing variants, listed
// in declaration order; a variant of another enum, a variant against an
// integer and an integer literal against an enum; dead arms: a variant
// twice, a variant after a constant holding it, and an or-pattern whose
// every alternative is covered already.
enum Mode: u8 { Off = 0, Run = 1, Wait = 2, Sleep = 3 }
enum Level: u8 { Low = 0 }

const RUNNING: Mode = Mode::Run;

fn missing_two(m: Mode) -> u8 {
    match m {
        Mode::Wait => 2,
        Mode::Run => 1,
    }
}

fn missing_three(m: Mode) -> u8 {
    match m {
        Mode::Run => 1,
    }
}

fn other_types(m: Mode, x: u8) {
    match m {
        Level::Low => {}
        0 => {}
        _ => {}
    }
    match x {
        Mode::Off => {}
        _ => {}
    }
}

fn dead(m: Mode) -> u8 {
    match m {
        Mode::Off => 0,
        Mode::Off => 1,
        RUNNING => 2,
        Mode::Run => 3,
        Mode::Wait | Mode::Sleep => 4,
        Mode::Sleep | Mode::Off => 5,
        _ => 6,
    }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
