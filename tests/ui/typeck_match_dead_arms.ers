// emit: typeck
// Dead arms (ADR 0037): an arm that matches no value the arms before it
// leave is reported once, pointing at the earlier arm that covers it alone
// if one does; dead alternatives of an arm that is not dead are reported
// each. Constants count with their values.
const ZERO: u8 = 0;

fn literals(x: u8) -> u8 {
    match x {
        0 => 1,
        0 => 2,
        ZERO => 3,
        let n: u8 => n,
        5 => 4,
    }
}

fn alternatives(x: u8) -> u8 {
    match x {
        1 | 1 => 1,
        2 => 2,
        1 | 2 => 3,
        3 | 1 | 4 => 4,
        _ | 7 => 5,
    }
}

fn bools(b: bool) -> u8 {
    match b {
        true => 1,
        false => 2,
        _ => 3,
    }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
