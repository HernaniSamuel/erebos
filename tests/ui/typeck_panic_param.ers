// emit: typeck
// The panic function may take a `&core::PanicInfo` (ADR 0053, 0116), in any
// module, naming the struct through `use` (ADR 0049, 0052). Called
// explicitly, it takes a reference to a `PanicInfo` the caller built.
mod handler {
    use core::PanicInfo;
    use core::PanicReason;

    panic fn on_panic(info: &PanicInfo) -> ! {
        let line: u32 = info.line;
        loop {}
    }

    pub fn fail(line: u32) -> ! {
        let info: PanicInfo = PanicInfo {
            file: &raw const b"handler.ers",
            line: line,
            column: 1,
            reason: PanicReason::AssertionFailed,
            message: &raw const b"failed on purpose",
        };
        on_panic(&info)
    }
}

entry fn main() -> ! {
    handler::fail(3)
}
