// emit: stack
// opt: both
// target: thumbv7m-none-eabi
// `stack_report.ers` on thumbv7m (ADR 0123): the exception entry is 36 bytes,
// the NMI without a handler is a default handler, and `__aeabi_uldivmod` and
// `__aeabi_ldivmod` of `core` carry their own `#[stack(N)]`.
use core::arch::Vector;

memory {
    region ROM { origin: 0x0800_0000, size: 0x1_0000 }
    region RAM { origin: 0x2000_0000, size: 0x1_0000 }
    code in ROM;
    data in RAM;
    stack in RAM { size: 4096 }
}

static mut TICKS: u32 = 0;

struct Block {
    words: [u32; 16],
}

interrupt fn tick() at Vector::SysTick {
    TICKS += 1;
}

#[stack(8)]
#[naked]
fn leaf() {
    asm("bx lr", options(noreturn))
}

// Calls back into Erebos, which the bound counts through the number.
#[stack(48)]
extern fn outside(x: u32) -> u32;

fn divide(a: u32, b: u32) -> u32 {
    a / b
}

fn consume(block: Block) -> u32 {
    block.words[0]
}

fn never_called() -> u32 {
    7
}

entry fn main() -> ! {
    let block: Block = Block { words: [1; 16] };
    let total: u32 = consume(block) + divide(10, 2) + unsafe { outside(3) };
    unsafe { leaf(); }
    loop {}
}

panic fn on_panic() -> ! { loop {} }
