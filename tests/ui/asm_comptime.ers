// `asm` cannot run at compile time (ADR 0079): a constant whose evaluation
// reaches one is `eval::asm`, whichever function it is in. That a function
// with `asm` called at run time builds is `asm_typeck.ers`'s.
fn read() -> u32 {
    let mut v: u32 = 0;
    unsafe { asm("csrr {}, mcause", out(reg) v, options(nomem, nostack)); }
    v
}

fn indirect() -> u32 {
    read() + 1
}

fn stops() -> u32 {
    unsafe { asm("wfi", options(noreturn)); }
}

const DIRECT: u32 = comptime { read() };

const THROUGH: u32 = comptime { indirect() };

const NEVER: u32 = comptime { stops() };

// The `asm` itself in a compile-time body, inside its `unsafe` block: the
// block satisfies the check of `unsafe` (ADR 0119) and changes nothing here.
const WRITTEN_HERE: u32 = comptime {
    let mut v: u32 = 0;
    unsafe { asm("csrr {}, mcause", out(reg) v, options(nomem, nostack)); }
    v
};

// Never evaluated: a function with `asm` that no constant calls.
fn at_run_time() -> u32 {
    read()
}

entry fn main() -> ! {
    at_run_time();
    loop {}
}

panic fn on_panic() -> ! { loop {} }
