// emit: typeck
// An operation that is already in error counts as unsafe for the block around
// it, and is not reported again: no `ty::unused-unsafe` for a block whose
// only operation failed to type check (ADR 0119). A method call that found no
// method is the case, and so is a call with an argument or a receiver in
// error; a mismatched argument is not (its type is still a type); a call to a
// function that is not found is a resolution error, which stops before this
// check.
unsafe fn plain(x: u32) -> u32 {
    x + 1
}

struct Counter {
    n: u32,
}

fn unknown_method(c: &Counter) -> u32 {
    unsafe { c.missing() }
}

fn unknown_method_outside(c: &Counter) -> u32 {
    c.missing()
}

fn wrong_argument() -> u32 {
    // The call is still an unsafe operation: it is covered here, and
    // reported where it is not.
    let a: u32 = unsafe { plain(true) };
    let b: u32 = plain(true);
    a + b
}

impl Counter {
    unsafe fn add(&self, x: u32) -> u32 {
        self.n + x
    }
}

// An argument or a receiver in error (its own error was reported): the call
// is not reported, and counts as unsafe for the block around it. Only the
// error of the operand comes out, in each of these.
fn operand_in_error(c: &Counter) -> u32 {
    let a: u32 = unsafe { plain(c.missing()) };
    let b: u32 = plain(c.missing());
    let d: u32 = unsafe { c.add(c.missing()) };
    let e: u32 = c.add(c.missing());
    let f: u32 = unsafe { c.missing().add(1) };
    let g: u32 = c.missing().add(1);
    a + b + d + e + f + g
}

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
