// emit: mir
// A `match` on an enum one of whose values repeats another or fails is
// not checked for exhaustiveness or dead arms (ADR 0037): only the enum's
// errors are reported. The function still type checks, so a `comptime`
// block can call it. With a catch-all arm, the value both variants share
// goes to the first arm that lists it. Without one, a variant may have no
// arm, so the function cannot be evaluated, and fails without a
// diagnostic of its own rather than panicking on `Twice::C` as if it were
// no variant. The build stops at the enum's error.
enum Twice: u8 { A = 0, B = 0, C = 1 }

fn twice(t: Twice) -> u8 {
    match t {
        Twice::A => 1,
        Twice::B => 2,
    }
}

fn twice_or(t: Twice) -> u8 {
    match t {
        Twice::A => 1,
        Twice::B => 2,
        _ => 3,
    }
}

comptime {
    assert(twice_or(Twice::B) == 1);
    assert(twice_or(Twice::A) == 1);
    assert(twice_or(Twice::C) == 3);
}

comptime {
    assert(twice(Twice::C) == 1);
}

// A `match` without arms needs the values too (ADR 0038), so it is not
// checked either, and its evaluation fails without a diagnostic of its own.
fn no_arms(t: Twice) -> u8 {
    match t {}
}

comptime {
    assert(no_arms(Twice::C) == 1);
}

enum Broken: u8 { A = 1 / 0, B = 1 }

fn broken(b: Broken) -> u8 {
    match b {
        Broken::B => 1,
        Broken::B => 2,
    }
}

// A value that needs a function matching on its own enum is a cycle,
// reported once.
enum Cycle: u8 { A = cycles(Cycle::B), B = 1 }

fn cycles(c: Cycle) -> u8 {
    match c {
        Cycle::A => 0,
        Cycle::B => 2,
    }
}

// So is one with a catch-all arm, as its patterns name a variant; with only
// `_` and `let` arms, no value is needed (see eval_match_enum_catch_all).
enum CycleOr: u8 { A = cycles_or(1), B = 1 }

fn cycles_or(x: u8) -> u8 {
    if x == 0 { match CycleOr::B { CycleOr::B => 0, _ => 1 } } else { 5 }
}

// So is one with a constant pattern (ADR 0038).
enum CycleConst: u8 { A = cycles_const(1), B = 1 }
const CONST_B: CycleConst = CycleConst::B;

fn cycles_const(x: u8) -> u8 {
    if x == 0 { match CycleConst::B { CONST_B => 0, _ => 1 } } else { 5 }
}

// So is one without arms.
enum CycleNone: u8 { A = cycles_none(1), B = 1 }

fn cycles_none(x: u8) -> u8 {
    if x == 0 { match CycleNone::B {} } else { 5 }
}

// So is one with a variant of another enum, whatever its type: the pattern
// is a variant, and is a mismatch too.
enum CycleOther: u8 { A = cycles_other(1), B = 1 }
enum Other: u8 { X = 0 }

fn cycles_other(x: u8) -> u8 {
    if x == 0 { match CycleOther::B { Other::X => 0, _ => 1 } } else { 5 }
}

// One that needs no value adds no dependence, but its scrutinee is a use
// like any other: here it reads the value being computed.
enum CycleScrutinee: u8 { A = cycles_scrutinee(1), B = 1 }

fn cycles_scrutinee(x: u8) -> u8 {
    match CycleScrutinee::A { _ => x }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
