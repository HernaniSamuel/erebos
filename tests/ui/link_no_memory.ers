// emit: linker-script
// A program without a `memory` block has no linker script:
// `link::no-memory-map` (ADR 0057), with a help showing a block. That the
// other stages do not need one shows in the `codegen_*` tests, which have
// none.
entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
