// emit: mir
// With a panic function that takes a `*const core::PanicInfo`, each check
// passes the address of read-only data of its own, holding its reason and
// where it is: the line and column of the token that performs it, the
// operator of `/`, `%`, `/=` and `%=`, the `[` of an index, `assert`,
// `match` and the `?` (ADR 0053). Nested checks each have their own, and
// parentheses change nothing.
enum Mode: u8 { Off = 0, Run = 1 }
enum Msg: u8 { Nop = 0, Put(u8) = 1 }

fn divisions(a: u32, b: u32, c: u32) -> u32 {
    let mut x: u32 = a / b;
    x %= c;
    x /= b;
    x + a % c + a / b / c + (a / b)
}

fn indexes(a: [u32; 4], s: *const [u32], m: [[u8; 2]; 3], i: usize, j: usize) -> u32 {
    a[i] + (*s)[i] + m[i][j] as u32
}

fn checks(x: u32, mode: Mode, msg: Msg, o: Option(u32)) -> Option(u32) {
    assert(x < 10);
    let v: u32 = match mode { .Off => 0, .Run => 1 };
    let w: u32 = match msg { .Nop => 0, .Put(let b: u8) => b as u32 };
    .Some(v + w + o?)
}

entry fn main() -> ! { loop {} }
panic fn on_panic(info: *const core::PanicInfo) -> ! { loop {} }
