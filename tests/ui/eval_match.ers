// emit: mir
// `match` at compile time works as at run time (ADR 0027, 0037): on
// integers of every width and on `bool`, with literals, negative ones,
// constants, or-patterns and `let`; the first arm that matches runs.
const ESCAPE: u8 = 0x1B;
const MINUS_ONE: i32 = -1;
const ON: bool = true;

fn byte(c: u8) -> u32 {
    match c {
        ESCAPE => 1,
        b'0' | b'1' => 2,
        0 | 255 => 3,
        let other: u8 => other as u32 + 100,
    }
}

fn signed(x: i8) -> u32 {
    match x {
        -128 => 1,
        -1 | 1 => 2,
        _ => 3,
    }
}

fn word(x: i32) -> i32 {
    match x {
        MINUS_ONE => 10,
        let mut n: i32 => {
            n *= 2;
            n
        }
    }
}

fn wide(x: u64) -> u32 {
    match x {
        0x1_0000_0000 => 1,
        0xFFFF_FFFF_FFFF_FFFF => 2,
        _ => 3,
    }
}

fn flag(b: bool) -> u32 {
    match b {
        ON => 1,
        false => 0,
    }
}

// Expected: 1, 2, 3, 165; 1, 2, 3; 10, -6; 1, 2, 3; 1, 0.
fn answers() -> u32 {
    let b: [u32; 4] = [
        comptime byte(0x1B),
        comptime byte(b'1'),
        comptime byte(255),
        comptime byte(65),
    ];
    let s: [u32; 3] = [comptime signed(-128), comptime signed(1), comptime signed(-127)];
    let w: [i32; 2] = [comptime word(-1), comptime word(-3)];
    let u: [u32; 3] = [
        comptime wide(0x1_0000_0000),
        comptime wide(0xFFFF_FFFF_FFFF_FFFF),
        comptime wide(0xFFFF_FFFF),
    ];
    let f: [u32; 2] = [comptime flag(true), comptime flag(false)];
    0
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
