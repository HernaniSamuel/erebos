// target: thumbv7m-none-eabi
// emit: linker-script
// The stack's alignment on thumbv7m is 8 (ADR 0074), so a size of 24, which
// is a multiple of 8 but not of 16, is accepted (it is `ty::stack-size` on
// riscv32, `typeck_memory_aligned_for_riscv32.ers`), and the script aligns
// the stack to 8.
memory {
    region CODE { origin: 0x0, size: 0x1_0000 }
    region DATA { origin: 0x2000_0000, size: 0x1_0000 }
    code in CODE;
    data in DATA;
    stack in DATA { size: 24 }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
