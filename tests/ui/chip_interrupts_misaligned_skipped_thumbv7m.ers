// target: thumbv7m-none-eabi
// emit: typeck
// A list with a value above the limit (ADR 0089) is reported, and the table it
// would make is not looked at (ADR 0090): the origin 0x400 would be rejected for
// a list ending at 495, but only `ty::interrupt-number` is reported here.
memory {
    region CODE { origin: 0x400, size: 0x1_0000 }
    region DATA { origin: 0x2000_0000, size: 0x1_0000 }
    code in CODE;
    data in DATA;
    stack in DATA { size: 0x1000 }
}

#[interrupts]
enum Interrupt: u32 {
    First = 0,
    Last = 496,
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
