// emit: hir
// Each of `code`, `data` and `stack` is placed (ADR 0057): one error per
// missing placement, at the block.
memory {
    region FLASH { origin: 0x0800_0000, size: 0x1_0000 }
    region SRAM { origin: 0x2000_0000, size: 0x4000 }
    data in SRAM;
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
