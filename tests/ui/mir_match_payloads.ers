// emit: mir
// A `match` on an enum with payloads (ADR 0040, 0042) is a switch on the
// tag of the scrutinee's copy, with a case per variant the arms name, then,
// under each variant, its chain: the alternatives naming it, in arm order,
// each testing its payload positions in turn, one switch with one case per
// test. A test that fails goes to the next alternative of the chain
// (`Msg::Write(0x10, 8)` reaches `Msg::Write(0x10 | 0x11, let v: u16)`),
// the or-pattern `0x10 | 0x11` is one switch, and a `let` copies its
// position where it is reached. An alternative testing nothing, as
// `Msg::Write(_, _)`, is its arm. The tag default, and the end of a chain,
// go to the `_` arm, or to one block calling the panic function, which they
// share: also at `Msg::Led`, whose arms list both values of a `bool`.
enum Mode: u8 { Off = 0, Run = 1 }
enum Msg: u8 { Nop = 0, Write(u8, u16) = 1, SetMode(Mode) = 2, Led(bool) = 3 }

fn decode(m: Msg) -> u16 {
    match m {
        Msg::Nop => 0,
        Msg::Write(0x10, 7) => 1,
        Msg::Write(0x10 | 0x11, let v: u16) => v,
        Msg::Write(_, _) => 2,
        Msg::SetMode(Mode::Off) => 3,
        Msg::SetMode(Mode::Run) => 4,
        Msg::Led(true) => 5,
        Msg::Led(false) => 6,
    }
}

fn wildcard(m: Msg) -> u16 {
    match m {
        Msg::SetMode(Mode::Run) => 1,
        Msg::SetMode(_) => 2,
        _ => 0,
    }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
