pub struct Circle {
    pub radius: u32,
}

struct Hidden {
    value: u32,
}

impl Circle {
    pub fn new() -> Self {
        Circle { radius: 1 }
    }

    pub fn area(&self) -> u32 {
        self.secret() + self.radius
    }

    fn secret(&self) -> u32 {
        self.radius
    }
}

impl Hidden {
    pub fn id(&self) -> u32 {
        self.value
    }
}

pub fn make() -> Hidden {
    Hidden { value: 1 }
}

pub mod inner {
    // A module inside the one of the type sees its private functions.
    pub fn secret_of(c: &super::Circle) -> u32 {
        c.secret()
    }
}
