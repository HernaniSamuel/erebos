// emit: mir
// The message of `assert` is built on the failing branch only, before the
// panic, which drops it until M2.6 (ADR 0031). It is a `&[u8]` (ADR 0116): a
// `&mut [u8; N]` converts to it, and so does a raw slice through `&*`.
fn reason() -> *const [u8] {
    &raw const b"x is too large"
}

fn checked(x: u32, s: &[u8], m: &mut [u8; 3]) {
    assert(x < 10, &b"x < 10");
    unsafe { assert(x < 20, &*reason()); }
    assert(x < 30, s);
    assert(x < 40, m);
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
