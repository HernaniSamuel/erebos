// emit: llvm-ir
// An enum is its integer type in LLVM IR (ADR 0035): a variant is an
// immediate, `==` an integer compare, a parameter is extended by its
// integer's signedness, a volatile access has its integer's width, and a
// `static mut` holding a variant of value 0 has a zero initializer, so
// it goes to `.bss`.
enum Mode: u8 { Off = 0, Run = 3 }
enum Level: i8 { Low = -1, High = 1 }
enum Port: u16 { Data = 0x3F8 }

static mut CURRENT: Mode = Mode::Off;

fn run() -> Mode {
    Mode::Run
}

fn is_running(m: Mode) -> bool {
    m == Mode::Run
}

fn level(l: Level) -> Level {
    l
}

fn select(reg: *mut volatile Port) {
    *reg = Port::Data;
}

fn set(m: Mode) {
    CURRENT = m;
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
