// emit: hir
// A second `memory` block anywhere in the program is an error (ADR 0057).
// "Second" is later in the order of files, numbered depth first
// (ADR 0049): the block of `board.ers` is gathered first, through the
// `mod` before the root's block, but its file comes after the root file, so
// the error is there, labeling the root's block. A third block, in an
// inline module of the root file, after the root's, is reported too, and
// so is the unknown name in its values.
mod board;

memory {
    region IMAGE { origin: 0x8000_0000, size: 0x10_0000 }
    region RAM { origin: 0x8400_0000, size: 0x10_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x1000 }
}

mod other {
    memory {
        region ROM { origin: 0, size: 16 }
        region RAM { origin: 16, size: 16 }
        code in ROM;
        data in RAM;
        stack in RAM { size: NO_SIZE }
    }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
