// emit: typeck
// `[v; N]` with `v` of a non-copy type is an error whatever `N` is, unless
// `v` is a variant written without payload values (ADR 0096).
struct Handle { id: u32 }

#[copy]
struct Point { x: u32, y: u32 }

enum State: u8 { Free = 0, Taken(Handle) = 1 }

// A linear type is never copy; its help offers no `#[copy]` (ADR 0101).
#[linear]
struct Ticket { id: u32 }

const FOUR: usize = 4;

fn open(id: u32) -> Handle { Handle { id: id } }

// Rejected: `N` of 0, 1 and 4, and a constant.
fn rejected(h: Handle) {
    let zero: [Handle; 0] = [open(0); 0];
    let one: [Handle; 1] = [open(1); 1];
    let four: [Handle; 4] = [open(2); 4];
    let by_const: [Handle; 4] = [open(3); FOUR];
    let nested: [[Handle; 2]; 2] = [[open(4), open(5)]; 2];
    let some: [Option(Handle); 2] = [.Some(h); 2];
    let taken: [State; 2] = [State::Taken(open(6)); 2];
    let tickets: [Ticket; 2] = [Ticket { id: 7 }; 2];
}

// Accepted: the type is copy.
fn copy_elements() {
    let points: [Point; 3] = [Point { x: 1, y: 2 }; 3];
    let bytes: [u8; 8] = [0; 8];
    let options: [Option(u32); 2] = [.Some(1); 2];
}

// Accepted: a variant written without payload values holds no handle.
static mut SLOTS: [Option(Handle); 32] = [.None; 32];
static mut STATES: [State; 4] = [State::Free; 4];
static mut ONE: [Option(Handle); 1] = [.None; 1];
static mut NONE: [Option(Handle); 0] = [.None; 0];

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
