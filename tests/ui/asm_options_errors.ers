// `ty::asm-options` (ADR 0079): options that contradict each other or the
// operands, an option or `clobber_abi` given twice, an ABI other than "C".
fn contradictions(x: u32) {
    let mut v: u32 = 0;
    unsafe { asm("", options(nomem, readonly)); }
    unsafe { asm("", options(readonly, nomem)); }
    unsafe { asm("{}", out(reg) v, options(pure)); }
    unsafe { asm("", options(pure, nomem)); }
    unsafe { asm("{}", out(reg) v, options(pure, nostack)); }
    unsafe { asm("", options(pure, readonly)); }
    // Accepted: with an output and `nomem` or `readonly`.
    unsafe { asm("{}", out(reg) v, options(pure, nomem)); }
    unsafe { asm("{}", out(reg) v, options(pure, readonly)); }
    unsafe { asm("{} {}", out(reg) v, in(reg) x, options(pure, nomem, nostack, preserves_flags)); }
}

fn stops(x: u32) {
    let mut v: u32 = 0;
    unsafe { asm("{}", out(reg) v, options(noreturn)); }
    unsafe { asm("{}", inout(reg) x => _, options(noreturn)); }
    unsafe { asm("", out("a0") _, options(noreturn)); }
    unsafe { asm("", in("a0") x, options(noreturn)); }
}

fn twice() {
    unsafe { asm("", options(nomem, nomem)); }
    unsafe { asm("", options(nostack, nomem, nostack)); }
    unsafe { asm("", clobber_abi("C"), clobber_abi("C")); }
}

fn abis() {
    unsafe { asm("", clobber_abi("D")); }
    unsafe { asm("", clobber_abi("")); }
    unsafe { asm("", clobber_abi("c")); }
    unsafe { asm("", clobber_abi("C")); }
}

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
