// emit: mir
// A reference is bound once (ADR 0094, 0105): a `mut` parameter, a `let mut`
// and a `mut` binding of a pattern cannot have a reference type. The error is
// at the written type; a `&&u32` is one error. The same types without `mut`
// are fine, and what `mut` changes is a `u32`. A binding of a pattern is the
// same (and a payload is never a reference, so the match reports its own
// mismatch as well).
static VALUE: u32 = 3;

fn parameter(mut r: &u32) -> u32 {
    *r
}

fn variable() -> u32 {
    let mut r: &u32 = &VALUE;
    *r
}

fn twice(mut r: &&u32) {}

fn pattern(o: Option(u8)) -> u32 {
    match o {
        .Some(let mut r: &u32) => 1,
        .None => 0,
    }
}

fn accepted(r: &u32) -> u32 {
    let s: &u32 = r;
    let mut n: u32 = *s;
    n = n + 1;
    n
}

entry fn main() -> ! {
    loop {}
}

panic fn on_panic() -> ! {
    loop {}
}
