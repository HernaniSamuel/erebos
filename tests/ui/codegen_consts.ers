// emit: llvm-ir
// Aggregate constants are private read-only data, with zero padding
// (ADR 0027, 0029); indexing one reads a single element from it.
const TABLE: [u16; 4] = [1, 2, 3, 4];
const PADDED: Padded = Padded { a: 0xAA, b: 0xBBBB_BBBB };
struct Padded { a: u8, b: u32 }

fn element(i: usize) -> u16 {
    TABLE[i]
}

fn field() -> u32 {
    let copy: Padded = PADDED;
    copy.b + PADDED.a as u32
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
