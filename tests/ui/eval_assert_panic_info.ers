// emit: mir
// With a panic function that takes the information, a failing `assert`
// with a message, in a program function run at compile time, fails the
// evaluation with its message, as without it: the panic function's body
// never runs there (ADR 0053).
fn checked(x: u32) -> u32 {
    assert(x < 10, &raw const b"x is too large");
    x
}

const FINE: u32 = checked(3);
const LARGE: u32 = checked(12);

entry fn main() -> ! { loop {} }
panic fn on_panic(info: *const core::PanicInfo) -> ! { loop {} }
