// emit: typeck
// `(unsafe { *p }) = 1` is an assignment to a block, rejected as an
// assignment to `{ *p }` is (ADR 0119); the plain block needs an `unsafe`
// block around it for the dereference. `unsafe { *p = 1; }` is the form that
// writes.
fn assign(p: *mut u32) {
    (unsafe { *p }) = 1;
    unsafe { ({ *p }) = 1; }
    unsafe { *p = 1; }
}

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
