// emit: typeck
// A call to an `unsafe fn` is an unsafe operation, allowed directly inside an
// `unsafe` block (ADR 0119): a free function, a function of a type, a method,
// one in a module and an `#[export]` one, from a function and from an
// `unsafe fn`, whose body is not a block but holds one.
unsafe fn plain(x: u32) -> u32 {
    x + 1
}

#[export]
unsafe fn exported(x: u32) -> u32 {
    x + 2
}

struct Counter {
    n: u32,
}

impl Counter {
    unsafe fn make(n: u32) -> Counter {
        Counter { n: n }
    }

    unsafe fn peek(&self) -> u32 {
        self.n
    }

    unsafe fn bump(&mut self) {
        self.n += 1;
    }
}

mod inner {
    pub unsafe fn deep() {}
}

fn calls(c: &mut Counter) -> u32 {
    let a: u32 = unsafe { plain(1) };
    let b: u32 = unsafe { exported(2) };
    let m: Counter = unsafe { Counter::make(3) };
    unsafe {
        c.bump();
        inner::deep();
    }
    let d: u32 = unsafe { c.peek() + m.peek() };
    // One block covers every operation directly in it.
    let e: u32 = unsafe { plain(plain(a)) };
    a + b + d + e
}

unsafe fn from_unsafe_fn(c: &mut Counter) -> u32 {
    // An `unsafe fn` body is not a block: this one is the block.
    unsafe { c.bump() };
    unsafe { plain(c.n) }
}

// The innermost block is the used one, and each holds an operation.
fn nested() -> u32 {
    unsafe {
        let outer: u32 = plain(1);
        let inner: u32 = unsafe { plain(2) };
        outer + inner
    }
}

// `return`, `break` and `continue` leave an `unsafe` block as they leave any.
fn leaves(limit: u32) -> u32 {
    let mut sum: u32 = 0;
    let mut i: u32 = 0;
    loop {
        i += 1;
        if i > limit {
            unsafe {
                return plain(sum);
            }
        }
        unsafe {
            if plain(i) == 3 {
                continue;
            }
            if plain(i) == 8 {
                break;
            }
        }
        sum += i;
    }
    sum
}

// Statements and values of other blocks around it.
fn around(c: &mut Counter) -> u32 {
    critical {
        unsafe {
            c.bump();
        }
    }
    unsafe {
        critical {
            c.bump();
        }
    }
    let ok: bool = if unsafe { plain(1) } == 2 { true } else { false };
    let v: u32 = match ok {
        true => unsafe { plain(1) },
        false => 0,
    };
    v
}

// A call to an `#[export]` function that is not `unsafe` is a safe call: only
// the `unsafe` ones need a block (ADR 0119).
#[export]
fn safe_exported(x: u32) -> u32 {
    x + 3
}

fn calls_safe_exported() -> u32 {
    safe_exported(1)
}

entry fn main() -> ! { loop {} }

panic fn on_panic() -> ! { loop {} }
