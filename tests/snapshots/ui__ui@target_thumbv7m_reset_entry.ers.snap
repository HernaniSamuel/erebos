--- llvm-ir ---
; ModuleID = 'erebos'
source_filename = "erebos"
target datalayout = "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "thumbv7m-none-eabi"

module asm "\09.section .vector_table, \22a\22, %progbits"
module asm "\09.p2align 2"
module asm "\09.word __stack_end"
module asm "\09.word _start"
module asm "\09.word __erebos_unhandled"
module asm "\09.word __erebos_unhandled"
module asm "\09.word __erebos_unhandled"
module asm "\09.word __erebos_unhandled"
module asm "\09.word __erebos_unhandled"
module asm "\09.word 0"
module asm "\09.word 0"
module asm "\09.word 0"
module asm "\09.word 0"
module asm "\09.word __erebos_unhandled"
module asm "\09.word __erebos_unhandled"
module asm "\09.word 0"
module asm "\09.word __erebos_unhandled"
module asm "\09.word tick"

@__erebos_panicking = internal global i8 0, align 1
@llvm.compiler.used = appending global [2 x ptr] [ptr @tick, ptr @__erebos_unhandled], section "llvm.metadata"

; Function Attrs: nounwind null_pointer_is_valid
define void @tick() #0 {
bb0:
  ret void
}

; Function Attrs: noreturn nounwind null_pointer_is_valid
define void @reset_main() #1 {
bb0:
  br label %bb1

bb1:                                              ; preds = %bb1, %bb0
  br label %bb1
}

; Function Attrs: noinline noreturn nounwind null_pointer_is_valid
define void @on_panic() #2 {
guard:
  %panicking = load volatile i8, ptr @__erebos_panicking, align 1
  %second = icmp ne i8 %panicking, 0
  br i1 %second, label %spin, label %first

spin:                                             ; preds = %spin, %guard
  br label %spin

first:                                            ; preds = %guard
  store volatile i8 1, ptr @__erebos_panicking, align 1
  br label %bb0

bb0:                                              ; preds = %first
  br label %bb1

bb1:                                              ; preds = %bb1, %bb0
  br label %bb1
}

; Function Attrs: noreturn nounwind null_pointer_is_valid
define void @__erebos_unhandled() #1 {
bb0:
  call void @on_panic()
  unreachable
}

attributes #0 = { nounwind null_pointer_is_valid }
attributes #1 = { noreturn nounwind null_pointer_is_valid }
attributes #2 = { noinline noreturn nounwind null_pointer_is_valid }
