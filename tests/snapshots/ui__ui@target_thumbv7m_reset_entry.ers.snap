---
source: tests/ui.rs
expression: output
input_file: tests/ui/target_thumbv7m_reset_entry.ers
---
--- llvm-ir ---
; ModuleID = 'erebos'
source_filename = "erebos"
target datalayout = "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "thumbv7m-none-eabi"

module asm "\09.section .vector_table, \22a\22, %progbits"
module asm "\09.p2align 2"
module asm "\09.word __stack_end"
module asm "\09.word _start"

; Function Attrs: noreturn nounwind null_pointer_is_valid
define void @reset_main() #0 {
bb0:
  br label %bb1

bb1:                                              ; preds = %bb1, %bb0
  br label %bb1
}

; Function Attrs: noreturn nounwind null_pointer_is_valid
define void @on_panic() #0 {
bb0:
  br label %bb1

bb1:                                              ; preds = %bb1, %bb0
  br label %bb1
}

attributes #0 = { noreturn nounwind null_pointer_is_valid }
