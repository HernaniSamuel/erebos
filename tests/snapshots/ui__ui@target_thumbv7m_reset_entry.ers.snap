--- llvm-ir ---
; ModuleID = 'erebos'
source_filename = "erebos"
target datalayout = "e-m:e-p:32:32-Fi8-i64:64-v128:64:128-a:0:32-n32-S64"
target triple = "thumbv7m-none-eabi"

module asm "\09.syntax unified"
module asm "\09.thumb"
module asm "\09.section .text.start, \22ax\22, %progbits"
module asm "\09.p2align 2"
module asm "\09.word __stack_end"
module asm "\09.word _start"
module asm "\09.globl _start"
module asm "\09.type _start, %function"
module asm "\09.thumb_func"
module asm "_start:"
module asm "\09ldr r0, =__stack_end"
module asm "\09mov sp, r0"
module asm "\09ldr r0, =__bss_start"
module asm "\09ldr r1, =__bss_end"
module asm "\09movs r2, #0"
module asm ".Lzero_bss:"
module asm "\09cmp r0, r1"
module asm "\09bhs .Lcopy_data"
module asm "\09str r2, [r0], #4"
module asm "\09b .Lzero_bss"
module asm ".Lcopy_data:"
module asm "\09ldr r0, =__data_start"
module asm "\09ldr r1, =__data_end"
module asm "\09ldr r2, =__data_load"
module asm ".Lcopy_word:"
module asm "\09cmp r0, r1"
module asm "\09bhs .Lenter"
module asm "\09ldr r3, [r2], #4"
module asm "\09str r3, [r0], #4"
module asm "\09b .Lcopy_word"
module asm ".Lenter:"
module asm "\09ldr r0, =reset_main"
module asm "\09bx r0"
module asm "\09.ltorg"

; Function Attrs: noreturn nounwind null_pointer_is_valid
define void @reset_main() #0 {
bb0:
  br label %bb1

bb1:                                              ; preds = %bb1, %bb0
  br label %bb1
}

; Function Attrs: noreturn nounwind null_pointer_is_valid
define void @on_panic() #0 {
bb0:
  br label %bb1

bb1:                                              ; preds = %bb1, %bb0
  br label %bb1
}

attributes #0 = { noreturn nounwind null_pointer_is_valid }
