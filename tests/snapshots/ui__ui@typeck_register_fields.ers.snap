peripheral Uart { read rbr: u8 at 0x0 read modifies, write thr: u8 at 0x0, write fcr: Fcr at 0x2 read modifies, read write lcr: Lcr at 0x3, read lsr: Lsr at 0x5, read write mode: Mode at 0x6 } extent 7, align 1
