// Structs whose layout `tests/c_layout.rs` checks against clang, compiling
// the C declarations in `structs.h` for the same target (ADR 0022). Every
// struct and enum with payloads here must have a C twin of the same name
// there.

struct S { a: u8, b: u32, c: u16 }
struct Wide { flag: bool, big: u64, small: i8 }
struct Nested { first: u8, s: S, tail: [u16; 3] }
struct Signed { a: i8, b: i16, c: i32, d: i64, e: isize }
struct Pointers { tag: u8, next: *mut Pointers, data: *const u16 }
struct Arrays { bytes: [u8; 5], words: [u32; 2], grid: [[u16; 3]; 2] }
struct OfStructs { items: [S; 3], count: u8 }

#[packed]
struct Header { kind: u8, len: u32, tag: u16 }

#[packed]
struct PackedNested { a: u8, s: S, w: Wide }

#[align(64)]
struct Descriptor { addr: u32, len: u32 }

#[align(16)]
struct Small { x: u8 }

struct Mixed { tag: u8, header: Header, tail: u16 }
struct HoldsAligned { a: u8, d: Descriptor, b: u8 }

// A slice is the C struct `{ const T *ptr; size_t len; }` (ADR 0031).
struct Message { kind: u8, text: *const [u8], parts: [*mut [u16]; 2], end: u16 }

// An enum is stored as its integer type (ADR 0035), as a C23 enum with
// that underlying type is.
enum Mode: u8 { Off = 0, Run = 3 }
enum Port: u16 { Data = 0x3F8 }
enum Level: i32 { Low = -1, High = 1 }
struct WithEnums { mode: Mode, port: Port, tag: u8, level: Level, last: Mode }

// An enum with payloads is a C union of structs that each start with the
// tag (ADR 0039), with payload values of alignment 1, 2, 4 and 8, and of
// struct types.
enum Pay8: u8 { Empty = 0, Byte(u8) = 1, Half(u8, u16) = 2, Word(u32) = 3, Long(u64) = 4 }
enum Pay16: u16 { A(u8) = 0, B(u64, u8) = 1, C(S) = 2, D = 3 }
enum Pay32: u32 { A(u8, u8) = 0, B(u16) = 1, C(Wide) = 2, D(i8, Pointers) = 3 }
struct WithPayloads { a: u8, p: Pay8, b: u16, q: Pay16, c: u8, r: Pay32 }

// `Option(T)` and `Result(T, E)` are enums with payloads on `u8`
// (ADR 0045); the twin of each is a union named after it, its arguments
// capitalized, `()` as `Unit` and an array `[T; N]` as `<T>x<N>`:
// `OptionU8`, `ResultU32Mode`, `OptionU32x0`. A zero-sized payload is
// placed at its alignment (ADR 0047).
struct WithOptions { a: Option(u8), b: Option(u32), c: Option(u64), d: Option(()), e: Result(u32, Mode), f: Option([u32; 0]) }

// A bit-field struct has its integer type's layout (ADR 0059): its C twin
// is that integer type, `uint8_t`, `uint16_t` or `uint32_t`.
struct Bits8: u8 { pub ready: bool at 0, pub count: u8 at 1..=7 }
struct Bits16: u16 { pub low: u8 at 0..=3, pub done: bool at 15 }
struct Bits32: u32 { pub low: u16 at 0..=11, pub high: u8 at 24..=31 }
struct WithBits { tag: u8, half: Bits16, byte: Bits8, word: Bits32, last: u8, bytes: [Bits8; 3], end: Bits16 }

// Visibility changes no layout (ADR 0050): private fields are laid out like
// `pub` ones. A struct of a module is shown by its path, `regs::Block`, and
// its twin is named with `__` for `::`, `regs__Block`.
mod regs {
    pub struct Block { pub ctrl: u32, status: u8, pub data: u16, reserved: [u8; 3], pub last: u64 }
}

entry fn main() -> ! { loop {} }
panic fn on_panic() -> ! { loop {} }
