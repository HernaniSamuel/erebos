<?xml version="1.0" encoding="utf-8"?>
<!-- Interrupt values SVD's syntax does not allow. -->
<device>
  <name>ERRORS</name>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>A</name>
      <baseAddress>0x40000000</baseAddress>
      <interrupt>
        <name>BAD_SYNTAX</name>
        <value>3h</value>
      </interrupt>
      <interrupt>
        <name>TOO_BIG</name>
        <value>0x1FFFFFFFFFFFFFFFF</value>
      </interrupt>
      <registers>
        <register><name>R</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
