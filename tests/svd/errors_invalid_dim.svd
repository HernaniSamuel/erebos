<?xml version="1.0" encoding="utf-8"?>
<!-- A dim without dimIncrement, and a dimIndex of the wrong length. -->
<device>
  <name>ERRORS</name>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>A</name>
      <baseAddress>0x40000000</baseAddress>
      <registers>
        <register><dim>4</dim><name>R%s</name><addressOffset>0x0</addressOffset></register>
        <register><dim>4</dim><dimIncrement>4</dimIncrement><dimIndex>1,2</dimIndex><name>S%s</name><addressOffset>0x20</addressOffset></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
