      <baseAddress>0x40000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
        <register><name>R1</name><addressOffset>0x4C</addressOffset></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
