<?xml version="1.0" encoding="utf-8"?>
<!-- expect-error: ty::peripheral-overlap -->
<!-- COVER covers ten peripherals that do not overlap each other: the warning names the first eight and counts the rest. -->
<device>
  <name>MANY</name>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>A0</name>
      <baseAddress>0x40000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>A1</name>
      <baseAddress>0x40000008</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>A2</name>
      <baseAddress>0x40000010</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>A3</name>
      <baseAddress>0x40000018</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>A4</name>
      <baseAddress>0x40000020</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>A5</name>
      <baseAddress>0x40000028</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>A6</name>
      <baseAddress>0x40000030</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>A7</name>
      <baseAddress>0x40000038</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>A8</name>
      <baseAddress>0x40000040</baseAddress>
