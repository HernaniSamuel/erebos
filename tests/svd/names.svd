<?xml version="1.0" encoding="utf-8"?>
<!-- Names (ADR 0071): words of Erebos, names that meet, characters no identifier has, indices in names. -->
<device>
  <name>NAMES</name>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>WORDS</name>
      <description>Registers and clusters named as keywords, built-in types, and words that are names by position.</description>
      <baseAddress>0x40000000</baseAddress>
      <registers>
        <register><name>CONTINUE</name><addressOffset>0x00</addressOffset></register>
        <register><name>MATCH</name><addressOffset>0x04</addressOffset></register>
        <register><name>IN</name><addressOffset>0x08</addressOffset></register>
        <register><name>READ</name><addressOffset>0x0C</addressOffset></register>
        <register><name>WRITE</name><addressOffset>0x10</addressOffset></register>
        <register><name>STEP</name><addressOffset>0x14</addressOffset></register>
        <register><name>AT</name><addressOffset>0x18</addressOffset></register>
        <register><name>OVER</name><addressOffset>0x1C</addressOffset></register>
        <register><name>CORE</name><addressOffset>0x20</addressOffset></register>
        <register><name>U8</name><addressOffset>0x24</addressOffset></register>
        <register><name>BOOL</name><addressOffset>0x28</addressOffset></register>
        <cluster>
          <name>LOOP</name>
          <addressOffset>0x100</addressOffset>
          <register><name>CONTINUE</name><addressOffset>0x0</addressOffset></register>
        </cluster>
        <cluster>
          <name>IN</name>
          <addressOffset>0x200</addressOffset>
          <register><name>READ</name><addressOffset>0x0</addressOffset></register>
        </cluster>
        <cluster>
          <name>READ</name>
          <addressOffset>0x300</addressOffset>
          <register><name>WRITE</name><addressOffset>0x0</addressOffset></register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>match</name>
      <description>A peripheral keeps its case, and `match` is a keyword.</description>
      <baseAddress>0x40001000</baseAddress>
      <registers>
        <register><name>R</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>MEET</name>
      <description>Names that meet after their case is converted.</description>
      <baseAddress>0x40002000</baseAddress>
      <registers>
        <register><name>FOO</name><addressOffset>0x00</addressOffset></register>
        <register><name>foo</name><addressOffset>0x04</addressOffset></register>
        <register><name>Foo</name><addressOffset>0x08</addressOffset></register>
        <register><name>BAR_</name><addressOffset>0x0C</addressOffset></register>
        <register><name>bar</name><addressOffset>0x10</addressOffset></register>
        <cluster>
          <name>SUB</name>
          <addressOffset>0x100</addressOffset>
          <register><name>CTRL</name><addressOffset>0x0</addressOffset></register>
        </cluster>
        <cluster>
          <name>sub</name>
          <addressOffset>0x200</addressOffset>
          <register><name>CTRL</name><addressOffset>0x0</addressOffset></register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>CHARS</name>
      <description>Characters no identifier has, and a leading digit.</description>
      <baseAddress>0x40003000</baseAddress>
      <registers>
        <register><name>A.B</name><addressOffset>0x00</addressOffset></register>
        <register><name>C-D</name><addressOffset>0x04</addressOffset></register>
        <register><name>E  F</name><addressOffset>0x08</addressOffset></register>
        <register><name>2FA</name><addressOffset>0x0C</addressOffset></register>
        <cluster>
          <name>7.UP</name>
          <addressOffset>0x100</addressOffset>
          <register><name>R</name><addressOffset>0x0</addressOffset></register>
        </cluster>
      </registers>
    </peripheral>
    <peripheral>
      <name>INDICES</name>
      <description>Indices in names.</description>
      <baseAddress>0x40004000</baseAddress>
      <registers>
        <register>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>2,3</dimIndex>
          <name>ITEM[%s]</name>
          <addressOffset>0x00</addressOffset>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <dimIndex>A,B</dimIndex>
          <name>CH%s_CONF0</name>
          <addressOffset>0x10</addressOffset>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <name>%s_LEADING</name>
          <addressOffset>0x20</addressOffset>
        </register>
        <register>
          <dim>2</dim>
          <dimIncrement>4</dimIncrement>
          <name>DUP%s</name>
          <addressOffset>0x30</addressOffset>
        </register>
        <register>
          <name>DUP0</name>
          <description>Meets the first element of DUP%s.</description>
          <addressOffset>0x40</addressOffset>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <dim>2</dim>
      <dimIncrement>0x1000</dimIncrement>
      <name>UART%s</name>
      <description>A peripheral type and its module from a name with `%s`.</description>
      <baseAddress>0x50000000</baseAddress>
      <registers>
        <register><name>CONF</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>uart</name>
      <description>Named as the module of UART%s: renamed.</description>
      <baseAddress>0x50010000</baseAddress>
      <registers>
        <register><name>CONF</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>3DES</name>
      <description>A peripheral that starts with a digit.</description>
      <baseAddress>0x50020000</baseAddress>
      <registers>
        <register><name>R</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>CORE</name>
      <baseAddress>0x50030000</baseAddress>
      <registers>
        <register><name>R</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
