<?xml version="1.0" encoding="utf-8"?>
<!-- Twelve peripherals at one address: the comments name the first eight they share bytes with, and count the rest. -->
<device>
  <name>MANY</name>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>P%s</name>
      <dim>12</dim>
      <dimIncrement>0</dimIncrement>
      <baseAddress>0x40000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
