<?xml version="1.0" encoding="utf-8"?>
<!-- Peripherals: derivedFrom (sharing a type, or not), dim, alternatePeripheral and the `over` the generator finds. -->
<device>
  <name>PERIPHERALS</name>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>UART0</name>
      <description>The first UART.</description>
      <baseAddress>0x60000000</baseAddress>
      <registers>
        <register><name>CONF</name><addressOffset>0x0</addressOffset></register>
        <register><name>STATUS</name><addressOffset>0x4</addressOffset><access>read-only</access></register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART1</name>
      <description>Derived with no register of its own: shares UART0's type.</description>
      <baseAddress>0x60001000</baseAddress>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART2</name>
      <description>Derived with a reset value of its own: a type of its own.</description>
      <baseAddress>0x60002000</baseAddress>
      <resetValue>0x1</resetValue>
    </peripheral>
    <peripheral derivedFrom="UART0">
      <name>UART3</name>
      <description>Derived with a register of its own, added after the base's.</description>
      <baseAddress>0x60003000</baseAddress>
      <registers>
        <register><name>EXTRA</name><addressOffset>0x8</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral derivedFrom="UART1">
      <name>UART4</name>
      <description>Derived from a peripheral that shares: shares the type too.</description>
      <baseAddress>0x60004000</baseAddress>
    </peripheral>
    <peripheral>
      <dim>2</dim>
      <dimIncrement>0x1000</dimIncrement>
      <name>TIMG%s</name>
      <description>Two timer groups, one type.</description>
      <baseAddress>0x61000000</baseAddress>
      <registers>
        <register><name>CFG</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>APB_CTRL</name>
      <baseAddress>0x60026000</baseAddress>
      <registers>
        <register><name>RND_DATA</name><addressOffset>0xB0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>RNG</name>
      <description>Lies inside APB_CTRL, and the SVD does not say so.</description>
      <baseAddress>0x60026000</baseAddress>
      <registers>
        <register><name>DATA</name><addressOffset>0xB0</addressOffset><access>read-only</access></register>
      </registers>
    </peripheral>

    <peripheral>
      <name>A</name>
      <baseAddress>0x70000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
        <register><name>R1</name><addressOffset>0x4</addressOffset></register>
        <register><name>R2</name><addressOffset>0x8</addressOffset></register>
        <register><name>R3</name><addressOffset>0xC</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>B</name>
      <baseAddress>0x70000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>C</name>
      <description>Shares bytes with A and with B: over A, to which B is over.</description>
      <baseAddress>0x70000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>

    <peripheral>
      <name>X</name>
      <baseAddress>0x71000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>Y</name>
      <description>Stated over X, which it does not overlap.</description>
      <alternatePeripheral>X</alternatePeripheral>
      <baseAddress>0x72000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>Z</name>
      <alternatePeripheral>X</alternatePeripheral>
      <baseAddress>0x72001000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>W</name>
      <description>Covers Y and Z, which are both over X: over X, which it does not overlap.</description>
      <baseAddress>0x72000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
        <register><name>R1</name><addressOffset>0x1000</addressOffset></register>
      </registers>
    </peripheral>

    <peripheral>
      <name>P</name>
      <baseAddress>0x73000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>Q</name>
      <alternatePeripheral>P</alternatePeripheral>
      <baseAddress>0x74000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
    <peripheral>
      <name>S</name>
      <description>Covers only Q, which is over P: over P, the first candidate in the file.</description>
      <baseAddress>0x74000000</baseAddress>
      <registers>
        <register><name>R0</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>

    <peripheral>
      <name>TIMG_VIEW</name>
      <description>Stated over a list: over its first peripheral.</description>
      <alternatePeripheral>TIMG%s</alternatePeripheral>
      <baseAddress>0x61000000</baseAddress>
      <registers>
        <register><name>CFG</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
