<?xml version="1.0" encoding="utf-8"?>
<!-- Interrupt names with nothing left for an identifier. -->
<device>
  <name>ERRORS</name>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>A</name>
      <baseAddress>0x40000000</baseAddress>
      <interrupt>
        <name>...</name>
        <value>1</value>
      </interrupt>
      <interrupt>
        <name> </name>
        <value>2</value>
      </interrupt>
      <interrupt>
        <name>%s</name>
        <value>3</value>
      </interrupt>
      <interrupt>
        <name>OK</name>
        <value>4</value>
      </interrupt>
      <registers>
        <register><name>R</name><addressOffset>0x0</addressOffset></register>
      </registers>
    </peripheral>
  </peripherals>
</device>
