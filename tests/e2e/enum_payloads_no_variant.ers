// Values of an enum with payloads that are no variant (ADR 0036, 0040):
// a tag that is no variant, and a nested `Mode` that is no variant, read
// through a cast pointer from a static byte array aligned as `Msg` is.
// Arms with `_` handle them; a `match` that examines the nested `Mode`
// with variant patterns only calls the panic function.
// expect-output: tag?
// expect-output: mode?
// expect-output: run
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

enum Mode: u8 { Off = 0, Run = 1 }
#[copy]
enum Msg: u8 { Nop = 0, Wide(u32) = 1, SetMode(Mode) = 2 }

// The tag 9, `Msg::SetMode` holding the byte 7, then `Msg::SetMode(Mode::Run)`.
#[align(4)]
static BYTES: [u8; 24] = [
    9, 0, 0, 0, 0, 0, 0, 0,
    2, 7, 0, 0, 0, 0, 0, 0,
    2, 1, 0, 0, 0, 0, 0, 0,
];

fn print(s: &[u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc(s[i]);
        i += 1;
    }
    putc(b'\n');
}

fn handled(m: Msg) -> &[u8] {
    match m {
        Msg::Nop => &b"nop",
        Msg::Wide(_) => &b"wide",
        Msg::SetMode(Mode::Off) => &b"off",
        Msg::SetMode(Mode::Run) => &b"run",
        Msg::SetMode(_) => &b"mode?",
        _ => &b"tag?",
    }
}

fn strict(m: Msg) -> &[u8] {
    match m {
        Msg::Nop => &b"nop",
        Msg::Wide(_) => &b"wide",
        Msg::SetMode(Mode::Off) => &b"off",
        Msg::SetMode(Mode::Run) => &b"run",
    }
}

entry fn main() -> ! {
    let msgs: *const Msg = &raw const BYTES as *const Msg;
    unsafe { print(handled(msgs[0])); }
    unsafe { print(handled(msgs[1])); }
    unsafe { print(strict(msgs[2])); }
    unsafe { print(strict(msgs[1])); }
    exit(0)
}

panic fn on_panic() -> ! {
    print(&b"panic");
    exit(1)
}
