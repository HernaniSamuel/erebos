// A tag that is no variant (ADR 0036, 0040), read through a cast pointer
// from a static byte array aligned as `Msg` is: a `match` listing every
// variant, without a catch-all arm, calls the panic function on it.
// expect-output: wide
// expect-output: panic
// expect-exit: 1

enum Mode: u8 { Off = 0, Run = 1 }
enum Msg: u8 { Nop = 0, Wide(u32) = 1, SetMode(Mode) = 2 }

// `Msg::Wide(5)`, then the tag 9.
#[align(4)]
static BYTES: [u8; 16] = [
    1, 0, 0, 0, 5, 0, 0, 0,
    9, 0, 0, 0, 0, 0, 0, 0,
];

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
    putc(b'\n');
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

fn strict(m: Msg) -> *const [u8] {
    match m {
        Msg::Nop => &raw const b"nop",
        Msg::Wide(5) => &raw const b"wide",
        Msg::Wide(_) => &raw const b"other wide",
        Msg::SetMode(_) => &raw const b"mode",
    }
}

entry fn main() -> ! {
    let msgs: *const Msg = &raw const BYTES as *const Msg;
    print(strict(msgs[0]));
    print(strict(msgs[1]));
    exit(0)
}

panic fn on_panic() -> ! {
    print(&raw const b"panic");
    exit(1)
}

// QEMU `virt`'s RAM laid out as ADR 0030 had it: the image in the first
// 64 MiB, a 1 MiB stack, `.data` and `.bss` in the last 64 MiB.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}
