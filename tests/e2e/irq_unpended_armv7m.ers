// `nvic_unpend` takes a pended line back (ADR 0091): the line is enabled and
// pended, then unpended, and is not pending; with interrupts enabled its handler
// does not run through a fixed number of loops. A pend after that runs it, so
// that the silence above is not a line that never works.
// takes-exceptions: yes
// targets: thumbv7m-none-eabi
// expect-output: unpend ok
// expect-exit: 0

mod board;
use board::{exit, putc};

#[interrupts]
enum Interrupt: u32 {
    Spi = 3,
}

static mut RUNS: u32 = 0;

interrupt fn spi() at Interrupt::Spi {
    RUNS += 1;
}

entry fn main() -> ! {
    let line: u32 = Interrupt::Spi as u32;
    core::arch::nvic_enable(line);
    core::arch::nvic_pend(line);
    core::arch::nvic_unpend(line);
    if core::arch::nvic_is_pending(line) {
        exit(2)
    }
    core::arch::enable_interrupts();
    let mut loops: u32 = 0;
    while loops < 1000 {
        core::arch::compiler_fence();
        if RUNS != 0 {
            exit(3)
        }
        loops += 1;
    }
    core::arch::nvic_pend(line);
    loop {
        critical {
            if RUNS != 0 {
                break;
            }
            core::arch::wait_for_interrupt();
        }
    }
    if RUNS != 1 {
        exit(4)
    }
    putc(b'u'); putc(b'n'); putc(b'p'); putc(b'e'); putc(b'n'); putc(b'd'); putc(b' ');
    putc(b'o'); putc(b'k'); putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(99)
}
