// C small data (`.sdata`, `.sbss`, `.srodata`) is placed and initialized
// like the rest (ADR 0030): its globals hold their values on entry.
// link-c: small_data.c
// c-flags: -msmall-data-limit=8
// expect-output: small data ok
// expect-exit: 0

extern fn c_check() -> u32;
extern fn c_small_zero() -> u32;

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

entry fn main() -> ! {
    let failures: u32 = c_check();
    if failures != 0 || c_small_zero() != 5 {
        exit(1)
    }
    putc(b's'); putc(b'm'); putc(b'a'); putc(b'l'); putc(b'l'); putc(b' ');
    putc(b'd'); putc(b'a'); putc(b't'); putc(b'a'); putc(b' ');
    putc(b'o'); putc(b'k'); putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(99)
}

// QEMU `virt`'s RAM in two regions of 64 MiB: the image in the first, and
// in the second a 1 MiB stack at its start, then `.data` and `.bss`.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}
