// A C file with debug information links: every debug section is placed,
// none is an orphan (ADR 0030). Here, besides the usual ones, those of
// DWARF 4: `.debug_aranges`, `.debug_loc` (with `-O`), `.debug_macinfo`,
// `.debug_pubnames`, `.debug_pubtypes`, `.debug_ranges` (without `-O`).
// link-c: debug_info.c
// c-flags: -g -gdwarf-4 -gpubnames -ffunction-sections -fdebug-macro -gdwarf-aranges
// expect-output: 16
// expect-exit: 0

mod board;
use board::{exit, putc};

extern fn c_debug(x: u32) -> u32;

fn print_u32(n: u32) {
    if n >= 10 {
        print_u32(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

entry fn main() -> ! {
    print_u32(c_debug(3));
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
