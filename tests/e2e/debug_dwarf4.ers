// A C file with debug information links: every debug section is placed,
// none is an orphan (ADR 0030). Here, besides the usual ones, those of
// DWARF 4: `.debug_aranges`, `.debug_loc` (with `-O`), `.debug_macinfo`,
// `.debug_pubnames`, `.debug_pubtypes`, `.debug_ranges` (without `-O`).
// link-c: debug_info.c
// c-flags: -g -gdwarf-4 -gpubnames -ffunction-sections -fdebug-macro -gdwarf-aranges
// expect-output: 16
// expect-exit: 0

extern fn c_debug(x: u32) -> u32;

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn print_u32(n: u32) {
    if n >= 10 {
        print_u32(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

entry fn main() -> ! {
    print_u32(c_debug(3));
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}

// QEMU `virt`'s RAM in two regions of 64 MiB: the image in the first, and
// in the second a 1 MiB stack at its start, then `.data` and `.bss`.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}
