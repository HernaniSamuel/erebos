// A check that fails in a maskable handler reaches the panic function (ADR
// 0085): the timer's handler divides by a zero that the compiler cannot see, and
// the panic function runs in the handler's context, where `mcause` is the
// machine timer's, 7 with bit 31 set.
// takes-exceptions: yes
// targets: riscv32imac-unknown-none-elf
// expect-output: division by zero mcause 80000007
// expect-exit: 1

mod board;
use board::{exit, putc};
use core::arch::Vector;

const MTIME: *mut volatile u32 = 0x0200_BFF8 as *mut volatile u32;
const MTIMECMP_LOW: *mut volatile u32 = 0x0200_4000 as *mut volatile u32;
const MTIMECMP_HIGH: *mut volatile u32 = 0x0200_4004 as *mut volatile u32;
const MTIE: u32 = 0x80;
const ZERO: *mut volatile u32 = board::SCRATCH as *mut volatile u32;

static mut QUOTIENT: u32 = 0;

interrupt fn tick() at Vector::MachineTimer {
    QUOTIENT = 100 / *ZERO;
}

entry fn main() -> ! {
    *MTIMECMP_HIGH = 0;
    *MTIMECMP_LOW = *MTIME + 1000;
    asm("csrs mie, {}", in(reg) MTIE, options(nostack, preserves_flags));
    core::arch::enable_interrupts();
    loop {
        core::arch::wait_for_interrupt();
    }
}

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
}

fn print_hex(value: u32) {
    let mut shift: u32 = 32;
    while shift > 0 {
        shift -= 4;
        let digit: u8 = ((value >> shift) & 15) as u8;
        putc(if digit < 10 { b'0' + digit } else { b'a' + digit - 10 });
    }
}

panic fn on_panic(info: *const core::PanicInfo) -> ! {
    match (*info).reason {
        .DivisionByZero => print(&raw const b"division by zero"),
        _ => exit(3),
    }
    let mut cause: u32 = 0;
    asm("csrr {}, mcause", out(reg) cause, options(nostack, preserves_flags));
    print(&raw const b" mcause ");
    print_hex(cause);
    putc(b'\n');
    exit(1)
}
