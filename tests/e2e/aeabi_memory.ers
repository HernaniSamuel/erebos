// The twelve ARM EABI memory functions that `core` defines on every target
// (ADR 0074), called from C, which nothing else calls on riscv32: copies and
// moves (overlapping in both directions, and of no bytes), fills with
// `__aeabi_memset`'s length before its value, and clears. The C side numbers
// its checks and returns the first that failed; this program reports it
// through the UART and the exit code, and the number of checks that ran.
// link-c: aeabi_memory.c
// expect-output: ok 64
// expect-exit: 0

mod board;
use board::{exit, print_u32, putc};

// `#[stack(N)]` on each `extern fn` (ADR 0122): the depth of its C definition
// from `clang -fstack-usage` at -O0 and -O2 on both targets (the largest), with
// the C functions it calls. Where C calls an Erebos function, or one of `core`'s
// such as `memcpy`, that function's depth from `--emit=stack`, the largest of the
// four builds (the number stays the program's word, ADR 0122). `c_check_aeabi`
// is 240: its `check_*` helpers call function pointers at -O0, which are always
// `__aeabi_mem*`, so those calls take the largest depth among the twelve
// `__aeabi_mem*` bodies of `core` in the report.
#[stack(240)]
extern fn c_check_aeabi() -> u32;
#[stack(16)]
extern fn c_aeabi_checks() -> u32;

entry fn main() -> ! {
    let failed: u32 = unsafe { c_check_aeabi() };
    if failed == 0 {
        putc(b'o');
        putc(b'k');
    } else {
        putc(b'f');
        putc(b'a');
        putc(b'i');
        putc(b'l');
        putc(b' ');
        print_u32(failed);
    }
    putc(b' ');
    print_u32(unsafe { c_aeabi_checks() });
    putc(b'\n');
    exit(failed)
}

panic fn on_panic() -> ! {
    exit(1)
}
