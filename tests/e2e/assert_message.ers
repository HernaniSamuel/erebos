// The message of `assert` is evaluated only if the assertion fails
// (ADR 0031): a passing one never runs it, and a failing one runs it
// before calling the panic function, which drops it until M2.6.
// expect-output: passed
// expect-output: x is too large
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, print};

fn reason() -> &[u8] {
    print(&b"x is too large\n");
    &b"x is too large"
}

fn checked(x: u32) {
    assert(x < 10, reason());
}

entry fn main() -> ! {
    checked(3);
    print(&b"passed\n");
    checked(12);
    exit(0)
}

panic fn on_panic() -> ! {
    print(&b"panic\n");
    exit(1)
}
