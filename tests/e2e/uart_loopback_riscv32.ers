// Two causes of one source of the PLIC (ADR 0091, 0092): the 16550 of QEMU
// `virt` in loopback (`MCR.LOOP`), with no SVD file: its registers and the PLIC's
// are declared here, and the list is hand-written, `Uart0 = 10`. The handler, at
// `Vector::MachineExternal`, claims source 10 and reads `IIR` for the cause.
// With `IER.RDI` alone, a byte written to `THR` comes back as a received one:
// `IIR` 4, and `RBR` holds the byte. With `IER.THRI` alone, an empty `THR`
// raises the interrupt at once: `IIR` 2. The entry function waits for each in
// a `critical` block with `wait_for_interrupt`, and finds that a handler ran
// once for each, and `claim` is 0 when nothing is raised.
// takes-exceptions: yes
// targets: riscv32imac-unknown-none-elf
// expect-output: loopback ok
// expect-exit: 0

mod board;
use board::{exit, putc};
use core::arch::Vector;

#[interrupts]
enum Interrupt: u32 {
    Uart0 = 10,
}

// The 16550: the receiver buffer and the transmitter holding register share an
// offset, as `IER`'s bits and the next registers do.
peripheral Uart {
    read rbr: u8 at 0x0,
    write thr: u8 at 0x0,
    read write ier: Ier at 0x1,
    read iir: Iir at 0x2 read modifies,
    read write mcr: Mcr at 0x4,
}

struct Ier: u8 {
    rdi: bool at 0 = false,
    thri: bool at 1 = false,
}

struct Iir: u8 {
    cause: u8 at 0..=3,
}

struct Mcr: u8 {
    loopback: bool at 4 = false,
}

// The PLIC of hart 0: priorities, the enable word of the machine context, and
// its threshold and claim.
peripheral Plic {
    read write priority: [u32; 16] at 0x0,
    read write enable: u32 at 0x2000,
    read write threshold: u32 at 0x20_0000,
    read write claim: u32 at 0x20_0004 read modifies,
}

peripheral UART0: Uart at 0x1000_0000;
peripheral PLIC: Plic at 0xC00_0000;

const UART_SOURCE: u32 = Interrupt::Uart0 as u32;

// What the handler saw: the cause of each run, the last byte received, how many
// times each cause came.
static mut CAUSE: u8 = 0;
static mut BYTE: u8 = 0;
static mut RECEIVED: u32 = 0;
static mut EMPTY: u32 = 0;

fn uart_interrupt() {
    let cause: u8 = UART0.iir.cause;
    CAUSE = cause;
    if cause == 4 {
        BYTE = UART0.rbr;
        RECEIVED += 1;
    } else if cause == 2 {
        EMPTY += 1;
        // The cause is taken; the line stays quiet until `THRI` is set again.
        UART0.ier.thri = false;
    } else {
        exit(12)
    }
}

interrupt fn external() at Vector::MachineExternal {
    if core::arch::interrupts_enabled() {
        exit(10)
    }
    loop {
        let source: u32 = PLIC.claim;
        if source == 0 {
            break;
        }
        match source {
            UART_SOURCE => uart_interrupt(),
            _ => exit(11),
        }
        PLIC.claim = source;
    }
}

// Waits, with interrupts masked, until the handler has served `count` of the
// cause; the handler runs when the block ends.
fn wait_for_received(count: u32) {
    loop {
        critical {
            if RECEIVED >= count {
                break;
            }
            core::arch::wait_for_interrupt();
        }
    }
}

fn wait_for_empty(count: u32) {
    loop {
        critical {
            if EMPTY >= count {
                break;
            }
            core::arch::wait_for_interrupt();
        }
    }
}

entry fn main() -> ! {
    PLIC.priority[UART_SOURCE as usize] = 1;
    PLIC.enable = 1 << UART_SOURCE;
    PLIC.threshold = 0;
    // `mie.MEIE`: the machine external interrupt is enabled.
    asm("csrs mie, {}", in(reg) 0x800 as u32, options(nostack, preserves_flags));
    core::arch::enable_interrupts();

    // Nothing is enabled in the UART, and nothing is raised.
    if PLIC.claim != 0 {
        exit(2)
    }

    // A byte written in loopback comes back as a received one: cause 4.
    UART0.mcr = Mcr { loopback: true };
    UART0.ier = Ier { rdi: true, .. };
    UART0.thr = b'x';
    wait_for_received(1);
    critical {
        if CAUSE != 4 || BYTE != b'x' || RECEIVED != 1 || EMPTY != 0 {
            exit(3)
        }
    }

    // An empty `THR` raises the interrupt when `THRI` is set: cause 2.
    UART0.ier = Ier { thri: true, .. };
    wait_for_empty(1);
    critical {
        if CAUSE != 2 || RECEIVED != 1 || EMPTY != 1 {
            exit(4)
        }
    }

    // Both off: one source, no cause left.
    UART0.ier = Ier { .. };
    UART0.mcr = Mcr { .. };
    if PLIC.claim != 0 {
        exit(5)
    }
    putc(b'l'); putc(b'o'); putc(b'o'); putc(b'p'); putc(b'b'); putc(b'a');
    putc(b'c'); putc(b'k'); putc(b' '); putc(b'o'); putc(b'k'); putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(99)
}
