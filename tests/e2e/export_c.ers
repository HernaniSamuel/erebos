// An `#[export]` function and an `#[export]` static of a submodule have
// their own names as symbols, so C calls the one and reads the other
// (ADR 0051).
// link-c: export_c.c
// expect-output: 42 43 85
// expect-exit: 0

mod board;
use board::{exit, print_u32, putc};

// `#[stack(N)]` on each `extern fn` (ADR 0122): the depth of its C definition
// from `clang -fstack-usage` at -O0 and -O2 on both targets (the largest), with
// the C functions it calls. Where C calls an Erebos function, or one of `core`'s
// such as `memcpy`, that function's depth from `--emit=stack`, the largest of the
// four builds (the number stays the program's word, ADR 0122).
#[stack(16)]
extern fn c_read_ticks() -> u32;
#[stack(224)]
extern fn c_double_plus_one(n: u32) -> u32;

mod timer {
    #[export]
    pub static mut ticks: u32 = 42;

    #[export]
    pub fn erebos_double(n: u32) -> u32 {
        n * 2
    }
}

entry fn main() -> ! {
    print_u32(unsafe { c_read_ticks() });
    putc(b' ');
    timer::ticks += 1;
    print_u32(unsafe { c_read_ticks() });
    putc(b' ');
    print_u32(unsafe { c_double_plus_one(42) });
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
