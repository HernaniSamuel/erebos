// `sym entry` names the entry function's symbol (ADR 0083): the entry
// function, in a module and named like a function of the root, counts its
// runs in a `static mut`. The first run fails a check, and the panic function
// jumps to the entry function again through `asm` with `sym entry`; the second
// run exits 0, so the symbol is the entry function's and not the root
// `main`'s, which would exit 3. The jump is in the panic function and not in a
// function the entry function calls: the stack bound (ADR 0123) rejects a
// cycle of calls and `sym` operands, and lets the panic function restart the
// program, since a second panic stops (ADR 0121). The assembly is riscv32's,
// which is why the header lists one target (the reason ADR 0079 adds to
// ADR 0077's).
// targets: riscv32imac-unknown-none-elf
// expect-output: 1 2
// expect-exit: 0

mod board;
use board::{exit, putc};

static mut RUNS: u32 = 0;

fn main() -> ! {
    exit(3)
}

fn divide(a: u32, b: u32) -> u32 {
    a + a / b
}

mod app {
    entry fn main() -> ! {
        crate::RUNS += 1;
        if crate::RUNS == 1 {
            crate::putc(b'1');
            crate::putc(b' ');
            crate::putc(b'0' + crate::divide(1, 0) as u8);
        }
        crate::putc(b'2');
        crate::putc(b'\n');
        crate::exit(0)
    }
}

panic fn on_panic() -> ! {
    unsafe { asm("j {}", sym entry, options(noreturn, nostack)) }
}
