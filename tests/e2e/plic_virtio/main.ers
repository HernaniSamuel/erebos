// The program of M3.4a (roadmap): QEMU `virt`'s PLIC and virtio-mmio
// transports through register arrays and clusters, declared in `devices.ers`
// (ADR 0064, 0066). The priorities of sources 1 to 8 are written in a loop
// with a run-time index, each a value from 1 to 7 (QEMU's PLIC keeps 3
// priority bits), and read back. The enable word of context 0 is set, and
// the thresholds of both contexts through one driver taking a `*mut
// PlicContext`, which `&raw mut PLIC.ctx[i]` serves with each context; the
// threshold of context 0 is read back through `PLIC_M0`, a second view of
// the same bytes. With nothing pending, `claim` is 0. Each transport is
// read through one driver taking a `*const VirtioMmio`, from a table of
// pointers: the magic value is "virt" in ASCII, `DeviceID` is 0 where no
// device is attached, and `Version` and `VendorID` are what QEMU 11.1
// gives with the flags of the harness (`Version` 1, the legacy transport,
// as QEMU's default is still legacy; `VendorID` is "QEMU" in ASCII).
// Only on riscv32 (ADR 0077, reason 1): it drives `virt`'s PLIC and
// virtio-mmio transports. It keeps its own devices and `memory` block.
// targets: riscv32imac-unknown-none-elf
// expect-output: priorities 1 2 3 4 5 6 7 1
// expect-output: enable 0x000001FE
// expect-output: threshold 3 5
// expect-output: threshold m0 3
// expect-output: claim 0
// expect-output: virtio0 magic 0x74726976 version 1 device 0 vendor 0x554D4551
// expect-output: virtio1 magic 0x74726976 version 1 device 0 vendor 0x554D4551
// expect-output: virtio2 magic 0x74726976 version 1 device 0 vendor 0x554D4551
// expect-output: virtio3 magic 0x74726976 version 1 device 0 vendor 0x554D4551
// expect-output: virtio4 magic 0x74726976 version 1 device 0 vendor 0x554D4551
// expect-output: virtio5 magic 0x74726976 version 1 device 0 vendor 0x554D4551
// expect-output: virtio6 magic 0x74726976 version 1 device 0 vendor 0x554D4551
// expect-output: virtio7 magic 0x74726976 version 1 device 0 vendor 0x554D4551
// expect-exit: 0
mod devices;

use devices::{PlicContext, VirtioMmio};

static TRANSPORTS: [*const VirtioMmio; 8] = [
    &raw const devices::VIRTIO0,
    &raw const devices::VIRTIO1,
    &raw const devices::VIRTIO2,
    &raw const devices::VIRTIO3,
    &raw const devices::VIRTIO4,
    &raw const devices::VIRTIO5,
    &raw const devices::VIRTIO6,
    &raw const devices::VIRTIO7,
];

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        devices::putc((*s)[i]);
        i += 1;
    }
}

// `value` in decimal; the program prints nothing larger than 9.
fn print_digit(value: u32) {
    devices::putc(b'0' + value as u8);
}

// ` 0x` and eight hex digits.
fn print_hex(value: u32) {
    print(&raw const b" 0x");
    let mut shift: u32 = 32;
    while shift > 0 {
        shift -= 4;
        let digit: u8 = ((value >> shift) & 0xF) as u8;
        devices::putc(if digit < 10 { b'0' + digit } else { b'A' + digit - 10 });
    }
}

// The driver of one PLIC context, whichever it is.
fn set_threshold(context: *mut PlicContext, value: u32) {
    (*context).threshold = value;
}

// The driver of one virtio-mmio transport, whichever it is.
fn describe(index: usize, transport: *const VirtioMmio) {
    print(&raw const b"virtio");
    print_digit(index as u32);
    print(&raw const b" magic");
    print_hex((*transport).magic_value);
    print(&raw const b" version ");
    print_digit((*transport).version);
    print(&raw const b" device ");
    print_digit((*transport).device_id);
    print(&raw const b" vendor");
    print_hex((*transport).vendor_id);
    print(&raw const b"\n");
}

entry fn main() -> ! {
    // Sources 1 to 8, priorities 1 to 7 and 1 again.
    let mut source: usize = 1;
    while source <= 8 {
        devices::PLIC.priority[source] = ((source - 1) % 7 + 1) as u32;
        source += 1;
    }
    print(&raw const b"priorities");
    source = 1;
    while source <= 8 {
        devices::putc(b' ');
        print_digit(devices::PLIC.priority[source]);
        source += 1;
    }
    print(&raw const b"\n");

    // Sources 1 to 8 enabled for context 0.
    devices::PLIC.enables[0].word[0] = 0x1FE;
    print(&raw const b"enable");
    print_hex(devices::PLIC.enables[0].word[0]);
    print(&raw const b"\n");

    // Threshold 3 for context 0 and 5 for context 1, through one driver.
    let mut context: usize = 0;
    while context < 2 {
        set_threshold(&raw mut devices::PLIC.ctx[context], 3 + context as u32 * 2);
        context += 1;
    }
    print(&raw const b"threshold ");
    print_digit(devices::PLIC.ctx[0].threshold);
    devices::putc(b' ');
    print_digit(devices::PLIC.ctx[1].threshold);
    print(&raw const b"\nthreshold m0 ");
    print_digit(devices::PLIC_M0.threshold);
    print(&raw const b"\nclaim ");
    print_digit(devices::PLIC_M0.claim);
    print(&raw const b"\n");

    let mut transport: usize = 0;
    while transport < 8 {
        describe(transport, TRANSPORTS[transport]);
        transport += 1;
    }
    devices::exit(0)
}

panic fn on_panic() -> ! {
    devices::exit(1)
}

// QEMU `virt`'s RAM in two regions of 64 MiB: the image in the first, and
// in the second a 1 MiB stack at its start, then `.data` and `.bss`.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}
