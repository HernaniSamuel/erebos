// The M1 goal program: UART output and exit through functions, plus
// recursion and calls to functions declared later.
// expect-output: hi
// expect-output: 012
// expect-output: 55 89
// expect-exit: 0

mod board;
use board::{exit, putc};

panic fn on_panic() -> ! {
    exit(1)
}

entry fn main() -> ! {
    putc(b'h'); putc(b'i'); putc(b'\n');
    let mut i: u32 = 0;
    while i < 3 {
        putc(b'0' + i as u8);
        i += 1;
    }
    putc(b'\n');

    print_u8(fib(10) as u8);
    putc(b' ');
    print_u8(fib(11) as u8);
    putc(b'\n');
    exit(0)
}

fn fib(n: u32) -> u32 {
    if n < 2 { n } else { fib(n - 1) + fib(n - 2) }
}

/// Prints a value below 100 without division (which arrives later).
fn print_u8(mut n: u8) {
    let mut tens: u8 = 0;
    while n >= 10 {
        n -= 10;
        tens += 1;
    }
    if tens > 0 {
        putc(b'0' + tens);
    }
    putc(b'0' + n);
}
