// The entry function may be in any module, and share its name with a
// function of another module declared before it, which keeps the name in
// LLVM until symbols are named by module paths: `_start` jumps to the
// entry function by the name LLVM gave it (ADR 0012, 0049). Booting the
// root `main` instead would return to nowhere.
// expect-exit: 7
fn main() -> u32 { 7 }

mod app {
    entry fn main() -> ! {
        let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
        *finisher = super::main() << 16 | 0x3333;
        loop {}
    }
}

panic fn on_panic() -> ! { loop {} }
