// The entry function may be in any module, and share its name with a
// function of another module declared before it: its symbol is
// `app.main`, which `_start` jumps to (ADR 0012, 0051). Booting the root
// `main` instead would return to nowhere.
// expect-exit: 7
fn main() -> u32 { 7 }

mod app {
    entry fn main() -> ! {
        let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
        *finisher = super::main() << 16 | 0x3333;
        loop {}
    }
}

panic fn on_panic() -> ! { loop {} }

// QEMU `virt`'s RAM in two regions of 64 MiB: the image in the first, and
// in the second a 1 MiB stack at its start, then `.data` and `.bss`.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}
