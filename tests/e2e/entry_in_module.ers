// The entry function may be in any module, and share its name with a
// function of another module declared before it: its symbol is
// `app.main`, which `_start` jumps to (ADR 0083, 0051). Booting the root
// `main` instead would return to nowhere.
// expect-exit: 7

mod board;

fn main() -> u32 { 7 }

mod app {
    entry fn main() -> ! {
        crate::board::exit(super::main())
    }
}

panic fn on_panic() -> ! { loop {} }
