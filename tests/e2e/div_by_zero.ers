// Dividing by zero at run time calls the panic function (ADR 0007, 0014).
// expect-output: before
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

fn divide(a: u32, b: u32) -> u32 {
    a / b
}

entry fn main() -> ! {
    putc(b'b'); putc(b'e'); putc(b'f'); putc(b'o'); putc(b'r'); putc(b'e');
    putc(b'\n');
    let r: u32 = divide(10, 0);
    putc(b'0' + r as u8);
    exit(0)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c');
    putc(b'\n');
    exit(1)
}
