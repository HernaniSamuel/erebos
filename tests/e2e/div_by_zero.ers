// Dividing by zero at run time calls the panic function (ADR 0007, 0014).
// expect-output: before
// expect-output: panic
// expect-exit: 1

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

fn divide(a: u32, b: u32) -> u32 {
    a / b
}

entry fn main() -> ! {
    putc(b'b'); putc(b'e'); putc(b'f'); putc(b'o'); putc(b'r'); putc(b'e');
    putc(b'\n');
    let r: u32 = divide(10, 0);
    putc(b'0' + r as u8);
    exit(0)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c');
    putc(b'\n');
    exit(1)
}
