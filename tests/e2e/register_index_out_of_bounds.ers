// An index past a register array at run time calls the panic function (ADR
// 0064, 0053), which prints the reason, the file, the line and the column of
// the `[` of the index. The registers are the first four priorities of
// QEMU `virt`'s PLIC, which keep the value written (3 bits, so 1 to 7).
// expect-output: 6
// expect-output: index out of bounds at register_index_out_of_bounds.ers:23:18
// expect-exit: 1

mod board;
use board::exit;

peripheral Plic {
    read write priority: [u32; 4] at 0x0000,
}

peripheral PLIC: Plic at 0x0C00_0000;

fn store(i: usize, value: u32) {
    PLIC.priority[i] = value;
}

fn load(i: usize) -> u32 {
    PLIC.priority[i]
}

entry fn main() -> ! {
    store(3, 6);
    print_u32(load(3));
    print(&raw const b"\n");
    print_u32(load(4));
    exit(0)
}

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        board::putc((*s)[i]);
        i += 1;
    }
}

fn print_u32(value: u32) {
    let mut digits: [u8; 10] = [0; 10];
    let mut n: usize = 0;
    let mut rest: u32 = value;
    loop {
        digits[9 - n] = b'0' + (rest % 10) as u8;
        n += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    print(slice(&raw const digits[10 - n], n));
}

fn reason(reason: core::PanicReason) -> *const [u8] {
    match reason {
        .DivisionByZero => &raw const b"division by zero",
        .IndexOutOfBounds => &raw const b"index out of bounds",
        .AssertionFailed => &raw const b"assertion failed",
        .NoVariant => &raw const b"enum value is no variant",
        .FieldOutOfRange => &raw const b"value does not fit its field",
    }
}

// Prints `<reason>[: <message>] at <file>:<line>:<column>`; the message of
// these checks is empty (ADR 0053).
panic fn on_panic(info: *const core::PanicInfo) -> ! {
    print(reason((*info).reason));
    if len((*info).message) > 0 {
        print(&raw const b": ");
        print((*info).message);
    }
    print(&raw const b" at ");
    print((*info).file);
    print(&raw const b":");
    print_u32((*info).line);
    print(&raw const b":");
    print_u32((*info).column);
    print(&raw const b"\n");
    exit(1)
}
