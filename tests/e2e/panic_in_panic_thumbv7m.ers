// A check that fails inside the panic function does not enter it again (ADR
// 0121): the guard at its start sees that the panic function has run, and spins.
// The entry function starts SysTick, as `interrupt_systick.ers` does, enables
// interrupts and fails a check. The panic function prints `first`, says that it
// is about to fail, and fails a check of its own. The second panic spins with
// interrupts enabled, so SysTick's handler runs, finds the panic function past
// its first check, prints `stopped` and exits with 1. Without the guard, the
// program would print `first` again. Before then the handler does nothing, so
// that the output does not depend on when it fires.
// takes-exceptions: yes
// targets: thumbv7m-none-eabi
// expect-output: first
// expect-output: stopped
// expect-exit: 1

mod board;
use board::{exit, print, print_u32};
use core::arch::Vector;

// SysTick (ARMv7-M), as in `interrupt_systick.ers`: control and status (bit 0
// enables the counter, bit 1 the interrupt, bit 2 selects the processor clock),
// reload value and current value.
const SYST_CSR: *mut volatile u32 = 0xE000_E010 as *mut volatile u32;
const SYST_RVR: *mut volatile u32 = 0xE000_E014 as *mut volatile u32;
const SYST_CVR: *mut volatile u32 = 0xE000_E018 as *mut volatile u32;

// Set by the panic function when it is about to fail its own check.
static mut SECOND: bool = false;

interrupt fn tick() at Vector::SysTick {
    if SECOND {
        print(&b"stopped\n");
        exit(1)
    }
}

fn divide(a: u32, b: u32) -> u32 {
    a + a / b
}

entry fn main() -> ! {
    unsafe { *SYST_RVR = 10_000; }
    unsafe { *SYST_CVR = 0; }
    unsafe { *SYST_CSR = 7; }
    unsafe { core::arch::enable_interrupts(); }
    print_u32(divide(10, 0));
    exit(2)
}

panic fn on_panic() -> ! {
    print(&b"first\n");
    critical { SECOND = true; }
    print_u32(divide(1, 0));
    exit(3)
}
