// References to slices across the C ABI (ADR 0108, "Signatures and the ABI"):
// a `&[T]` or a `&mut [T]` crosses as the slice does, the C struct
// `{ T *ptr; size_t len; }` in two registers (ADR 0025, 0075). An `extern fn`
// takes a `&[u8]` (a sum), a `&mut [u8]` (a fill) and a `&[u32]`; an
// `#[export]` function takes a `&[u32]` and one a `&[u8]`, and C calls both.
// A reference to an array converts to the slice (`&buf`, `&b"..."`) in the
// calls of both sides (ADR 0108).
// link-c: slice_references_c.c
// expect-output: sum 21
// expect-output: filled 54
// expect-output: words 600000
// expect-output: empty 0
// expect-output: from c 1010
// expect-output: array 54
// expect-output: literal 294
// expect-output: erebos 600000
// expect-output: blank 0
// expect-exit: 0

mod board;
use board::{exit, putc};

extern fn c_sum(s: &[u8]) -> u32;
extern fn c_fill(s: &mut [u8], b: u8);
extern fn c_sum_words(s: &[u32]) -> u32;
extern fn c_calls_erebos() -> u32;

// Called from C.
#[export]
fn erebos_sum(s: &[u32]) -> u32 {
    let mut total: u32 = 0;
    let mut i: usize = 0;
    while i < len(s) {
        total += (*s)[i];
        i += 1;
    }
    total
}

// Called from C.
#[export]
fn erebos_first_plus_len(s: &[u8]) -> u32 {
    (*s)[0] as u32 + len(s) as u32
}

fn print(s: *const [u8]) {
    let bytes: *const u8 = s as *const u8;
    let mut i: usize = 0;
    while i < len(s) {
        putc(bytes[i]);
        i += 1;
    }
}

fn print_u32(value: u32) {
    let mut digits: [u8; 10] = [0; 10];
    let mut n: usize = 0;
    let mut rest: u32 = value;
    loop {
        digits[9 - n] = b'0' + (rest % 10) as u8;
        n += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    print(slice(&raw const digits[10 - n], n));
}

entry fn main() -> ! {
    let mut buf: [u8; 6] = [1, 2, 3, 4, 5, 6];
    let whole: *mut [u8] = &raw mut buf;
    print(&raw const b"sum ");
    print_u32(c_sum(&*whole));
    putc(b'\n');

    c_fill(&mut *whole, 9);
    print(&raw const b"filled ");
    print_u32(c_sum(&*whole));
    putc(b'\n');

    let words: [u32; 3] = [100000, 200000, 300000];
    let all: *const [u32] = &raw const words;
    print(&raw const b"words ");
    print_u32(c_sum_words(&*all));
    putc(b'\n');

    let none: *const [u8] = slice(&raw const buf[0], 0);
    print(&raw const b"empty ");
    print_u32(c_sum(&*none));
    putc(b'\n');

    print(&raw const b"from c ");
    print_u32(c_calls_erebos());
    putc(b'\n');

    // The array behind `buf` and a byte string, converted where a `&[u8]` is
    // taken; an Erebos function and an empty byte string too.
    print(&raw const b"array ");
    print_u32(c_sum(&buf));
    putc(b'\n');
    print(&raw const b"literal ");
    print_u32(c_sum(&b"abc"));
    putc(b'\n');
    print(&raw const b"erebos ");
    print_u32(erebos_sum(&words));
    putc(b'\n');
    print(&raw const b"blank ");
    print_u32(c_sum(&b""));
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
