// `assert` passes silently and calls the panic function when its
// condition is false (ADR 0029).
// expect-output: checked
// expect-output: panic
// expect-exit: 1

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

fn checked(x: u32) {
    assert(x < 10);
}

entry fn main() -> ! {
    checked(3);
    putc(b'c'); putc(b'h'); putc(b'e'); putc(b'c'); putc(b'k'); putc(b'e'); putc(b'd');
    putc(b'\n');
    checked(12);
    exit(0)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c');
    putc(b'\n');
    exit(1)
}
