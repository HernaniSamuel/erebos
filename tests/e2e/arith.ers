// Integer semantics on the real instruction set (ADR 0007), printed as
// digits; exits with code 3 to exercise the failure path of `board::exit`.
// expect-output: 4 2 8 4 b
// expect-exit: 3
mod board;

entry fn main() -> ! {
    // u8 wraps: 250 + 10 == 4
    let mut w: u8 = 250;
    w += 10;
    board::putc(b'0' + w);
    board::putc(b' ');

    // Shift amounts are masked: 33 % 32 == 1, so 1 << 33 == 2
    let n: u32 = 33;
    let s: u32 = 1 << n;
    board::putc(b'0' + s as u8);
    board::putc(b' ');

    // Negation wraps: -(-128) == -128, which is 128 as a u8
    let min: i8 = -128;
    let neg: i8 = -min;
    board::putc((neg as u8) - 120 + b'0');
    board::putc(b' ');

    // Signed right shifts keep the sign: -16 >> 2 == -4
    let a: i32 = -16;
    let r: i32 = a >> 2;
    board::putc(b'0' + (0 - r) as u8);
    board::putc(b' ');

    // Bytes are integers
    board::putc(b'a' + 1);
    board::putc(b'\n');

    // The failure path of the board's exit, with exit code 3
    board::exit(3)
}

panic fn on_panic() -> ! {
    loop {}
}
