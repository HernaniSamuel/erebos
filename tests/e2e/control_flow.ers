// Loops, branches and short-circuit evaluation on the emulated CPU.
// expect-output: 0123456789
// expect-output: 5 7 5 1
// expect-output: ok
// expect-output: su
// expect-exit: 0
mod board;

entry fn main() -> ! {
    // while
    let mut i: u8 = 0;
    while i < 10 {
        board::putc(b'0' + i);
        i += 1;
    }
    board::putc(b'\n');

    // loop with a value: the first n with n * n > 20
    let mut n: u32 = 0;
    let first: u32 = loop {
        n += 1;
        if n * n > 20 {
            break n;
        }
    };
    board::putc(b'0' + first as u8);
    board::putc(b' ');

    // if as an expression, with else if
    let pick: u8 = if first > 4 { 7 } else if first > 2 { 8 } else { 9 };
    board::putc(b'0' + pick);
    board::putc(b' ');

    // continue: count the even numbers below 10
    let mut k: u8 = 0;
    let mut evens: u8 = 0;
    while k < 10 {
        k += 1;
        if k & 1 == 1 {
            continue;
        }
        evens += 1;
    }
    board::putc(b'0' + evens);
    board::putc(b' ');

    // bool converts to integers
    let three: u8 = 3;
    board::putc(b'0' + (three < 4) as u8);
    board::putc(b'\n');

    // && and || skip their right side when the left decides
    let a: bool = false && { board::putc(b'X'); true };
    let b: bool = true || { board::putc(b'Y'); true };
    let c: bool = true && { board::putc(b'o'); true };
    let d: bool = false || { board::putc(b'k'); true };
    board::putc(b'\n');

    // comparisons follow signedness
    let neg: i8 = -1;
    if neg < 0 {
        board::putc(b's');
    }
    let big: u8 = 255;
    if big > 0 {
        board::putc(b'u');
    }
    board::putc(b'\n');

    board::exit(0)
}

panic fn on_panic() -> ! {
    loop {}
}
