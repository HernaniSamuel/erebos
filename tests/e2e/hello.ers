// Writes to the UART, then stops QEMU, both through the board module
// (ADR 0077): the smallest program that prints.
// expect-output: hello
// expect-exit: 0

mod board;

entry fn main() -> ! {
    board::putc(b'h');
    board::putc(b'e');
    board::putc(b'l');
    board::putc(b'l');
    board::putc(b'o');
    board::putc(b'\n');

    board::exit(0)
}

panic fn on_panic() -> ! {
    loop {}
}
