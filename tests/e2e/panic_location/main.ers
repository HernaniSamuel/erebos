// The program of M2.6 (roadmap), in four files: it averages groups of
// readings, and the panic function prints why and where it was called.
// expect-output: 3 readings, average 20
// expect-output: division by zero at main.ers:12
// expect-exit: 1
mod board;
mod fmt;
mod parse;
use parse::Sum;

fn average(s: Sum) -> u32 {
    s.total / s.count
}

use core::{PanicInfo, PanicReason};
use board::{exit, print};
use fmt::print_u32;

// The second group has no reading, so its average divides by zero above.
entry fn main() -> ! {
    report(&b"12, 30, 18");
    report(&b"none");
    exit(0)
}

fn report(text: &[u8]) {
    let s: Sum = parse::sum(text);
    let mean: u32 = average(s);
    print_u32(s.count);
    print(&b" readings, average ");
    print_u32(mean);
    print(&b"\n");
}

// Prints `<reason> at <file>:<line>` from the information the compiler
// placed for the check that failed (ADR 0053), then stops QEMU.
panic fn on_panic(info: &PanicInfo) -> ! {
    let reason: &[u8] = match info.reason {
        PanicReason::DivisionByZero => &b"division by zero",
        PanicReason::IndexOutOfBounds => &b"index out of bounds",
        PanicReason::AssertionFailed => &b"assertion failed",
        PanicReason::NoVariant => &b"enum value is no variant",
        PanicReason::FieldOutOfRange => &b"value does not fit its field",
        PanicReason::UnhandledVector => &b"vector not handled",
    };
    print(reason);
    print(&b" at ");
    unsafe { print(&*info.file); }
    print(&b":");
    print_u32(info.line);
    print(&b"\n");
    exit(1)
}
