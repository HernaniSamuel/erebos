// `#[naked]` functions (ADR 0079): the compiler writes no prologue, no
// epilogue and no frame, and the template finds the arguments in the
// registers the C ABI puts them in and returns by itself. Called from
// Erebos and from C (`#[export]`), with `const` and `sym` operands, `asm` as a
// statement and as the tail of the body. The assembly is riscv32's, which is
// why the header lists one target (the reason ADR 0079 adds to ADR 0077's).
// targets: riscv32imac-unknown-none-elf
// link-c: naked_riscv32.c
// expect-output: 7 40 42 6 31
// expect-exit: 0

mod board;
use board::{exit, putc};

extern fn c_sum_plus_one(a: u32, b: u32) -> u32;

#[export]
#[naked]
fn erebos_sum(a: u32, b: u32) -> u32 {
    asm(
        "add a0, a0, a1",
        "ret",
        options(noreturn),
    );
}

#[naked]
fn scale(a: u32) -> u32 {
    asm(
        "slli a0, a0, {shift}",
        "ret",
        shift = const 3 as u32,
        options(noreturn),
    );
}

fn add_one(x: u32) -> u32 {
    x + 1
}

#[naked]
fn plus_two(x: u32) -> u32 {
    asm(
        "addi a0, a0, 1",
        "j {next}",
        next = sym add_one,
        options(noreturn),
    );
}

#[naked]
fn sum3(a: u32, b: u32, c: u32) -> u32 {
    asm(
        "add a0, a0, a1",
        "add a0, a0, a2",
        "ret",
        options(noreturn),
    )
}

fn print_u32(n: u32) {
    if n >= 10 {
        print_u32(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

entry fn main() -> ! {
    print_u32(erebos_sum(3, 4));
    putc(b' ');
    print_u32(scale(5));
    putc(b' ');
    print_u32(plus_two(40));
    putc(b' ');
    print_u32(sum3(1, 2, 3));
    putc(b' ');
    print_u32(c_sum_plus_one(10, 20));
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
