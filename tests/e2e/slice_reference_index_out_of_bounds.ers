// Indexing a reference to a slice at its length calls the panic function
// (ADR 0108): the index is checked against the length of the `&[u8]`, not of
// the array it was made from.
// expect-output: 2
// expect-output: 3
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

fn show(s: &[u8], i: usize) {
    putc(b'0' + (*s)[i]);
    putc(b'\n');
}

entry fn main() -> ! {
    let a: [u8; 4] = [1, 2, 3, 4];
    // Two elements of four: the third one is out of bounds.
    let raw: *const [u8] = slice(&raw const a[1], 2);
    let s: &[u8] = &*raw;
    let mut i: usize = 0;
    while i <= 2 {
        show(s, i);
        i += 1;
    }
    exit(0)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c');
    putc(b'\n');
    exit(1)
}
