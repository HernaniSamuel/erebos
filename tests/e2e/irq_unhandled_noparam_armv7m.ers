// A line with no handler reaches a panic function that takes no parameter (ADR
// 0085, 0090): the one shared `__erebos_unhandled` calls it, and no information
// is built, as for a fault.
// takes-exceptions: yes
// targets: thumbv7m-none-eabi
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

#[interrupts]
enum Interrupt: u32 {
    Spi = 2,
}

entry fn main() -> ! {
    core::arch::nvic_enable(Interrupt::Spi as u32);
    core::arch::nvic_pend(Interrupt::Spi as u32);
    core::arch::enable_interrupts();
    loop {
        core::arch::wait_for_interrupt();
    }
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c'); putc(b'\n');
    exit(1)
}
