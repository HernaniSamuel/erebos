// Indexing one past the end calls the panic function (ADR 0021).
// expect-output: 1
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

entry fn main() -> ! {
    let a: [u8; 3] = [1, 2, 3];
    let mut i: usize = 0;
    let mut last: u8 = 0;
    // Runs one step too far.
    while i <= 3 {
        last = a[i];
        putc(b'0' + last);
        putc(b'\n');
        i += 3;
    }
    exit(0)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c');
    putc(b'\n');
    exit(1)
}
