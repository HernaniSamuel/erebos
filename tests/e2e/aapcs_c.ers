// Aggregates across calls on both targets (ADR 0075, 0077): Erebos and C
// call each other with structs and an array at the places where the AAPCS
// (thumbv7m) and the riscv32 ABI change how an argument travels: after an
// odd number of words, split between `r3` and the stack, a `byval`
// argument that starts in registers, a copied over-aligned `byval`, an
// `#[align(16)]` struct at top level and nested, a packed struct, returns
// of one to five bytes. Every case is one function per direction, in the
// shape `f(a0, .., a<k-1>, x, z) -> T` with `k` words before the aggregate
// `x` and a word after it. The callee checks every byte of `x`, the words
// around it and the alignment of its copy, scribbles over its copy, and
// returns a value of another pattern, which the caller checks byte by
// byte, and checks that its own `x` is unchanged. A callee that saw a wrong
// value returns a third pattern, so the caller reports it. Only the C
// callee of the 80-byte `#[align(16)]` struct does not check the alignment
// of its parameter: clang uses the `byval align 4` pointer as it is, while
// Erebos copies the argument to a slot of alignment 16 (ADR 0075).
// The comment above each case says where the AAPCS puts `x` on thumbv7m,
// counting the `sret` pointer that takes `r0` when the return is larger
// than four bytes; the placements were checked against the code clang
// generates for the C twins. A zero-sized return has its own functions
// (`empty return`).
// Portable: C is built for the target with its own clang flags.
// link-c: aapcs_c.c
// expect-output: aapcs ok
// expect-exit: 0

mod board;
use board::{exit, putc};

static mut FAILED: u32 = 0;

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
}

fn report(name: *const [u8], ok: bool) {
    if !ok {
        print(&raw const b"FAIL ");
        print(name);
        print(&raw const b"\n");
        FAILED = 1;
    }
}

// Byte `i` of the pattern `seed`.
fn fill(p: *mut u8, n: usize, seed: u8) {
    let mut i: usize = 0;
    while i < n {
        p[i] = seed + (i as u8) * 7 + 1;
        i += 1;
    }
}

fn check(p: *const u8, n: usize, seed: u8) -> bool {
    let mut i: usize = 0;
    while i < n {
        if p[i] != seed + (i as u8) * 7 + 1 {
            return false;
        }
        i += 1;
    }
    true
}

struct Empty {}

// 1 byte: `[1 x i32]`, returned as `i8`
#[copy]
struct B1 { b: [u8; 1] }
const ZERO_B1: B1 = B1 { b: [0; 1] };

// 2 bytes: returned as `i16`
#[copy]
struct B2 { b: [u8; 2] }
const ZERO_B2: B2 = B2 { b: [0; 2] };

// 3 bytes: returned as `i32`
#[copy]
struct B3 { b: [u8; 3] }
const ZERO_B3: B3 = B3 { b: [0; 3] };

// 4 bytes, alignment 1: returned as `i32`
#[copy]
struct B4 { b: [u8; 4] }
const ZERO_B4: B4 = B4 { b: [0; 4] };

// 5 bytes, alignment 1: `[2 x i32]`, returned through `sret`
#[copy]
struct B5 { b: [u8; 5] }
const ZERO_B5: B5 = B5 { b: [0; 5] };

// one word
#[copy]
struct W4 { w: u32 }
const ZERO_W4: W4 = W4 { w: 0 };

// two words: `[2 x i32]`
#[copy]
struct X8 { w: [u32; 2] }
const ZERO_X8: X8 = X8 { w: [0; 2] };

// three words: `[3 x i32]`
#[copy]
struct X12 { w: [u32; 3] }
const ZERO_X12: X12 = X12 { w: [0; 3] };

// `{ uint64_t }`: `[1 x i64]`
#[copy]
struct L8 { a: [u64; 1] }
const ZERO_L8: L8 = L8 { a: [0; 1] };

// two `u64`: `[2 x i64]`
#[copy]
struct L16 { a: [u64; 2] }
const ZERO_L16: L16 = L16 { a: [0; 2] };

// three `u64`: `[3 x i64]`
#[copy]
struct L24 { a: [u64; 3] }
const ZERO_L24: L24 = L24 { a: [0; 3] };

// 64 bytes, alignment 8: `[8 x i64]`
#[copy]
struct L64 { a: [u64; 8] }
const ZERO_L64: L64 = L64 { a: [0; 8] };

// 64 bytes, alignment 4: `[16 x i32]`
#[copy]
struct X64 { w: [u32; 16] }
const ZERO_X64: X64 = X64 { w: [0; 16] };

// 68 bytes: `byval align 4`
#[copy]
struct X68 { w: [u32; 17] }
const ZERO_X68: X68 = X68 { w: [0; 17] };

// 72 bytes, alignment 8: `byval align 8`
#[copy]
struct X72 { a: [u64; 9] }
const ZERO_X72: X72 = X72 { a: [0; 9] };

// `#[align(16)]` struct of words: `[4 x i32]`
#[align(16)]
#[copy]
struct A16 { w: [u32; 4] }
const ZERO_A16: A16 = A16 { w: [0; 4] };

// 80 bytes, `#[align(16)]`: `byval align 4`, copied to an aligned slot
#[align(16)]
#[copy]
struct A16Big { w: [u32; 20] }
const ZERO_A16BIG: A16Big = A16Big { w: [0; 20] };

// holds an `#[align(16)]` struct: `[2 x i64]`
#[copy]
struct Nest16 { a: A16 }
const ZERO_NEST16: Nest16 = Nest16 { a: A16 { w: [0; 4] } };

// holds two: `[4 x i64]`
#[copy]
struct Nest32 { a: A16, b: A16 }
const ZERO_NEST32: Nest32 = Nest32 { a: A16 { w: [0; 4] }, b: A16 { w: [0; 4] } };

// 9 bytes, `#[packed]`: `[3 x i32]`
#[packed]
#[copy]
struct P9 { a: u8, w: [u32; 2] }
const ZERO_P9: P9 = P9 { a: 0, w: [0; 2] };

const ZERO_ARR12: [u32; 3] = [0; 3];

extern fn c_empty(a: u32, e: Empty, b: u32) -> u32;
fn e_empty(a: u32, e: Empty, b: u32) -> u32 {
    a * 10 + b
}
fn t_empty() -> bool {
    c_empty(3, Empty {}, 4) == 34
}
extern fn c_calls_empty() -> u32;

// A function returning a zero-sized struct returns nothing, and no hidden
// pointer shifts its arguments.
#[export]
static mut empty_seen_by_erebos: u32 = 0;
extern static mut empty_seen_by_c: u32;
extern fn c_empty_ret(a: u32, b: u32) -> Empty;
fn e_empty_ret(a: u32, b: u32) -> Empty {
    empty_seen_by_erebos = a * 10 + b;
    Empty {}
}
fn t_empty_ret() -> bool {
    empty_seen_by_c = 0;
    let e: Empty = c_empty_ret(7, 8);
    empty_seen_by_c == 78
}
extern fn c_calls_empty_ret() -> u32;

// 1 byte: `[1 x i32]`, returned as `i8`, 0 words before it; on thumbv7m it is in r0
extern fn c_b1_0(x: B1, z: u32) -> B1;
fn e_b1_0(mut x: B1, z: u32) -> B1 {
    let mut r: B1 = ZERO_B1;
    let ok: bool = z == 99
        && check(&raw const x as *const u8, size_of(B1), 1)
        && (&raw const x as usize) % align_of(B1) == 0;
    fill(&raw mut r as *mut u8, size_of(B1), if ok { 2 } else { 3 });
    fill(&raw mut x as *mut u8, size_of(B1), 77);
    r
}
fn t_b1_0() -> bool {
    let mut x: B1 = ZERO_B1;
    fill(&raw mut x as *mut u8, size_of(B1), 1);
    let r: B1 = c_b1_0(x, 99);
    check(&raw const r as *const u8, size_of(B1), 2)
        && check(&raw const x as *const u8, size_of(B1), 1)
}
extern fn c_calls_b1_0() -> u32;

