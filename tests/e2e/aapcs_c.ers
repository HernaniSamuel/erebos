// 80 bytes, `#[align(16)]`: `byval align 4`, copied to an aligned slot, 0 words before it; on thumbv7m it is split: r1..r3, then 17 words on the stack; the `sret` pointer is `r0`
extern fn c_a16big_0(x: A16Big, z: u32) -> A16Big;
fn e_a16big_0(mut x: A16Big, z: u32) -> A16Big {
