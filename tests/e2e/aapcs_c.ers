entry fn main() -> ! {
    report(&raw const b"empty", t_empty());
    report(&raw const b"empty, called by C", c_calls_empty() != 0);
    report(&raw const b"empty return", t_empty_ret());
    report(&raw const b"empty return, called by C", c_calls_empty_ret() != 0);
    report(&raw const b"b1_0", t_b1_0());
    report(&raw const b"b1_0, called by C", c_calls_b1_0() != 0);
    report(&raw const b"b2_0", t_b2_0());
    report(&raw const b"b2_0, called by C", c_calls_b2_0() != 0);
    report(&raw const b"b3_0", t_b3_0());
    report(&raw const b"b3_0, called by C", c_calls_b3_0() != 0);
    report(&raw const b"b4_0", t_b4_0());
    report(&raw const b"b4_0, called by C", c_calls_b4_0() != 0);
    report(&raw const b"b5_0", t_b5_0());
    report(&raw const b"b5_0, called by C", c_calls_b5_0() != 0);
    report(&raw const b"w4_0", t_w4_0());
    report(&raw const b"w4_0, called by C", c_calls_w4_0() != 0);
    report(&raw const b"x8_0", t_x8_0());
    report(&raw const b"x8_0, called by C", c_calls_x8_0() != 0);
    report(&raw const b"l8_0", t_l8_0());
    report(&raw const b"l8_0, called by C", c_calls_l8_0() != 0);
    report(&raw const b"l16_0", t_l16_0());
    report(&raw const b"l16_0, called by C", c_calls_l16_0() != 0);
    report(&raw const b"l24_0", t_l24_0());
