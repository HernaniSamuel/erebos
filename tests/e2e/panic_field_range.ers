// A field written with a value that does not fit it, computed at run time,
// calls a panic function that takes the panic information (ADR 0053,
// 0059): it prints the reason, the file, the line and the column of the
// field's name in the assignment that failed. The value that fits before
// it is written.
// expect-output: 31
// expect-output: value does not fit its field at panic_field_range.ers:21:7
// expect-exit: 1

mod board;
use board::{exit, print, print_u32};

struct Lcr: u8 {
    pub word_length: u8 at 0..=1 = 3,
    pub count: u8 at 2..=4 = 0,
    pub dlab: bool at 7 = false,
}

fn with_count(l: Lcr, count: u8) -> Lcr {
    let mut m: Lcr = l;
    m.count = count;
    m
}

entry fn main() -> ! {
    print_u32(with_count(Lcr { .. }, 7) as u32);
    print(&b"\n");
    print_u32(with_count(Lcr { .. }, 8) as u32);
    exit(0)
}

fn reason(reason: core::PanicReason) -> &[u8] {
    match reason {
        .DivisionByZero => &b"division by zero",
        .IndexOutOfBounds => &b"index out of bounds",
        .AssertionFailed => &b"assertion failed",
        .NoVariant => &b"enum value is no variant",
        .FieldOutOfRange => &b"value does not fit its field",
        .UnhandledVector => &b"vector not handled",
    }
}

// Prints `<reason>[: <message>] at <file>:<line>:<column>`; the message of
// these checks is empty (ADR 0053).
panic fn on_panic(info: &core::PanicInfo) -> ! {
    print(reason(info.reason));
    if len(info.message) > 0 {
        print(&b": ");
        unsafe { print(&*info.message); }
    }
    print(&b" at ");
    unsafe { print(&*info.file); }
    print(&b":");
    print_u32(info.line);
    print(&b":");
    print_u32(info.column);
    print(&b"\n");
    exit(1)
}
