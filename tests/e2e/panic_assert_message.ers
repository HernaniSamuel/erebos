// A failing `assert` with a message calls a panic function that takes the
// panic information (ADR 0053): the message is computed on the failing path
// only, and the handler prints it with the reason, the file, the line and
// the column of `assert`.
// expect-output: passed
// expect-output: computing the message
// expect-output: assertion failed: x is too large at panic_assert_message.ers:16:5
// expect-exit: 1

fn message() -> *const [u8] {
    print(&raw const b"computing the message\n");
    &raw const b"x is too large"
}

fn checked(x: u32) {
    assert(x < 10, message());
}

entry fn main() -> ! {
    checked(3);
    print(&raw const b"passed\n");
    checked(12);
    exit(0)
}

const UART: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
const FINISHER: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        *UART = (*s)[i];
        i += 1;
    }
}

fn print_u32(value: u32) {
    let mut digits: [u8; 10] = [0; 10];
    let mut n: usize = 0;
    let mut rest: u32 = value;
    loop {
        digits[9 - n] = b'0' + (rest % 10) as u8;
        n += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    print(slice(&raw const digits[10 - n], n));
}

fn exit(code: u32) -> ! {
    *FINISHER = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

fn reason(reason: core::PanicReason) -> *const [u8] {
    match reason {
        .DivisionByZero => &raw const b"division by zero",
        .IndexOutOfBounds => &raw const b"index out of bounds",
        .AssertionFailed => &raw const b"assertion failed",
        .NoVariant => &raw const b"enum value is no variant",
    }
}

// Prints `<reason>[: <message>] at <file>:<line>:<column>` (ADR 0053).
panic fn on_panic(info: *const core::PanicInfo) -> ! {
    print(reason((*info).reason));
    if len((*info).message) > 0 {
        print(&raw const b": ");
        print((*info).message);
    }
    print(&raw const b" at ");
    print((*info).file);
    print(&raw const b":");
    print_u32((*info).line);
    print(&raw const b":");
    print_u32((*info).column);
    print(&raw const b"\n");
    exit(1)
}
