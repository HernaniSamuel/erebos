// A failing `assert` with a message calls a panic function that takes the
// panic information (ADR 0053): the message is computed on the failing path
// only, and the handler prints it with the reason, the file, the line and
// the column of `assert`.
// expect-output: passed
// expect-output: computing the message
// expect-output: assertion failed: x is too large at panic_assert_message.ers:19:5
// expect-exit: 1

mod board;
use board::{exit, print};

fn message() -> &[u8] {
    print(&b"computing the message\n");
    &b"x is too large"
}

fn checked(x: u32) {
    assert(x < 10, message());
}

entry fn main() -> ! {
    checked(3);
    print(&b"passed\n");
    checked(12);
    exit(0)
}

fn print_u32(value: u32) {
    let mut digits: [u8; 10] = [0; 10];
    let mut n: usize = 0;
    let mut rest: u32 = value;
    loop {
        digits[9 - n] = b'0' + (rest % 10) as u8;
        n += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    print(&digits[10 - n..]);
}

fn reason(reason: core::PanicReason) -> &[u8] {
    match reason {
        .DivisionByZero => &b"division by zero",
        .IndexOutOfBounds => &b"index out of bounds",
        .AssertionFailed => &b"assertion failed",
        .NoVariant => &b"enum value is no variant",
        .FieldOutOfRange => &b"value does not fit its field",
        .UnhandledVector => &b"vector not handled",
    }
}

// Prints `<reason>[: <message>] at <file>:<line>:<column>` (ADR 0053).
panic fn on_panic(info: &core::PanicInfo) -> ! {
    print(reason(info.reason));
    if len(info.message) > 0 {
        print(&b": ");
        print(&*info.message);
    }
    print(&b" at ");
    print(&*info.file);
    print(&b":");
    print_u32(info.line);
    print(&b":");
    print_u32(info.column);
    print(&b"\n");
    exit(1)
}
