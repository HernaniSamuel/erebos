// Calls between Erebos and C compiled by clang, with scalars and pointers
// (ADR 0006, 0026).
// link-c: extern_c.c
// expect-output: 42
// expect-output: -7
// expect-output: 1000000000000
// expect-output: 30
// expect-output: zzzz
// expect-exit: 0

extern fn c_add(a: u32, b: u32) -> u32;
extern fn c_negate(x: i16) -> i16;
extern fn c_mul64(a: u64, b: u64) -> u64;
extern fn c_sum_squares(n: u32) -> u32;
extern fn c_fill(buf: *mut u8, n: u32, value: u8);

// Called from C.
fn erebos_square(x: u32) -> u32 {
    x * x
}

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

fn print_u64(n: u64) {
    if n >= 10 {
        print_u64(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

entry fn main() -> ! {
    print_u64(c_add(40, 2) as u64);
    putc(b'\n');
    let negated: i16 = c_negate(7);
    if negated < 0 {
        putc(b'-');
    }
    print_u64((0 - negated) as u64);
    putc(b'\n');
    print_u64(c_mul64(1_000_000, 1_000_000));
    putc(b'\n');
    print_u64(c_sum_squares(4) as u64);
    putc(b'\n');
    let mut buf: [u8; 4] = [0; 4];
    c_fill(&raw mut buf[0], 4, b'z');
    let mut i: usize = 0;
    while i < 4 {
        putc(buf[i]);
        i += 1;
    }
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
