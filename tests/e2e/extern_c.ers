// Calls between Erebos and C compiled by clang, with scalars and pointers
// (ADR 0006, 0026).
// link-c: extern_c.c
// expect-output: 42
// expect-output: -7
// expect-output: 1000000000000
// expect-output: 30
// expect-output: zzzz
// expect-exit: 0

mod board;
use board::{exit, print_u64, putc};

// `#[stack(N)]` on each `extern fn` (ADR 0122): the depth of its C definition
// from `clang -fstack-usage` at -O0 and -O2 on both targets (the largest), with
// the C functions it calls. Where C calls an Erebos function, 256 more, until
// `--emit=stack` gives that function's depth.
#[stack(16)]
extern fn c_add(a: u32, b: u32) -> u32;
#[stack(16)]
extern fn c_negate(x: i16) -> i16;
#[stack(32)]
extern fn c_mul64(a: u64, b: u64) -> u64;
#[stack(288)]
extern fn c_sum_squares(n: u32) -> u32;
#[stack(32)]
extern fn c_fill(buf: *mut u8, n: u32, value: u8);

// Called from C.
fn erebos_square(x: u32) -> u32 {
    x * x
}

entry fn main() -> ! {
    print_u64(unsafe { c_add(40, 2) } as u64);
    putc(b'\n');
    let negated: i16 = unsafe { c_negate(7) };
    if negated < 0 {
        putc(b'-');
    }
    print_u64((0 - negated) as u64);
    putc(b'\n');
    print_u64(unsafe { c_mul64(1_000_000, 1_000_000) });
    putc(b'\n');
    print_u64(unsafe { c_sum_squares(4) } as u64);
    putc(b'\n');
    let mut buf: [u8; 4] = [0; 4];
    unsafe { c_fill(&raw mut buf[0], 4, b'z'); }
    let mut i: usize = 0;
    while i < 4 {
        putc(buf[i]);
        i += 1;
    }
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
