// A line of the chip with no handler reaches the panic function (ADR 0085, 0090):
// the default handler of the variant, `__erebos_unhandled_irq_Spi`, calls it with
// the reason `UnhandledVector`, the variant's bare name as the message, an empty
// file and line and column 0. The list has a handler at another variant, which
// does not serve this one.
// takes-exceptions: yes
// targets: thumbv7m-none-eabi
// expect-output: vector not handled: Spi at :0:0
// expect-exit: 1

mod board;
use board::{exit, print, print_u32};

#[interrupts]
enum Interrupt: u32 {
    Uart = 0,
    Spi = 5,
}

interrupt fn uart() at Interrupt::Uart {
    exit(2)
}

entry fn main() -> ! {
    core::arch::nvic_enable(Interrupt::Spi as u32);
    core::arch::nvic_pend(Interrupt::Spi as u32);
    // In the entry function, outside every `critical` block (ADR 0119).
    unsafe { core::arch::enable_interrupts(); }
    loop {
        core::arch::wait_for_interrupt();
    }
}

fn reason(reason: core::PanicReason) -> &[u8] {
    match reason {
        .DivisionByZero => &b"division by zero",
        .IndexOutOfBounds => &b"index out of bounds",
        .AssertionFailed => &b"assertion failed",
        .NoVariant => &b"enum value is no variant",
        .FieldOutOfRange => &b"value does not fit its field",
        .UnhandledVector => &b"vector not handled",
    }
}

// Prints `<reason>: <message> at <file>:<line>:<column>`.
panic fn on_panic(info: &core::PanicInfo) -> ! {
    let mut ipsr: u32 = 0;
    unsafe { asm("mrs {}, ipsr", out(reg) ipsr, options(nostack, preserves_flags)); }
    print(reason(info.reason));
    print(&b": ");
    unsafe { print(&*info.message); }
    print(&b" at ");
    unsafe { print(&*info.file); }
    print(&b":");
    print_u32(info.line);
    print(&b":");
    print_u32(info.column);
    print(&b"\n");
    // The default handler of `Spi` (line 5) called us: the line is still active.
    if ipsr != 16 + 5 {
        exit(4)
    }
    exit(1)
}
