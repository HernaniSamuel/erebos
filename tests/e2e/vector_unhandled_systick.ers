// A maskable vector without a handler reaches the panic function with its name
// (ADR 0085): SysTick and interrupts are enabled, and no handler serves it. The
// panic function runs with what the trap left: it finds `IPSR` 15.
// takes-exceptions: yes
// targets: thumbv7m-none-eabi
// expect-output: vector not handled: SysTick ipsr 15
// expect-exit: 1

mod board;
use board::{exit, putc};

const SYST_CSR: *mut volatile u32 = 0xE000_E010 as *mut volatile u32;
const SYST_RVR: *mut volatile u32 = 0xE000_E014 as *mut volatile u32;
const SYST_CVR: *mut volatile u32 = 0xE000_E018 as *mut volatile u32;

entry fn main() -> ! {
    *SYST_RVR = 10_000;
    *SYST_CVR = 0;
    *SYST_CSR = 7;
    core::arch::enable_interrupts();
    loop {
        core::arch::wait_for_interrupt();
    }
}

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
}

panic fn on_panic(info: *const core::PanicInfo) -> ! {
    match (*info).reason {
        .UnhandledVector => print(&raw const b"vector not handled"),
        _ => exit(3),
    }
    print(&raw const b": ");
    print((*info).message);
    let mut ipsr: u32 = 0;
    asm("mrs {}, ipsr", out(reg) ipsr, options(nostack, preserves_flags));
    print(&raw const b" ipsr ");
    putc(b'0' + (ipsr / 10) as u8);
    putc(b'0' + (ipsr % 10) as u8);
    putc(b'\n');
    exit(1)
}
