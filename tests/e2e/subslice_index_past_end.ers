// An index past the end of a sub-slice calls the panic function though it is
// inside its base (ADR 0108): `(*s)[1..3]` has two elements of four, so the
// index 1 reads the third one and the index 2 panics.
// expect-output: 3
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

// Element `i` of the elements `1..3` of the slice, as a digit.
fn second(s: &[u8], i: usize) -> u8 {
    (*s)[1..3][i]
}

entry fn main() -> ! {
    let buf: [u8; 4] = [1, 2, 3, 4];
    let s: &[u8] = &buf;
    putc(b'0' + second(s, 1));
    putc(b'\n');
    putc(b'0' + second(s, 2));
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c');
    putc(b'\n');
    exit(1)
}
