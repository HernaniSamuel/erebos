// A `match` without a catch-all arm, on an enum value that is no variant,
// calls a panic function that takes the panic information (ADR 0053): it
// prints the reason, the file, the line and the column of the `match`. The
// value is the byte 7, read through a `*const Mode`.
// expect-output: run
// expect-output: enum value is no variant at panic_no_variant.ers:17:5
// expect-exit: 1

mod board;
use board::{exit, print, print_u32};

enum Mode: u8 { Off = 0, Run = 1, Sleep = 3 }

static mut BYTES: [u8; 2] = [0, 0];

fn name(m: Mode) -> &[u8] {
    match m { .Off => &b"off", .Run => &b"run", .Sleep => &b"sleep" }
}

entry fn main() -> ! {
    BYTES = [1, 7];
    let modes: *const Mode = &raw const BYTES as *const Mode;
    unsafe { print(name(modes[0])); }
    print(&b"\n");
    unsafe { print(name(modes[1])); }
    exit(0)
}

fn reason(reason: core::PanicReason) -> &[u8] {
    match reason {
        .DivisionByZero => &b"division by zero",
        .IndexOutOfBounds => &b"index out of bounds",
        .AssertionFailed => &b"assertion failed",
        .NoVariant => &b"enum value is no variant",
        .FieldOutOfRange => &b"value does not fit its field",
        .UnhandledVector => &b"vector not handled",
    }
}

// Prints `<reason>[: <message>] at <file>:<line>:<column>`; the message of
// these checks is empty (ADR 0053).
panic fn on_panic(info: &core::PanicInfo) -> ! {
    print(reason(info.reason));
    if len(info.message) > 0 {
        print(&b": ");
        unsafe { print(&*info.message); }
    }
    print(&b" at ");
    unsafe { print(&*info.file); }
    print(&b":");
    print_u32(info.line);
    print(&b":");
    print_u32(info.column);
    print(&b"\n");
    exit(1)
}
