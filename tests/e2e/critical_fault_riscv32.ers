// A fault inside a `critical` block reaches the panic function with interrupts
// still masked (ADR 0085, 0086): the block's exit never runs, since the panic
// function does not return. Interrupts are enabled before the block, so `MPIE`,
// which the trap fills with the `MIE` the faulting code had, is 0 only because
// the block cleared `MIE`; the trap clears `MIE` itself.
// takes-exceptions: yes
// targets: riscv32imac-unknown-none-elf
// expect-output: vector not handled: IllegalInstruction mie 0 mpie 0
// expect-exit: 1

mod board;
use board::{exit, putc};

entry fn main() -> ! {
    core::arch::enable_interrupts();
    critical {
        asm("unimp");
    }
    exit(2)
}

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
}

panic fn on_panic(info: *const core::PanicInfo) -> ! {
    match (*info).reason {
        .UnhandledVector => print(&raw const b"vector not handled"),
        _ => exit(3),
    }
    print(&raw const b": ");
    print((*info).message);
    let mut mstatus: u32 = 0;
    asm("csrr {}, mstatus", out(reg) mstatus, options(nostack, preserves_flags));
    // `MIE` is bit 3 and `MPIE` bit 7.
    print(&raw const b" mie ");
    putc(b'0' + ((mstatus >> 3) & 1) as u8);
    print(&raw const b" mpie ");
    putc(b'0' + ((mstatus >> 7) & 1) as u8);
    putc(b'\n');
    exit(1)
}
