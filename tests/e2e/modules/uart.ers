// The board's UART (ADR 0077), and the number of lines written to it.
pub static mut LINES: u32 = 0;

pub fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        crate::board::putc((*s)[i]);
        i += 1;
    }
}

pub fn print_u32(n: u32) {
    if n >= 10 {
        print_u32(n / 10);
    }
    crate::board::putc(b'0' + (n % 10) as u8);
}

pub fn newline() {
    print(&raw const b"\n");
    LINES += 1;
}
