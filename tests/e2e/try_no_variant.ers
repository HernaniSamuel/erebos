// A `?` whose operand's tag is no variant calls the panic function
// (ADR 0046): the tag 2 of an `Option(u32)`, read through a cast pointer
// from a static byte array aligned as `Option(u32)` is. The `.Some(5)`
// before it gives 6.
// expect-output: some 6
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

// `.Some(5)`, then the tag 2.
#[align(4)]
static BYTES: [u8; 16] = [
    1, 0, 0, 0, 5, 0, 0, 0,
    2, 0, 0, 0, 0, 0, 0, 0,
];

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
    putc(b'\n');
}

fn plus_one(o: Option(u32)) -> Option(u32) {
    .Some(o? + 1)
}

fn show(o: Option(u32)) {
    match o {
        .Some(6) => print(&raw const b"some 6"),
        _ => print(&raw const b"other"),
    }
}

entry fn main() -> ! {
    let options: *const Option(u32) = &raw const BYTES as *const Option(u32);
    show(plus_one(options[0]));
    show(plus_one(options[1]));
    exit(0)
}

panic fn on_panic() -> ! {
    print(&raw const b"panic");
    exit(1)
}
