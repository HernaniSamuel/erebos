// Bit-field structs at run time (ADR 0059): locals and statics, literals
// with `..`, field reads, writes and compound assignments, `as` both ways,
// a bit-field struct inside an ordinary struct, fields written through a
// volatile pointer to a static, and an enum field holding a value that is
// no variant, matched with a catch-all arm. Reserved bits are 0 in a
// literal, kept by a field write and carried by `as` both ways. The
// inputs go through a volatile static, so that the optimizer cannot fold
// the shifts and masks away.
// expect-output: defaults 0x03
// expect-output: literal 0x9A
// expect-output: reads 2 false even true
// expect-output: writes 0x0D
// expect-output: compound 7 31 false 0x01F7
// expect-output: reserved 0x60 0x7A 0x007A 0x0000007A
// expect-output: reserved 0x7005 0x7009 0x00FC0000 0x00FCBEEF
// expect-output: signed -102 154
// expect-output: in a struct 7 0x83 0x8806 0x5A010009
// expect-output: static 0x88 true odd
// expect-output: volatile 0x5A031235 0x5A even
// expect-output: enum field 2 no variant 0x13
// expect-exit: 0

enum Parity: u8 { None = 0, Odd = 1, Even = 3 }

// As the 16550's line control register; bits 5 and 6 are reserved.
struct Lcr: u8 {
    pub word_length: u8 at 0..=1 = 3,
    pub two_stop_bits: bool at 2 = false,
    pub parity: Parity at 3..=4 = .None,
    pub dlab: bool at 7 = false,
}

// Bits 12 to 14 are reserved.
struct Status: u16 {
    pub count: u8 at 0..=3,
    pub level: u16 at 4..=11 = 0x80,
    pub ready: bool at 15 = true,
}

// Bits 18 to 23 are reserved.
struct Control: u32 {
    pub low: u16 at 0..=15,
    pub mode: Parity at 16..=17 = .Odd,
    pub high: u8 at 24..=31 = 0xAB,
}

struct Port { id: u8, lcr: Lcr, status: Status, control: Control }

static mut SAVED: Lcr = Lcr { dlab: true, .. };
static mut DEVICE: Control = Control { low: 0x1234, .. };
static mut SCRATCH: u32 = 0;

// `x`, written to and read back from a volatile static.
fn hidden(x: u32) -> u32 {
    let p: *mut volatile u32 = &raw mut SCRATCH as *mut volatile u32;
    *p = x;
    *p
}

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
}

fn print_u64(n: u64) {
    if n >= 10 {
        print_u64(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

fn print_i64(n: i64) {
    if n < 0 {
        putc(b'-');
        print_u64((0 - n) as u64);
    } else {
        print_u64(n as u64);
    }
}

// ` 0x` and `digits` hex digits.
fn print_hex(value: u64, digits: u32) {
    print(&raw const b" 0x");
    let mut shift: u32 = digits * 4;
    while shift > 0 {
        shift -= 4;
        let digit: u8 = ((value >> shift) & 0xF) as u8;
        putc(if digit < 10 { b'0' + digit } else { b'A' + digit - 10 });
    }
}

fn print_bool(b: bool) {
    print(if b { &raw const b" true" } else { &raw const b" false" });
}

fn parity_name(p: Parity) -> *const [u8] {
    match p {
        .None => &raw const b" none",
        .Odd => &raw const b" odd",
        .Even => &raw const b" even",
        _ => &raw const b" no variant",
    }
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

entry fn main() -> ! {
    // Defaults; the reserved bits are 0.
    let defaults: Lcr = Lcr { .. };
    print(&raw const b"defaults");
    print_hex(defaults as u64, 2);
    putc(b'\n');

    // Fields in another order than declared, a value computed at run time.
    let lcr: Lcr = Lcr { parity: .Even, dlab: true, word_length: hidden(2) as u8, .. };
    print(&raw const b"literal");
    print_hex(lcr as u64, 2);
    putc(b'\n');

    print(&raw const b"reads ");
    print_u64(lcr.word_length as u64);
    print_bool(lcr.two_stop_bits);
    print(parity_name(lcr.parity));
    print_bool(lcr.dlab);
    putc(b'\n');

    let mut m: Lcr = lcr;
    m.word_length = hidden(1) as u8;
    m.dlab = false;
    m.parity = .Odd;
    m.two_stop_bits = true;
    print(&raw const b"writes");
    print_hex(m as u64, 2);
    putc(b'\n');

    let mut s: Status = Status { count: hidden(5) as u8, .. };
    s.count += 3;
    s.count -= 1;
    s.level >>= 3;
    s.level |= 0x0F;
    s.ready = !s.ready;
    print(&raw const b"compound ");
    print_u64(s.count as u64);
    putc(b' ');
    print_u64(s.level as u64);
    print_bool(s.ready);
    print_hex(s as u64, 4);
    putc(b'\n');

    // Reserved bits set by `as` stay through field writes, and come back
    // out through `as` to every width.
    let mut r: Lcr = hidden(0x60) as u8 as Lcr;
    print(&raw const b"reserved");
    print_hex(r as u64, 2);
    r.word_length = 2;
    r.parity = .Even;
    print_hex(r as u8 as u64, 2);
    print_hex(r as u16 as u64, 4);
    print_hex(r as u32 as u64, 8);
    putc(b'\n');

    let mut st: Status = hidden(0x7005) as u16 as Status;
    print(&raw const b"reserved");
    print_hex(st as u64, 4);
    st.count = 9;
    print_hex(st as u64, 4);
    let mut c: Control = hidden(0x00FC_0000) as Control;
    print_hex(c as u64, 8);
    c.low = 0xBEEF;
    print_hex(c as u64, 8);
    putc(b'\n');

    // To a signed type, as the integer type converts.
    print(&raw const b"signed ");
    print_i64(lcr as i8 as i64);
    putc(b' ');
    print_i64(lcr as i32 as i64);
    putc(b'\n');

    let mut port: Port = Port {
        id: 7,
        lcr: Lcr { .. },
        status: Status { count: 2, .. },
        control: Control { low: 9, .. },
    };
    port.lcr.dlab = true;
    port.status.count += 4;
    port.control.high = hidden(0x5A) as u8;
    print(&raw const b"in a struct ");
    print_u64(port.id as u64);
    print_hex(port.lcr as u64, 2);
    print_hex(port.status as u64, 4);
    print_hex(port.control as u64, 8);
    putc(b'\n');

    SAVED.word_length = 0;
    SAVED.parity = .Odd;
    print(&raw const b"static");
    print_hex(SAVED as u64, 2);
    print_bool(SAVED.dlab);
    print(parity_name(SAVED.parity));
    putc(b'\n');

    let device: *mut volatile Control = &raw mut DEVICE as *mut volatile Control;
    (*device).high = 0x5A;
    (*device).mode = .Even;
    (*device).low += 1;
    print(&raw const b"volatile");
    print_hex(DEVICE as u64, 8);
    print_hex((*device).high as u64, 2);
    print(parity_name((*device).mode));
    putc(b'\n');

    // Bits 3 and 4 hold 2, which is no variant of `Parity`; a field write
    // carries it as is.
    let odd: Lcr = hidden(0x10) as u8 as Lcr;
    print(&raw const b"enum field ");
    print_u64(odd.parity as u64);
    print(parity_name(odd.parity));
    let mut carried: Lcr = Lcr { .. };
    carried.parity = odd.parity;
    print_hex(carried as u64, 2);
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}

// QEMU `virt`'s RAM in two regions of 64 MiB: the image in the first, and
// in the second a 1 MiB stack at its start, then `.data` and `.bss`.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}
