// A range past the end of a sub-slice calls the panic function though it is
// inside its base (ADR 0108): `(*s)[1..3]` has two elements of four, so `2..2`
// of it is empty and valid, and `1..3` of it panics.
// expect-output: 0
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

// The length of the elements `a..b` of the elements `1..3` of the slice.
fn inner(s: &[u8], a: usize, b: usize) -> u8 {
    let t: &[u8] = &(*s)[1..3][a..b];
    len(t) as u8
}

entry fn main() -> ! {
    let buf: [u8; 4] = [1, 2, 3, 4];
    let s: &[u8] = &buf;
    putc(b'0' + inner(s, 2, 2));
    putc(b'\n');
    putc(b'0' + inner(s, 1, 3));
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c');
    putc(b'\n');
    exit(1)
}
