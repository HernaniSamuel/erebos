// Statics of each kind read and written at run time, one aligned with
// `#[align(64)]`, one shared with C (ADR 0030). In `TICKS + bump()`,
// `TICKS` is read before the call.
// link-c: statics.c
// expect-output: 10 9600
// expect-output: 41 42
// expect-output: 57600 4
// expect-output: azcd
// expect-output: aligned
// expect-output: 10 7
// expect-exit: 0

extern fn c_double_shared();
extern fn c_read_shared() -> u32;

struct Config { mode: u8, baud: u32 }

static TABLE: [u32; 4] = [1, 2, 3, 4];
static ORIGIN: Config = Config { mode: 1, baud: 9600 };
static mut TICKS: u32 = 0;
static mut CONFIG: Config = Config { mode: 3, baud: 115_200 };
static mut HISTORY: [u8; 4] = [b'a', b'b', b'c', b'd'];
#[align(64)]
static mut DMA_BUF: [u8; 8] = [0; 8];
static mut SHARED: u32 = 5;

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn print_u32(n: u32) {
    if n >= 10 {
        print_u32(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

fn print_pair(a: u32, b: u32) {
    print_u32(a);
    putc(b' ');
    print_u32(b);
    putc(b'\n');
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

fn bump() -> u32 {
    TICKS += 1;
    0
}

entry fn main() -> ! {
    print_pair(TABLE[0] + TABLE[1] + TABLE[2] + TABLE[3], ORIGIN.baud);

    TICKS = 41;
    let read: u32 = TICKS + bump();
    print_pair(read, TICKS);

    CONFIG.baud = CONFIG.baud / 2;
    CONFIG.mode += 1;
    print_pair(CONFIG.baud, CONFIG.mode as u32);

    HISTORY[1] = b'z';
    let mut i: usize = 0;
    while i < 4 {
        putc(HISTORY[i]);
        i += 1;
    }
    putc(b'\n');

    DMA_BUF[0] = 1;
    if (&raw mut DMA_BUF as usize) % 64 == 0 {
        putc(b'a'); putc(b'l'); putc(b'i'); putc(b'g'); putc(b'n'); putc(b'e'); putc(b'd');
        putc(b'\n');
    }

    c_double_shared();
    let doubled: u32 = SHARED;
    SHARED = 7;
    print_pair(doubled, c_read_shared());
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
