// A value that is not a place, indexed or under `&raw`, is the value read
// where it is written (ADR 0018), not the variable it came from: later
// writes to the variable do not show through. The same at compile time.
// expect-output: 1 1 1 1
// expect-exit: 0

mod board;
use board::{exit, putc};

fn address_of_block() -> u32 {
    let mut x: [u32; 2] = [1, 2];
    let p: *const u32 = &raw const ({ x })[0];
    x[0] = 9;
    *p
}

fn index_block() -> u32 {
    let mut x: [u32; 2] = [1, 2];
    ({ x })[{ x[0] = 9; 0 }]
}

fn digit(value: u32) {
    putc(b'0' + value as u8);
}

entry fn main() -> ! {
    digit(address_of_block());
    putc(b' ');
    digit(comptime address_of_block());
    putc(b' ');
    digit(index_block());
    putc(b' ');
    digit(comptime index_block());
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
