// A division by zero at run time calls a panic function that takes the
// panic information (ADR 0053): it prints the reason, the file, the line and
// the column of the `/`.
// expect-output: before
// expect-output: division by zero at panic_division.ers:12:11
// expect-exit: 1

mod board;
use board::{exit, print};

fn divide(a: u32, b: u32) -> u32 {
    a + a / b
}

entry fn main() -> ! {
    print(&b"before\n");
    print_u32(divide(10, 0));
    exit(0)
}

fn print_u32(value: u32) {
    let mut digits: [u8; 10] = [0; 10];
    let mut n: usize = 0;
    let mut rest: u32 = value;
    loop {
        digits[9 - n] = b'0' + (rest % 10) as u8;
        n += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    print(&digits[10 - n..]);
}

fn reason(reason: core::PanicReason) -> &[u8] {
    match reason {
        .DivisionByZero => &b"division by zero",
        .IndexOutOfBounds => &b"index out of bounds",
        .AssertionFailed => &b"assertion failed",
        .NoVariant => &b"enum value is no variant",
        .FieldOutOfRange => &b"value does not fit its field",
        .UnhandledVector => &b"vector not handled",
    }
}

// Prints `<reason>[: <message>] at <file>:<line>:<column>`; the message of
// these checks is empty (ADR 0053).
panic fn on_panic(info: &core::PanicInfo) -> ! {
    print(reason(info.reason));
    if len(info.message) > 0 {
        print(&b": ");
        unsafe { print(&*info.message); }
    }
    print(&b" at ");
    unsafe { print(&*info.file); }
    print(&b":");
    print_u32(info.line);
    print(&b":");
    print_u32(info.column);
    print(&b"\n");
    exit(1)
}
