// A division by zero at run time calls a panic function that takes the
// panic information (ADR 0053): it prints the reason, the file, the line and
// the column of the `/`.
// expect-output: before
// expect-output: division by zero at panic_division.ers:9:11
// expect-exit: 1

fn divide(a: u32, b: u32) -> u32 {
    a + a / b
}

entry fn main() -> ! {
    print(&raw const b"before\n");
    print_u32(divide(10, 0));
    exit(0)
}

const UART: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
const FINISHER: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        *UART = (*s)[i];
        i += 1;
    }
}

fn print_u32(value: u32) {
    let mut digits: [u8; 10] = [0; 10];
    let mut n: usize = 0;
    let mut rest: u32 = value;
    loop {
        digits[9 - n] = b'0' + (rest % 10) as u8;
        n += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    print(slice(&raw const digits[10 - n], n));
}

fn exit(code: u32) -> ! {
    *FINISHER = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

fn reason(reason: core::PanicReason) -> *const [u8] {
    match reason {
        .DivisionByZero => &raw const b"division by zero",
        .IndexOutOfBounds => &raw const b"index out of bounds",
        .AssertionFailed => &raw const b"assertion failed",
        .NoVariant => &raw const b"enum value is no variant",
    }
}

// Prints `<reason>[: <message>] at <file>:<line>:<column>`; the message of
// these checks is empty (ADR 0053).
panic fn on_panic(info: *const core::PanicInfo) -> ! {
    print(reason((*info).reason));
    if len((*info).message) > 0 {
        print(&raw const b": ");
        print((*info).message);
    }
    print(&raw const b" at ");
    print((*info).file);
    print(&raw const b":");
    print_u32((*info).line);
    print(&raw const b":");
    print_u32((*info).column);
    print(&raw const b"\n");
    exit(1)
}
