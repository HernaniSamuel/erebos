// Differential test of compile-time execution (ADR 0027, 0029): every
// function runs twice, once by the compiler (`comptime`) and once on the
// target, with inputs from C that LLVM cannot see through, and the two
// results must agree.
// link-c: comptime_differential.c
// expect-output: differential ok
// expect-exit: 0

extern fn opaque_u8(x: u8) -> u8;
extern fn opaque_u16(x: u16) -> u16;
extern fn opaque_u32(x: u32) -> u32;
extern fn opaque_u64(x: u64) -> u64;
extern fn opaque_i8(x: i8) -> i8;
extern fn opaque_i16(x: i16) -> i16;
extern fn opaque_i32(x: i32) -> i32;
extern fn opaque_i64(x: i64) -> i64;
extern fn opaque_usize(x: usize) -> usize;
extern fn opaque_mode(m: Mode) -> Mode;
extern fn opaque_level(l: Level) -> Level;
extern fn opaque_port(p: Port) -> Port;
extern fn opaque_code(c: Code) -> Code;

fn mix(hash: u64, value: u64) -> u64 {
    hash * 1_000_003 + value
}

fn u8_ops(a: u8, b: u8) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, (a + b) as u64);
    h = mix(h, (a - b) as u64);
    h = mix(h, (a * b) as u64);
    h = mix(h, (a / b) as u64);
    h = mix(h, (a % b) as u64);
    h = mix(h, (a << b) as u64);
    h = mix(h, (a >> b) as u64);
    h = mix(h, (a & b | a ^ b) as u64);
    h = mix(h, !a as u64);
    mix(h, (a < b) as u64)
}

fn i8_ops(a: i8, b: i8) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, (a + b) as u64);
    h = mix(h, (a - b) as u64);
    h = mix(h, (a * b) as u64);
    h = mix(h, (a / b) as u64);
    h = mix(h, (a % b) as u64);
    h = mix(h, (a >> 3) as u64);
    h = mix(h, (a << b) as u64);
    h = mix(h, (-a) as u64);
    mix(h, (a < b) as u64)
}

fn u16_ops(a: u16, b: u16) -> u64 {
    mix(mix(mix((a * b) as u64, (a / b) as u64), (a % b) as u64), (a >> b) as u64)
}

fn i16_ops(a: i16, b: i16) -> u64 {
    mix(mix(mix((a * b) as u64, (a / b) as u64), (a % b) as u64), (a >> b) as u64)
}

fn u32_ops(a: u32, b: u32) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, (a + b) as u64);
    h = mix(h, (a * b) as u64);
    h = mix(h, (a / b) as u64);
    h = mix(h, (a % b) as u64);
    h = mix(h, (a << b) as u64);
    mix(h, (a >> b) as u64)
}

fn i32_ops(a: i32, b: i32) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, (a - b) as u64);
    h = mix(h, (a * b) as u64);
    h = mix(h, (a / b) as u64);
    h = mix(h, (a % b) as u64);
    h = mix(h, (a >> b) as u64);
    mix(h, (a >= b) as u64)
}

fn u64_ops(a: u64, b: u64) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, a + b);
    h = mix(h, a * b);
    h = mix(h, a / b);
    h = mix(h, a % b);
    h = mix(h, a << b);
    mix(h, a >> b)
}

fn i64_ops(a: i64, b: i64) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, (a * b) as u64);
    h = mix(h, (a / b) as u64);
    h = mix(h, (a % b) as u64);
    h = mix(h, (a >> b) as u64);
    mix(h, (a < b) as u64)
}

fn conversions(x: i32, y: u32) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, x as u8 as u64);
    h = mix(h, x as i8 as u64);
    h = mix(h, x as i16 as u32 as u64);
    h = mix(h, x as u64);
    h = mix(h, x as i64 as u64);
    h = mix(h, y as i8 as i64 as u64);
    h = mix(h, y as u16 as u64);
    h = mix(h, y as usize as u64);
    h = mix(h, (x < 0) as u8 as u64);
    mix(h, y as isize as i64 as u64)
}

// Enums convert as their integer types do, and compare by them (ADR 0035).
enum Mode: u8 { Off = 0, Run = 3, Max = 255 }
enum Level: i8 { Low = -128, Minus = -1, High = 127 }
enum Port: u16 { Data = 0x3F8, Top = 0xFFFF }
enum Code: i32 { Fault = -2_147_483_648, Neg = -70_000, Fine = 70_000 }

fn enums(m: Mode, l: Level, p: Port, c: Code) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, m as u64);
    h = mix(h, m as i8 as u64);
    h = mix(h, m as i64 as u64);
    h = mix(h, l as u8 as u64);
    h = mix(h, l as u32 as u64);
    h = mix(h, l as i64 as u64);
    h = mix(h, p as u8 as u64);
    h = mix(h, p as i16 as u64);
    h = mix(h, p as u64);
    h = mix(h, c as u16 as u64);
    h = mix(h, c as i8 as u64);
    h = mix(h, c as u64);
    h = mix(h, c as usize as u64);
    h = mix(h, (m == Mode::Run) as u64);
    h = mix(h, (l != Level::Minus) as u64);
    h = mix(h, (p == Port::Top) as u64);
    mix(h, (c == Code::Neg) as u64)
}

// `match` on integers of every width and on `bool` (ADR 0037), with
// literals, negative ones, constants, or-patterns and `let`.
const ESCAPE: u8 = 0x1B;
const NEG_LIMIT: i32 = -70_000;
const BIG: u64 = 0x1_0000_0000;

fn matches(a: u8, b: i8, c: i32, d: u64, e: i64, f: bool) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, match a {
        0 => 1,
        ESCAPE | 0x7F => 2,
        200 | 255 => 3,
        let other: u8 => other as u64 + 10,
    });
    h = mix(h, match b {
        -128 => 1,
        -1 | 1 => 2,
        127 => 3,
        let other: i8 => other as u64,
    });
    h = mix(h, match c {
        NEG_LIMIT => 1,
        -2_147_483_648 => 2,
        0 | 2_147_483_647 => 3,
        _ => 4,
    });
    h = mix(h, match d {
        BIG => 1,
        0xFFFF_FFFF_FFFF_FFFF => 2,
        0xFFFF_FFFF => 3,
        let mut other: u64 => {
            other ^= 0xFF;
            other
        }
    });
    h = mix(h, match e {
        -9_000_000_000_000_000_000 => 1,
        -1 => 2,
        4_294_967_296 => 3,
        _ => 4,
    });
    mix(h, match f {
        true => 5,
        false => 6,
    })
}

// `match` on enums (ADR 0036, 0037): variants, an `i8` enum with negative
// variants, or-patterns, a constant, and a `let` arm that a value that is
// no variant, read from a byte through a cast pointer, reaches.
const TOP: Port = Port::Top;

fn enum_matches(m: Mode, l: Level, p: Port, c: Code, raw: u8) -> u64 {
    let mut h: u64 = 0;
    h = mix(h, match m {
        Mode::Off => 1,
        Mode::Run | Mode::Max => 2,
    });
    h = mix(h, match l {
        Level::Low => 1,
        Level::Minus => 2,
        Level::High => 3,
    });
    h = mix(h, match p {
        TOP => 1,
        Port::Data => 2,
        _ => 3,
    });
    h = mix(h, match c {
        Code::Fault | Code::Neg => 1,
        let other: Code => other as u64,
    });
    let byte: u8 = raw;
    let odd: Mode = *(&raw const byte as *const Mode);
    mix(h, match odd {
        Mode::Off => 1,
        Mode::Run => 2,
        Mode::Max => 3,
        let other: Mode => other as u64 + 10,
    })
}

struct Pair { a: u32, b: u32 }
struct Mixed { flag: bool, value: u16, pair: Pair }

fn pointers(address: usize) -> u64 {
    // Addresses computed from an integer, never accessed (ADR 0029).
    let p: *const Pair = address as *const Pair;
    let field: *const u32 = &raw const (*p).b;
    let element: *const Pair = &raw const p[3];
    let byte: *const u8 = &raw const (p as *const u8)[5];
    mix(mix(field as usize as u64, element as usize as u64), byte as usize as u64)
}

fn aggregates(k: u32) -> u64 {
    let a: [Pair; 3] = [Pair { a: k, b: k + 1 }; 3];
    let mut b: [Pair; 3] = a;
    b[1].b = 7;
    let s: Pair = b[1];
    let m: Mixed = Mixed { flag: true, value: 0xFFFF, pair: s };
    let mut h: u64 = 0;
    h = mix(h, a[1].b as u64);
    h = mix(h, s.a as u64);
    h = mix(h, s.b as u64);
    h = mix(h, m.value as u64);
    h = mix(h, m.flag as u64);
    mix(h, m.pair.b as u64)
}

fn bools(v: u8) -> u64 {
    // Any nonzero byte is `true` (ADR 0022).
    let byte: u8 = v;
    let flag: *const bool = &raw const byte as *const bool;
    (*flag) as u64
}

fn layout() -> u64 {
    let mut h: u64 = size_of(Mixed) as u64;
    h = mix(h, align_of(Mixed) as u64);
    h = mix(h, offset_of(Mixed, pair) as u64);
    mix(h, size_of([Pair; 3]) as u64)
}

// Statics read at compile time, and pointers between them followed
// (ADR 0030).
struct Link { next: *const Link, value: u32 }
static RING_A: Link = Link { next: &raw const RING_B, value: 7 };
static RING_B: Link = Link { next: &raw const RING_C, value: 11 };
static RING_C: Link = Link { next: &raw const RING_A, value: 13 };
static WEIGHTS: [u16; 4] = [3, 5, 8, 13];
static HEAVIEST: *const u16 = &raw const WEIGHTS[3];

fn ring(steps: u32) -> u64 {
    let mut link: *const Link = &raw const RING_A;
    let mut h: u64 = 0;
    let mut i: u32 = 0;
    while i < steps {
        h = mix(h, (*link).value as u64);
        link = (*link).next;
        i += 1;
    }
    h
}

fn weights(k: usize) -> u64 {
    let first: *const u16 = &raw const WEIGHTS as *const u16;
    let h: u64 = mix(WEIGHTS[k % 4] as u64, *HEAVIEST as u64);
    mix(h, first[(k + 1) % 4] as u64)
}

// Slices made from arrays, statics and byte strings, and with `slice`;
// their lengths and the bytes they cover (ADR 0031).
static MESSAGES: [*const [u8]; 3] = [&raw const b"one", &raw const b"three", &raw const b""];

fn bytes_sum(s: *const [u8]) -> u64 {
    let first: *const u8 = s as *const u8;
    let mut h: u64 = len(s) as u64;
    let mut i: usize = 0;
    while i < len(s) {
        h = mix(h, first[i] as u64);
        i += 1;
    }
    h
}

fn slices(k: usize) -> u64 {
    let local: [u8; 5] = [k as u8, 2, 3, 4, 5];
    let all: *const [u8] = &raw const local;
    let middle: *const [u8] = slice(&raw const local[1], k % 4);
    let weights: *const [u16] = &raw const WEIGHTS;
    let mut h: u64 = bytes_sum(all);
    h = mix(h, bytes_sum(middle));
    h = mix(h, bytes_sum(MESSAGES[k % 3]));
    h = mix(h, bytes_sum(&raw const b"slices"));
    h = mix(h, len(weights) as u64);
    mix(h, len(&raw const local) as u64)
}

// Elements of slices, read and written through `(*s)[i]` (ADR 0031): the
// bytes of a message summed, and a buffer filled through a slice of part
// of it.
fn message_sum(k: usize) -> u64 {
    let message: *const [u8] = MESSAGES[k % 3];
    let mut h: u64 = 0;
    let mut i: usize = 0;
    while i < len(message) {
        h = mix(h, (*message)[i] as u64);
        i += 1;
    }
    let mut buffer: [u8; 8] = [0; 8];
    let part: *mut [u8] = slice(&raw mut buffer[k % 4], 4);
    i = 0;
    while i < len(part) {
        (*part)[i] = (k + i * 3) as u8;
        i += 1;
    }
    mix(h, bytes_sum(&raw const buffer))
}

// Repeats whose operand converts to the element type: a pointer to an
// array to a slice, and `*mut` to `*const` (ADR 0024, 0031).
fn repeated(k: usize) -> u64 {
    let local: [u8; 3] = [k as u8, 7, 9];
    let views: [*const [u8]; 2] = [&raw const local; 2];
    let messages: [*const [u8]; 3] = [&raw const b"dddd"; 3];
    let mut byte: u8 = (k * 5) as u8;
    let pointers: [*const u8; 2] = [&raw mut byte; 2];
    let mut h: u64 = bytes_sum(views[k % 2]);
    h = mix(h, bytes_sum(messages[k % 3]));
    mix(h, (*pointers[1]) as u64)
}

// Enums with payloads (ADR 0039): variants of every kind, built in
// constants and in `comptime` at compile time, and at run time from values
// C hides, then passed through C on the C union, compared through their
// tag and the bytes of their variant's payload, read through a
// `*const u8`: the other bytes are unspecified.
enum Small: u8 { Off = 0, On(u8) = 1 }
enum Packet: u16 {
    Empty = 0,
    Byte(u8) = 1,
    Two(u8, u32) = 2,
    Flags(bool, Mode) = 3,
    Data([u8; 3], i16) = 4,
    Nested(Pair) = 5,
    Inner(Small) = 6,
    Zero((), u8) = 7,
}

extern fn opaque_packet(p: Packet) -> Packet;

const EMPTY: Packet = Packet::Empty;
const BYTE: Packet = Packet::Byte(200);
const TWO: Packet = Packet::Two(3, 70_000);
const FLAGS: Packet = Packet::Flags(true, Mode::Max);
const DATA: Packet = Packet::Data([1, 2, 255], -2);
const NESTED: Packet = Packet::Nested(Pair { a: 7, b: 0xFFFF_FFFF });
const INNER_ON: Packet = Packet::Inner(Small::On(9));
const INNER_OFF: Packet = Packet::Inner(Small::Off);
const ZERO: Packet = Packet::Zero((), 5);

fn packet_bytes(h: u64, p: *const u8, from: usize, to: usize) -> u64 {
    let mut h: u64 = h;
    let mut i: usize = from;
    while i < to {
        h = mix(h, p[i] as u64);
        i += 1;
    }
    h
}

// Reads only the tag and the payload of the variant it names, at the
// offsets of `Packet`'s layout: tag at 0, then each payload value as a
// struct field after it.
fn packet_hash(packet: Packet) -> u64 {
    let copy: Packet = packet;
    let p: *const u8 = &raw const copy as *const u8;
    let tag: u64 = p[0] as u64 | (p[1] as u64) << 8;
    let h: u64 = mix(0, tag);
    if tag == 1 || tag == 7 {
        packet_bytes(h, p, 2, 3)
    } else if tag == 2 {
        packet_bytes(packet_bytes(h, p, 2, 3), p, 4, 8)
    } else if tag == 3 {
        packet_bytes(h, p, 2, 4)
    } else if tag == 4 {
        packet_bytes(packet_bytes(h, p, 2, 5), p, 6, 8)
    } else if tag == 5 {
        packet_bytes(h, p, 4, 12)
    } else if tag == 6 && p[2] == 1 {
        packet_bytes(h, p, 2, 4)
    } else if tag == 6 {
        packet_bytes(h, p, 2, 3)
    } else {
        h
    }
}

// `match` on enums with payloads (ADR 0040): nested patterns on integers
// of every width, `bool`, enums with and without payloads, or-patterns
// inside payloads, and `let`s, including arms reached after a nested test
// of an earlier arm fails.
fn packet_match(p: Packet) -> u64 {
    match p {
        Packet::Empty => 1,
        Packet::Byte(0 | 200) => 2,
        Packet::Byte(let b: u8) => mix(3, b as u64),
        Packet::Two(3, 70_000) => 4,
        Packet::Two(let a: u8, 70_000 | 0xFFFF_FFFF) => mix(5, a as u64),
        Packet::Two(_, let b: u32) => mix(6, b as u64),
        Packet::Flags(true, Mode::Max) => 7,
        Packet::Flags(false, Mode::Off | Mode::Run) => 8,
        Packet::Flags(let f: bool, let m: Mode) => mix(mix(9, if f { 1 } else { 0 }), m as u64),
        Packet::Data(let d: [u8; 3], -2) => mix(10, d[0] as u64 + d[2] as u64),
        Packet::Data(_, let x: i16) => mix(11, x as u64),
        Packet::Nested(let pair: Pair) => mix(12, pair.a as u64 + pair.b as u64),
        Packet::Inner(Small::On(9)) => 13,
        Packet::Inner(Small::On(let x: u8)) => mix(14, x as u64),
        Packet::Inner(Small::Off) => 15,
        Packet::Zero(_, let z: u8) => mix(16, z as u64),
    }
}

enum Widths: u8 {
    U(u16, u64) = 0,
    S(i8, i32, i64) = 1,
    E(Level, Code, Port) = 2,
}

extern fn opaque_widths(w: Widths) -> Widths;

fn widths_match(w: Widths) -> u64 {
    match w {
        Widths::U(0xFFFF, 0xFFFF_FFFF_FFFF_FFFF) => 1,
        Widths::U(1 | 2, let x: u64) => mix(2, x),
        Widths::U(let a: u16, 0x1_0000_0000) => mix(3, a as u64),
        Widths::U(_, _) => 4,
        Widths::S(-128, -2_147_483_648, -9_000_000_000_000_000_000) => 5,
        Widths::S(-1, let b: i32, -1 | 1) => mix(6, b as u64),
        Widths::S(let a: i8, _, let c: i64) => mix(mix(7, a as u64), c as u64),
        Widths::E(Level::Low, Code::Fault, Port::Top) => 8,
        Widths::E(Level::Minus | Level::High, Code::Neg, _) => 9,
        Widths::E(let l: Level, let c: Code, let p: Port) => {
            mix(mix(mix(10, l as u64), c as u64), p as u64)
        }
    }
}

// Bindings in or-patterns (ADR 0041): one variable bound by alternatives
// from different variants and from different positions of one variant, at
// the top and in an or-pattern nested in a payload, and `let mut` in every
// alternative, assigned in the arm. A value two alternatives match binds
// what the first of them binds: `Duo::Pair(5, 7)` binds 5.
enum Side: u8 { Left(u8) = 0, Right(u8) = 1, Wide(u16) = 2, Mid = 3 }
enum Duo: u16 {
    Pair(u8, u8) = 0,
    One(u8) = 1,
    Wrap(Side, u8) = 2,
    Empty = 3,
}

extern fn opaque_duo(d: Duo) -> Duo;

fn duo_match(d: Duo) -> u64 {
    match d {
        Duo::Pair(let a: u8, 0) | Duo::Pair(0, let a: u8) | Duo::One(let a: u8) => mix(1, a as u64),
        Duo::Pair(let a: u8, 7) | Duo::Pair(5, let a: u8) => mix(7, a as u64),
        Duo::Wrap(Side::Left(let a: u8) | Side::Right(let a: u8), 7) => mix(2, a as u64),
        Duo::Wrap(Side::Mid, let mut b: u8) | Duo::Pair(1, let mut b: u8) => {
            b += 100;
            mix(3, b as u64)
        }
        Duo::Wrap(Side::Left(let a: u8) | Side::Right(let a: u8), let b: u8)
        | Duo::Pair(let a: u8, let b: u8) => mix(mix(4, a as u64), b as u64),
        Duo::Wrap(Side::Wide(let w: u16), _) => mix(5, w as u64),
        Duo::Empty => 6,
    }
}

// Chains tested arm by arm (ADR 0042): pairs(4) and ors(4), the shapes
// whose code grew exponentially, on every input; an or-pattern of variants
// nested three deep that binds a value in each alternative, followed by a
// test that fails once the value was copied; and an arm
// `Lamp::Led(true) | _`, which ends the chains of the other variants and
// takes the tag default, which a tag that is no variant reaches; and
// or-patterns mixing values and variants with payloads in `Holder`. The
// inputs reach every arm and fail each arm at each of its positions.
// Overlapping alternatives binding one variable are in `duo_match`.
enum Pairs: u8 { A(bool, bool, bool, bool, bool, bool, bool, bool) = 0 }

fn pairs_match(bits: u8) -> u64 {
    let p: Pairs = Pairs::A(
        (bits & 1) != 0, (bits & 2) != 0, (bits & 4) != 0, (bits & 8) != 0,
        (bits & 16) != 0, (bits & 32) != 0, (bits & 64) != 0, (bits & 128) != 0
    );
    match p {
        Pairs::A(true, _, _, _, true, _, _, _) => 1,
        Pairs::A(_, true, _, _, _, true, _, _) => 2,
        Pairs::A(_, _, true, _, _, _, true, _) => 3,
        Pairs::A(_, _, _, true, _, _, _, true) => 4,
        _ => 5,
    }
}

// Every byte from `from` on.
fn pairs_hash(from: u16) -> u64 {
    let mut h: u64 = 0;
    let mut bits: u16 = from;
    while bits < 256 {
        h = mix(h, pairs_match(bits as u8));
        bits += 1;
    }
    h
}

enum Ors: u8 { A(u8, u8, u8, u8) = 0 }

fn ors_match(o: Ors) -> u64 {
    match o {
        Ors::A(1 | 2 | 3, 1 | 2 | 3, 1 | 2 | 3, 1 | 2 | 3) => 1,
        Ors::A(1 | 2 | 3, 1 | 2 | 3, 1 | 2 | 3, 4) => 2,
        _ => 3,
    }
}

// Every position from 0 to 4, from the code `from` on.
fn ors_hash(from: u16) -> u64 {
    let mut h: u64 = 0;
    let mut code: u16 = from;
    while code < 625 {
        let o: Ors = Ors::A((code % 5) as u8, (code / 5 % 5) as u8, (code / 25 % 5) as u8, (code / 125) as u8);
        h = mix(h, ors_match(o));
        code += 1;
    }
    h
}

enum Leaf: u8 { A(u8) = 0, B(u8) = 1 }
enum Branch: u8 { A(Leaf) = 0, B(Leaf) = 1 }
enum Tree: u8 { A(Branch, u8) = 0, B(Branch) = 1 }

fn tree_match(t: Tree) -> u64 {
    match t {
        Tree::A(Branch::A(Leaf::A(let x: u8) | Leaf::B(let x: u8)) | Branch::B(Leaf::A(let x: u8)), 7)
        | Tree::B(Branch::B(Leaf::B(let x: u8))) => mix(1, x as u64),
        Tree::A(_, let y: u8) => mix(2, y as u64),
        Tree::B(Branch::A(Leaf::A(1 | 2) | Leaf::B(3))) => 3,
        Tree::B(Branch::A(_)) => 4,
        Tree::B(Branch::B(Leaf::A(let z: u8))) => mix(5, z as u64),
    }
}

// Each of the 12 shapes, below `Tree::A` with 7 and 8 and below
// `Tree::B`, holding `x`.
fn tree_value(k: u8, x: u8) -> Tree {
    let leaf: Leaf = if k % 2 == 0 { Leaf::A(x) } else { Leaf::B(x) };
    let branch: Branch = if k / 2 % 2 == 0 { Branch::A(leaf) } else { Branch::B(leaf) };
    if k / 4 == 0 {
        Tree::A(branch, 7)
    } else if k / 4 == 1 {
        Tree::A(branch, 8)
    } else {
        Tree::B(branch)
    }
}

fn tree_hash(from: u8) -> u64 {
    let mut h: u64 = 0;
    let mut k: u8 = from;
    while k < 12 {
        let mut x: u8 = 0;
        while x < 5 {
            h = mix(h, tree_match(tree_value(k, x)));
            x += 1;
        }
        k += 1;
    }
    h
}

enum Lamp: u8 { Off = 0, Led(bool) = 1, Write(u8, u8) = 2 }

// A `Lamp` whose tag, 9, is no variant.
static LAMP_BYTES: [u8; 3] = [9, 0, 0];

fn lamp_match(l: Lamp) -> u64 {
    match l {
        Lamp::Write(1, _) => 1,
        Lamp::Led(false) => 2,
        Lamp::Write(let a: u8, 9) => mix(3, a as u64),
        Lamp::Led(true) | _ => 4,
    }
}

fn lamp_value(k: u8) -> Lamp {
    if k == 0 {
        Lamp::Off
    } else if k == 1 {
        Lamp::Led(true)
    } else if k == 2 {
        Lamp::Led(false)
    } else if k == 3 {
        Lamp::Write(1, 5)
    } else if k == 4 {
        Lamp::Write(2, 9)
    } else if k == 5 {
        Lamp::Write(2, 8)
    } else {
        (&raw const LAMP_BYTES as *const Lamp)[0]
    }
}

fn lamp_hash(from: u8) -> u64 {
    let mut h: u64 = 0;
    let mut k: u8 = from;
    while k < 7 {
        h = mix(h, lamp_match(lamp_value(k)));
        k += 1;
    }
    h
}

enum Holder: u8 { Of(Lamp, u8) = 0, Empty = 1 }

fn holder_match(h: Holder) -> u64 {
    match h {
        Holder::Of(Lamp::Off | Lamp::Led(true), 7) => 1,
        Holder::Of(Lamp::Write(1, _) | Lamp::Off | Lamp::Led(false), let b: u8) => mix(2, b as u64),
        _ => 3,
    }
}

// Each `Lamp` of `lamp_value`, with 7 and 8 after it.
fn holder_hash(from: u8) -> u64 {
    let mut h: u64 = 0;
    let mut k: u8 = from;
    while k < 14 {
        h = mix(h, holder_match(Holder::Of(lamp_value(k / 2), 7 + k % 2)));
        k += 1;
    }
    h
}

struct Uart { thr: u8 }

fn putc(byte: u8) {
    let uart: *mut volatile Uart = 0x1000_0000 as *mut volatile Uart;
    (*uart).thr = byte;
}

fn print_u64(n: u64) {
    if n >= 10 {
        print_u64(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

fn check(id: u32, at_compile_time: u64, at_run_time: u64) -> u32 {
    if at_compile_time == at_run_time {
        return 0;
    }
    putc(b'#');
    print_u64(id as u64);
    putc(b' ');
    print_u64(at_compile_time);
    putc(b' ');
    print_u64(at_run_time);
    putc(b'\n');
    1
}

entry fn main() -> ! {
    let mut failures: u32 = 0;
    failures += check(1, comptime u8_ops(200, 100), u8_ops(opaque_u8(200), opaque_u8(100)));
    failures += check(2, comptime u8_ops(7, 9), u8_ops(opaque_u8(7), opaque_u8(9)));
    failures += check(3, comptime i8_ops(-128, -1), i8_ops(opaque_i8(-128), opaque_i8(-1)));
    failures += check(4, comptime i8_ops(-7, 2), i8_ops(opaque_i8(-7), opaque_i8(2)));
    failures += check(5, comptime u16_ops(65_000, 300), u16_ops(opaque_u16(65_000), opaque_u16(300)));
    failures += check(6, comptime i16_ops(-30_000, 7), i16_ops(opaque_i16(-30_000), opaque_i16(7)));
    failures += check(7, comptime u32_ops(4_000_000_000, 7), u32_ops(opaque_u32(4_000_000_000), opaque_u32(7)));
    failures += check(8, comptime u32_ops(3, 33), u32_ops(opaque_u32(3), opaque_u32(33)));
    failures += check(9, comptime i32_ops(-2_147_483_648, -1), i32_ops(opaque_i32(-2_147_483_648), opaque_i32(-1)));
    failures += check(10, comptime i32_ops(-7, 3), i32_ops(opaque_i32(-7), opaque_i32(3)));
    failures += check(11, comptime u64_ops(18_000_000_000_000_000_000, 3), u64_ops(opaque_u64(18_000_000_000_000_000_000), opaque_u64(3)));
    failures += check(12, comptime u64_ops(12_345_678_901, 65), u64_ops(opaque_u64(12_345_678_901), opaque_u64(65)));
    failures += check(13, comptime i64_ops(-9_000_000_000_000_000_000, 7), i64_ops(opaque_i64(-9_000_000_000_000_000_000), opaque_i64(7)));
    failures += check(14, comptime conversions(-300, 4_000_000_000), conversions(opaque_i32(-300), opaque_u32(4_000_000_000)));
    failures += check(15, comptime conversions(70_000, 200), conversions(opaque_i32(70_000), opaque_u32(200)));
    failures += check(16, comptime pointers(0x8000_0000), pointers(opaque_usize(0x8000_0000)));
    failures += check(17, comptime pointers(0xFFFF_FFF0), pointers(opaque_usize(0xFFFF_FFF0)));
    failures += check(18, comptime aggregates(41), aggregates(opaque_u32(41)));
    failures += check(19, comptime bools(2), bools(opaque_u8(2)));
    failures += check(20, comptime bools(0), bools(opaque_u8(0)));
    failures += check(21, comptime layout(), layout());
    failures += check(22, comptime ring(5), ring(opaque_u32(5)));
    failures += check(23, comptime weights(6), weights(opaque_usize(6)));
    failures += check(24, comptime slices(1), slices(opaque_usize(1)));
    failures += check(25, comptime slices(5), slices(opaque_usize(5)));
    failures += check(26, comptime message_sum(1), message_sum(opaque_usize(1)));
    failures += check(27, comptime message_sum(6), message_sum(opaque_usize(6)));
    failures += check(28, comptime message_sum(2), message_sum(opaque_usize(2)));
    failures += check(29, comptime repeated(1), repeated(opaque_usize(1)));
    failures += check(30, comptime repeated(4), repeated(opaque_usize(4)));
    failures += check(31, comptime enums(Mode::Run, Level::Minus, Port::Top, Code::Neg), enums(opaque_mode(Mode::Run), opaque_level(Level::Minus), opaque_port(Port::Top), opaque_code(Code::Neg)));
    failures += check(32, comptime enums(Mode::Max, Level::Low, Port::Data, Code::Fault), enums(opaque_mode(Mode::Max), opaque_level(Level::Low), opaque_port(Port::Data), opaque_code(Code::Fault)));
    failures += check(33, comptime enums(Mode::Off, Level::High, Port::Data, Code::Fine), enums(opaque_mode(Mode::Off), opaque_level(Level::High), opaque_port(Port::Data), opaque_code(Code::Fine)));
    failures += check(34, comptime matches(0x1B, -128, -70_000, 0x1_0000_0000, -9_000_000_000_000_000_000, true), matches(opaque_u8(0x1B), opaque_i8(-128), opaque_i32(-70_000), opaque_u64(0x1_0000_0000), opaque_i64(-9_000_000_000_000_000_000), opaque_u8(1) == 1));
    failures += check(35, comptime matches(255, -1, -2_147_483_648, 0xFFFF_FFFF_FFFF_FFFF, -1, false), matches(opaque_u8(255), opaque_i8(-1), opaque_i32(-2_147_483_648), opaque_u64(0xFFFF_FFFF_FFFF_FFFF), opaque_i64(-1), opaque_u8(0) == 1));
    failures += check(36, comptime matches(77, 1, 0, 0xFFFF_FFFF, 4_294_967_296, true), matches(opaque_u8(77), opaque_i8(1), opaque_i32(0), opaque_u64(0xFFFF_FFFF), opaque_i64(4_294_967_296), opaque_u8(1) == 1));
    failures += check(37, comptime matches(200, -77, 5, 12_345, 5, false), matches(opaque_u8(200), opaque_i8(-77), opaque_i32(5), opaque_u64(12_345), opaque_i64(5), opaque_u8(2) == 1));
    failures += check(38, comptime matches(0, 127, 2_147_483_647, 0, 0, true), matches(opaque_u8(0), opaque_i8(127), opaque_i32(2_147_483_647), opaque_u64(0), opaque_i64(0), opaque_u8(1) == 1));
    failures += check(39, comptime enum_matches(Mode::Off, Level::Low, Port::Top, Code::Fault, 7), enum_matches(opaque_mode(Mode::Off), opaque_level(Level::Low), opaque_port(Port::Top), opaque_code(Code::Fault), opaque_u8(7)));
    failures += check(40, comptime enum_matches(Mode::Max, Level::Minus, Port::Data, Code::Fine, 3), enum_matches(opaque_mode(Mode::Max), opaque_level(Level::Minus), opaque_port(Port::Data), opaque_code(Code::Fine), opaque_u8(3)));
    failures += check(41, comptime enum_matches(Mode::Run, Level::High, Port::Data, Code::Neg, 200), enum_matches(opaque_mode(Mode::Run), opaque_level(Level::High), opaque_port(Port::Data), opaque_code(Code::Neg), opaque_u8(200)));
    failures += check(42, comptime packet_hash(EMPTY), packet_hash(opaque_packet(Packet::Empty)));
    failures += check(43, comptime packet_hash(BYTE), packet_hash(opaque_packet(Packet::Byte(opaque_u8(200)))));
    failures += check(44, comptime packet_hash(TWO), packet_hash(opaque_packet(Packet::Two(opaque_u8(3), opaque_u32(70_000)))));
    failures += check(45, comptime packet_hash(FLAGS), packet_hash(opaque_packet(Packet::Flags(opaque_u8(1) == 1, opaque_mode(Mode::Max)))));
    failures += check(46, comptime packet_hash(DATA), packet_hash(opaque_packet(Packet::Data([opaque_u8(1), 2, 255], opaque_i16(-2)))));
    failures += check(47, comptime packet_hash(NESTED), packet_hash(opaque_packet(Packet::Nested(Pair { a: opaque_u32(7), b: 0xFFFF_FFFF }))));
    failures += check(48, comptime packet_hash(INNER_ON), packet_hash(opaque_packet(Packet::Inner(Small::On(opaque_u8(9))))));
    failures += check(49, comptime packet_hash(INNER_OFF), packet_hash(opaque_packet(Packet::Inner(Small::Off))));
    failures += check(50, comptime packet_hash(ZERO), packet_hash(opaque_packet(Packet::Zero((), opaque_u8(5)))));
    // Built in a `comptime` expression, whose bytes outside the variant
    // were never written; and constant data read at run time.
    failures += check(51, comptime packet_hash(Packet::Two(3, 70_000)), packet_hash(opaque_packet(TWO)));
    failures += check(52, comptime packet_hash(Packet::Nested(Pair { a: 7, b: 0xFFFF_FFFF })), packet_hash(opaque_packet(NESTED)));
    failures += check(53, comptime packet_match(EMPTY), packet_match(opaque_packet(Packet::Empty)));
    failures += check(54, comptime packet_match(BYTE), packet_match(opaque_packet(Packet::Byte(opaque_u8(200)))));
    failures += check(55, comptime packet_match(Packet::Byte(7)), packet_match(opaque_packet(Packet::Byte(opaque_u8(7)))));
    failures += check(56, comptime packet_match(TWO), packet_match(opaque_packet(Packet::Two(opaque_u8(3), opaque_u32(70_000)))));
    failures += check(57, comptime packet_match(Packet::Two(9, 0xFFFF_FFFF)), packet_match(opaque_packet(Packet::Two(opaque_u8(9), opaque_u32(0xFFFF_FFFF)))));
    failures += check(58, comptime packet_match(Packet::Two(3, 5)), packet_match(opaque_packet(Packet::Two(opaque_u8(3), opaque_u32(5)))));
    failures += check(59, comptime packet_match(FLAGS), packet_match(opaque_packet(Packet::Flags(opaque_u8(1) == 1, opaque_mode(Mode::Max)))));
    failures += check(60, comptime packet_match(Packet::Flags(false, Mode::Run)), packet_match(opaque_packet(Packet::Flags(opaque_u8(0) == 1, opaque_mode(Mode::Run)))));
    failures += check(61, comptime packet_match(Packet::Flags(true, Mode::Off)), packet_match(opaque_packet(Packet::Flags(opaque_u8(1) == 1, opaque_mode(Mode::Off)))));
    failures += check(62, comptime packet_match(DATA), packet_match(opaque_packet(Packet::Data([opaque_u8(1), 2, 255], opaque_i16(-2)))));
    failures += check(63, comptime packet_match(Packet::Data([4, 5, 6], 300)), packet_match(opaque_packet(Packet::Data([opaque_u8(4), 5, 6], opaque_i16(300)))));
    failures += check(64, comptime packet_match(NESTED), packet_match(opaque_packet(Packet::Nested(Pair { a: opaque_u32(7), b: 0xFFFF_FFFF }))));
    failures += check(65, comptime packet_match(INNER_ON), packet_match(opaque_packet(Packet::Inner(Small::On(opaque_u8(9))))));
    failures += check(66, comptime packet_match(Packet::Inner(Small::On(4))), packet_match(opaque_packet(Packet::Inner(Small::On(opaque_u8(4))))));
    failures += check(67, comptime packet_match(INNER_OFF), packet_match(opaque_packet(Packet::Inner(Small::Off))));
    failures += check(68, comptime packet_match(ZERO), packet_match(opaque_packet(Packet::Zero((), opaque_u8(5)))));
    failures += check(69, comptime widths_match(Widths::U(0xFFFF, 0xFFFF_FFFF_FFFF_FFFF)), widths_match(opaque_widths(Widths::U(opaque_u16(0xFFFF), opaque_u64(0xFFFF_FFFF_FFFF_FFFF)))));
    failures += check(70, comptime widths_match(Widths::U(2, 77)), widths_match(opaque_widths(Widths::U(opaque_u16(2), opaque_u64(77)))));
    failures += check(71, comptime widths_match(Widths::U(0xFFFF, 0x1_0000_0000)), widths_match(opaque_widths(Widths::U(opaque_u16(0xFFFF), opaque_u64(0x1_0000_0000)))));
    failures += check(72, comptime widths_match(Widths::U(5, 6)), widths_match(opaque_widths(Widths::U(opaque_u16(5), opaque_u64(6)))));
    failures += check(73, comptime widths_match(Widths::S(-128, -2_147_483_648, -9_000_000_000_000_000_000)), widths_match(opaque_widths(Widths::S(opaque_i8(-128), opaque_i32(-2_147_483_648), opaque_i64(-9_000_000_000_000_000_000)))));
    failures += check(74, comptime widths_match(Widths::S(-1, 70_000, 1)), widths_match(opaque_widths(Widths::S(opaque_i8(-1), opaque_i32(70_000), opaque_i64(1)))));
    failures += check(75, comptime widths_match(Widths::S(-1, 3, 7)), widths_match(opaque_widths(Widths::S(opaque_i8(-1), opaque_i32(3), opaque_i64(7)))));
    failures += check(76, comptime widths_match(Widths::E(Level::Low, Code::Fault, Port::Top)), widths_match(opaque_widths(Widths::E(opaque_level(Level::Low), opaque_code(Code::Fault), opaque_port(Port::Top)))));
    failures += check(77, comptime widths_match(Widths::E(Level::High, Code::Neg, Port::Data)), widths_match(opaque_widths(Widths::E(opaque_level(Level::High), opaque_code(Code::Neg), opaque_port(Port::Data)))));
    failures += check(78, comptime widths_match(Widths::E(Level::Low, Code::Neg, Port::Data)), widths_match(opaque_widths(Widths::E(opaque_level(Level::Low), opaque_code(Code::Neg), opaque_port(Port::Data)))));
    failures += check(79, comptime duo_match(Duo::Pair(5, 0)), duo_match(opaque_duo(Duo::Pair(opaque_u8(5), opaque_u8(0)))));
    failures += check(80, comptime duo_match(Duo::Pair(0, 9)), duo_match(opaque_duo(Duo::Pair(opaque_u8(0), opaque_u8(9)))));
    failures += check(81, comptime duo_match(Duo::Pair(0, 0)), duo_match(opaque_duo(Duo::Pair(opaque_u8(0), opaque_u8(0)))));
    failures += check(82, comptime duo_match(Duo::One(42)), duo_match(opaque_duo(Duo::One(opaque_u8(42)))));
    failures += check(83, comptime duo_match(Duo::Wrap(Side::Left(3), 7)), duo_match(opaque_duo(Duo::Wrap(Side::Left(opaque_u8(3)), opaque_u8(7)))));
    failures += check(84, comptime duo_match(Duo::Wrap(Side::Right(4), 7)), duo_match(opaque_duo(Duo::Wrap(Side::Right(opaque_u8(4)), opaque_u8(7)))));
    failures += check(85, comptime duo_match(Duo::Wrap(Side::Mid, 11)), duo_match(opaque_duo(Duo::Wrap(Side::Mid, opaque_u8(11)))));
    failures += check(86, comptime duo_match(Duo::Pair(1, 6)), duo_match(opaque_duo(Duo::Pair(opaque_u8(1), opaque_u8(6)))));
    failures += check(87, comptime duo_match(Duo::Wrap(Side::Left(8), 9)), duo_match(opaque_duo(Duo::Wrap(Side::Left(opaque_u8(8)), opaque_u8(9)))));
    failures += check(88, comptime duo_match(Duo::Wrap(Side::Right(250), 1)), duo_match(opaque_duo(Duo::Wrap(Side::Right(opaque_u8(250)), opaque_u8(1)))));
    failures += check(89, comptime duo_match(Duo::Pair(2, 200)), duo_match(opaque_duo(Duo::Pair(opaque_u8(2), opaque_u8(200)))));
    failures += check(90, comptime duo_match(Duo::Wrap(Side::Wide(0xBEEF), 0)), duo_match(opaque_duo(Duo::Wrap(Side::Wide(opaque_u16(0xBEEF)), opaque_u8(0)))));
    failures += check(91, comptime duo_match(Duo::Empty), duo_match(opaque_duo(Duo::Empty)));
    failures += check(92, comptime duo_match(Duo::Pair(5, 7)), duo_match(opaque_duo(Duo::Pair(opaque_u8(5), opaque_u8(7)))));
    failures += check(93, comptime duo_match(Duo::Pair(9, 7)), duo_match(opaque_duo(Duo::Pair(opaque_u8(9), opaque_u8(7)))));
    failures += check(94, comptime duo_match(Duo::Pair(5, 3)), duo_match(opaque_duo(Duo::Pair(opaque_u8(5), opaque_u8(3)))));
    // Both sides against the value the first alternative gives.
    failures += check(95, comptime duo_match(Duo::Pair(5, 7)), mix(7, 5));
    failures += check(96, duo_match(opaque_duo(Duo::Pair(opaque_u8(5), opaque_u8(7)))), mix(7, 5));
    failures += check(97, comptime pairs_hash(0), pairs_hash(opaque_u16(0)));
    failures += check(98, comptime ors_hash(0), ors_hash(opaque_u16(0)));
    failures += check(99, comptime tree_hash(0), tree_hash(opaque_u8(0)));
    failures += check(100, comptime lamp_hash(0), lamp_hash(opaque_u8(0)));
    // Both sides against the arms ADR 0042 says are taken: `x` copied
    // before the `7` fails, and the tag that is no variant.
    failures += check(101, comptime tree_match(tree_value(4, 5)), mix(2, 8));
    failures += check(102, tree_match(tree_value(opaque_u8(4), opaque_u8(5))), mix(2, 8));
    failures += check(103, comptime lamp_match(lamp_value(6)), 4);
    failures += check(104, lamp_match(lamp_value(opaque_u8(6))), 4);
    failures += check(105, comptime holder_hash(0), holder_hash(opaque_u8(0)));
    // `Lamp::Off` with 8 fails the `7` and is taken by the second arm.
    failures += check(106, comptime holder_match(Holder::Of(Lamp::Off, 8)), mix(2, 8));
    failures += check(107, holder_match(Holder::Of(lamp_value(opaque_u8(0)), opaque_u8(8))), mix(2, 8));
    if failures == 0 {
        putc(b'd'); putc(b'i'); putc(b'f'); putc(b'f'); putc(b'e'); putc(b'r'); putc(b'e');
        putc(b'n'); putc(b't'); putc(b'i'); putc(b'a'); putc(b'l'); putc(b' '); putc(b'o');
        putc(b'k'); putc(b'\n');
    }
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if failures == 0 { 0x5555 } else { (failures << 16) | 0x3333 };
    loop {}
}

panic fn on_panic() -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = (99 << 16) | 0x3333;
    loop {}
}
