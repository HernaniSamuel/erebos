// A `match` listing every variant of an enum, without a catch-all arm,
// calls the panic function on a value that is no variant (ADR 0036): the
// byte 7 read through a `*const Mode`.
// expect-output: run
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

enum Mode: u8 { Off = 0, Run = 1, Sleep = 3 }

static mut BYTES: [u8; 2] = [0, 0];

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
    putc(b'\n');
}

fn name(m: Mode) -> *const [u8] {
    match m {
        Mode::Off => &raw const b"off",
        Mode::Run => &raw const b"run",
        Mode::Sleep => &raw const b"sleep",
    }
}

entry fn main() -> ! {
    BYTES = [1, 7];
    let modes: *const Mode = &raw const BYTES as *const Mode;
    print(name(modes[0]));
    print(name(modes[1]));
    exit(0)
}

panic fn on_panic() -> ! {
    print(&raw const b"panic");
    exit(1)
}
