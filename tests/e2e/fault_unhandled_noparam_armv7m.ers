// A fault reaches a panic function that takes no parameter (ADR 0085, 0053):
// one shared default handler calls it, and no information is built.
// takes-exceptions: yes
// targets: thumbv7m-none-eabi
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

entry fn main() -> ! {
    asm("udf #0");
    exit(2)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c'); putc(b'\n');
    exit(1)
}
