<?xml version="1.0" encoding="utf-8"?>
<!--
  The devices of QEMU `virt` the program of this directory uses, at their
  addresses, with the line the UART raises (ADR 0010, 0070, 0092): the 16550
  UART, the platform-level interrupt controller and the test finisher.
  `hw/riscv/virt.c` wires the UART to the source 10 of the PLIC. Written by
  hand from QEMU's sources, not taken from a vendor. `virt.ers` is generated
  from it with `erebos svd tests/e2e/uart_interrupt_riscv32/virt.svd` and kept,
  and `tests/svd.rs` requires that they agree.
-->
<device>
  <name>QEMU_VIRT</name>
  <version>1.0</version>
  <description>The devices of QEMU's virt machine for RISC-V that the interrupt e2e program uses.</description>
  <size>32</size>
  <access>read-write</access>
  <peripherals>
    <peripheral>
      <name>UART0</name>
      <description>The 16550 UART: the console of the machine.</description>
      <baseAddress>0x10000000</baseAddress>
      <size>8</size>
      <interrupt>
        <name>UART0</name>
        <description>The UART, source 10 of the PLIC.</description>
        <value>10</value>
      </interrupt>
      <registers>
        <register>
          <name>RBR</name>
          <description>Receiver buffer: the byte received.</description>
          <addressOffset>0x0</addressOffset>
          <access>read-only</access>
        </register>
        <register>
          <name>THR</name>
          <description>Transmitter holding register: the byte to send.</description>
          <addressOffset>0x0</addressOffset>
          <access>write-only</access>
        </register>
        <register>
          <name>IER</name>
          <description>Interrupt enable: one bit per cause of interrupt, all off at reset.</description>
          <addressOffset>0x1</addressOffset>
          <resetValue>0x0</resetValue>
          <fields>
            <field>
              <name>RDI</name>
              <description>A byte received raises the interrupt.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
            <field>
              <name>THRI</name>
              <description>An empty THR raises the interrupt.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
            </field>
          </fields>
        </register>
        <register>
          <name>IIR</name>
          <description>Interrupt identification: the cause of the interrupt. Reading it takes the THR empty cause.</description>
          <addressOffset>0x2</addressOffset>
          <access>read-only</access>
          <readAction>modify</readAction>
          <fields>
            <field>
              <name>CAUSE</name>
              <description>1 when no interrupt is raised, 2 for an empty THR, 4 for a byte received.</description>
              <bitRange>[3:0]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>TEST</name>
      <description>The test finisher: writing to it stops QEMU.</description>
      <baseAddress>0x00100000</baseAddress>
      <registers>
        <register>
          <name>FINISHER</name>
          <description>What to stop with.</description>
          <addressOffset>0x0</addressOffset>
          <access>write-only</access>
          <resetValue>0x0</resetValue>
          <resetMask>0xFFFF0000</resetMask>
          <fields>
            <field>
              <name>STATUS</name>
              <description>How the machine stops.</description>
              <bitRange>[15:0]</bitRange>
              <enumeratedValues>
                <enumeratedValue><name>FAIL</name><description>Stops with failure, the exit code being CODE.</description><value>0x3333</value></enumeratedValue>
                <enumeratedValue><name>PASS</name><description>Stops with success.</description><value>0x5555</value></enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CODE</name>
              <description>The exit code of a failure.</description>
              <bitRange>[31:16]</bitRange>
            </field>
          </fields>
        </register>
      </registers>
    </peripheral>
    <peripheral>
      <name>PLIC</name>
      <description>The platform-level interrupt controller.</description>
      <baseAddress>0x0C000000</baseAddress>
      <registers>
        <register>
          <dim>96</dim>
          <dimIncrement>4</dimIncrement>
          <name>PRIORITY[%s]</name>
          <description>The priority of each source; QEMU keeps 3 bits. A source with priority 0 never interrupts.</description>
          <addressOffset>0x0</addressOffset>
        </register>
        <cluster>
          <dim>2</dim>
          <dimIncrement>0x80</dimIncrement>
          <name>ENABLE[%s]</name>
          <description>The sources a context takes: machine mode, then supervisor mode.</description>
          <addressOffset>0x2000</addressOffset>
          <register>
            <dim>3</dim>
            <dimIncrement>4</dimIncrement>
            <name>SOURCES[%s]</name>
            <description>Enable bits, 32 sources a word.</description>
            <addressOffset>0x0</addressOffset>
          </register>
        </cluster>
        <cluster>
          <dim>2</dim>
          <dimIncrement>0x1000</dimIncrement>
          <name>CTX[%s]</name>
          <description>One context of hart 0: machine mode, then supervisor mode.</description>
          <addressOffset>0x200000</addressOffset>
          <register>
            <name>THRESHOLD</name>
            <description>The lowest priority the context takes.</description>
            <addressOffset>0x0</addressOffset>
          </register>
          <register>
            <name>CLAIM</name>
            <description>Reading it takes the interrupt it names; writing the number back completes it.</description>
            <addressOffset>0x4</addressOffset>
            <readAction>modify</readAction>
          </register>
        </cluster>
      </registers>
    </peripheral>
  </peripherals>
</device>
