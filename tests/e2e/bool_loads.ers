// Every byte is a valid `bool` in memory: zero is `false`, anything else
// is `true` (ADR 0022).
// expect-output: FTTT
// expect-output: 1
// expect-exit: 0

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

// Free RAM, well away from the program and the stack.
fn scratch() -> *mut u8 {
    0x8100_0000 as *mut u8
}

fn show(byte: u8) {
    let p: *mut u8 = scratch();
    *p = byte;
    let flag: *const bool = p as *const bool;
    putc(if *flag { b'T' } else { b'F' });
}

entry fn main() -> ! {
    show(0);
    show(1);
    show(2);
    show(255);
    putc(b'\n');

    // Writing a `bool` stores exactly 1.
    let flag: *mut bool = scratch() as *mut bool;
    *flag = true;
    putc(b'0' + *scratch());
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
