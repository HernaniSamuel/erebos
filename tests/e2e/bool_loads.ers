// Every byte is a valid `bool` in memory: zero is `false`, anything else
// is `true` (ADR 0022).
// expect-output: FTTT
// expect-output: 1
// expect-exit: 0

mod board;
use board::{exit, putc};

// RAM that no section occupies (ADR 0077).
fn scratch() -> *mut u8 {
    board::SCRATCH as *mut u8
}

fn show(byte: u8) {
    let p: *mut u8 = scratch();
    *p = byte;
    let flag: *const bool = p as *const bool;
    putc(if *flag { b'T' } else { b'F' });
}

entry fn main() -> ! {
    show(0);
    show(1);
    show(2);
    show(255);
    putc(b'\n');

    // Writing a `bool` stores exactly 1.
    let flag: *mut bool = scratch() as *mut bool;
    *flag = true;
    putc(b'0' + *scratch());
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
