// Bit-field structs between Erebos and C compiled by clang (ADR 0059,
// amending 0025): a bit-field struct is passed and returned as its integer
// type, extended with zeros, so its C twin is `uint8_t`, `uint16_t` or
// `uint32_t`, in both directions. The values have their top bit set, so
// that an extension by the sign would show.
// link-c: bit_structs_c.c
// expect-output: lcr 0x83 true
// expect-output: c sees lcr 0x00000082
// expect-output: status 5 true 0x8005
// expect-output: c sees status 0x00008009
// expect-output: control 0xEFC3 0x00 0x00BEEFC3
// expect-output: c gets 0x00000083 0x00008003 12 0x78345678
// expect-exit: 0

struct Lcr: u8 {
    pub word_length: u8 at 0..=1 = 3,
    pub parity: bool at 3 = false,
    pub dlab: bool at 7 = false,
}

struct Status: u16 {
    pub count: u8 at 0..=3,
    pub ready: bool at 15 = false,
}

struct Control: u32 {
    pub low: u16 at 0..=15,
    pub high: u8 at 24..=31,
}

extern fn c_flip_dlab(l: Lcr) -> Lcr;
extern fn c_lcr_as_int(l: Lcr) -> u32;
extern fn c_status(count: u32) -> Status;
extern fn c_status_as_int(s: Status) -> u32;
extern fn c_rotate(c: Control) -> Control;
extern fn c_lcr_from_erebos() -> u32;
extern fn c_status_from_erebos() -> u32;
extern fn c_count_in_erebos() -> u32;
extern fn c_control_from_erebos() -> u32;

// Called from C.
fn erebos_lcr(dlab: bool) -> Lcr {
    Lcr { dlab: dlab, .. }
}

fn erebos_status(count: u8) -> Status {
    Status { count: count, ready: true }
}

fn erebos_status_count(s: Status) -> u32 {
    s.count as u32
}

fn erebos_control(c: Control) -> Control {
    let mut d: Control = c;
    d.high = d.low as u8;
    d
}

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn print(s: *const [u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc((*s)[i]);
        i += 1;
    }
}

fn print_u64(n: u64) {
    if n >= 10 {
        print_u64(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

// ` 0x` and `digits` hex digits.
fn print_hex(value: u64, digits: u32) {
    print(&raw const b" 0x");
    let mut shift: u32 = digits * 4;
    while shift > 0 {
        shift -= 4;
        let digit: u8 = ((value >> shift) & 0xF) as u8;
        putc(if digit < 10 { b'0' + digit } else { b'A' + digit - 10 });
    }
}

fn print_bool(b: bool) {
    print(if b { &raw const b" true" } else { &raw const b" false" });
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

entry fn main() -> ! {
    let lcr: Lcr = c_flip_dlab(Lcr { .. });
    print(&raw const b"lcr");
    print_hex(lcr as u64, 2);
    print_bool(lcr.dlab);
    putc(b'\n');

    print(&raw const b"c sees lcr");
    print_hex(c_lcr_as_int(Lcr { word_length: 2, dlab: true, .. }) as u64, 8);
    putc(b'\n');

    let status: Status = c_status(5);
    print(&raw const b"status ");
    print_u64(status.count as u64);
    print_bool(status.ready);
    print_hex(status as u64, 4);
    putc(b'\n');

    print(&raw const b"c sees status");
    print_hex(c_status_as_int(Status { count: 9, ready: true }) as u64, 8);
    putc(b'\n');

    let control: Control = c_rotate(Control { low: 0xBEEF, high: 0xC3 });
    print(&raw const b"control");
    print_hex(control.low as u64, 4);
    print_hex(control.high as u64, 2);
    print_hex(control as u64, 8);
    putc(b'\n');

    print(&raw const b"c gets");
    print_hex(c_lcr_from_erebos() as u64, 8);
    print_hex(c_status_from_erebos() as u64, 8);
    putc(b' ');
    print_u64(c_count_in_erebos() as u64);
    print_hex(c_control_from_erebos() as u64, 8);
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}

// QEMU `virt`'s RAM in two regions of 64 MiB: the image in the first, and
// in the second a 1 MiB stack at its start, then `.data` and `.bss`.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}
