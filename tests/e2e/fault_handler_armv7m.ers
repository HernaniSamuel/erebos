// A fault with a declared handler runs that handler and not the panic function
// (ADR 0084, 0085). It never returns, reads `IPSR` (3 is HardFault) and stops.
// takes-exceptions: yes
// targets: thumbv7m-none-eabi
// expect-output: hard fault 3
// expect-exit: 0

mod board;
use board::{exit, putc};
use core::arch::Vector;

interrupt fn fault() -> ! at Vector::HardFault {
    let mut ipsr: u32 = 0;
    asm("mrs {}, ipsr", out(reg) ipsr, options(nostack, preserves_flags));
    putc(b'h'); putc(b'a'); putc(b'r'); putc(b'd'); putc(b' ');
    putc(b'f'); putc(b'a'); putc(b'u'); putc(b'l'); putc(b't'); putc(b' ');
    putc(b'0' + ipsr as u8);
    putc(b'\n');
    exit(0)
}

entry fn main() -> ! {
    asm("udf #0");
    exit(2)
}

panic fn on_panic() -> ! {
    exit(99)
}
