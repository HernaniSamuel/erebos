// Indexing an empty array always calls the panic function (ADR 0021).
// expect-output: panic
// expect-exit: 1

mod board;
use board::{exit, putc};

fn zero() -> usize {
    0
}

entry fn main() -> ! {
    let empty: [u32; 0] = [];
    let x: u32 = empty[zero()];
    exit(x)
}

panic fn on_panic() -> ! {
    putc(b'p'); putc(b'a'); putc(b'n'); putc(b'i'); putc(b'c');
    putc(b'\n');
    exit(1)
}
