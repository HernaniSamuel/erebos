// `extern static`s defined in C: a variable Erebos reads and writes, and a
// table it reads, also through a pointer computed at compile time
// (ADR 0030).
// link-c: extern_statics.c
// expect-output: 40 42 42
// expect-output: 4129 16516 12387
// expect-exit: 0

mod board;
use board::{exit, print_u32, putc};

extern static mut rx_count: u32;
extern static crc_lookup: [u16; 4];
extern fn c_rx_count() -> u32;

static THIRD: *const u16 = &raw const crc_lookup[2];

entry fn main() -> ! {
    let before: u32 = unsafe { rx_count };
    unsafe { rx_count += 2; }
    print_u32(before);
    putc(b' ');
    print_u32(unsafe { rx_count });
    putc(b' ');
    print_u32(unsafe { c_rx_count() });
    putc(b'\n');

    print_u32(unsafe { crc_lookup[0] } as u32);
    putc(b' ');
    print_u32(unsafe { crc_lookup[3] } as u32);
    putc(b' ');
    unsafe { print_u32(*THIRD as u32); }
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}
