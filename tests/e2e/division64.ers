// 64-bit division on RV32 goes through the runtime support functions
// (ADR 0020), checked with values that do not fit in 32 bits.
// expect-output: 1234567890123 89 0
// expect-output: -1234567890123 -89 1234567890123 89
// expect-output: 9223372036854775807 4294967297
// expect-exit: 0

fn putc(byte: u8) {
    let thr: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
    *thr = byte;
}

fn exit(code: u32) -> ! {
    let finisher: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;
    *finisher = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 };
    loop {}
}

fn print_u64(n: u64) {
    if n >= 10 {
        print_u64(n / 10);
    }
    putc(b'0' + (n % 10) as u8);
}

fn print_i64(n: i64) {
    if n < 0 {
        putc(b'-');
        print_u64((0 - n) as u64);
    } else {
        print_u64(n as u64);
    }
}

fn udiv(a: u64, b: u64) -> u64 { a / b }
fn urem(a: u64, b: u64) -> u64 { a % b }
fn sdiv(a: i64, b: i64) -> i64 { a / b }
fn srem(a: i64, b: i64) -> i64 { a % b }

entry fn main() -> ! {
    let big: u64 = 1234567890123 * 1000 + 89;
    print_u64(udiv(big, 1000));
    putc(b' ');
    print_u64(urem(big, 1000));
    putc(b' ');
    print_u64(urem(1000, 8));
    putc(b'\n');

    let neg: i64 = 0 - big as i64;
    print_i64(sdiv(neg, 1000));
    putc(b' ');
    print_i64(srem(neg, 1000));
    putc(b' ');
    print_i64(sdiv(neg, -1000));
    putc(b' ');
    print_i64(srem(big as i64, -1000));
    putc(b'\n');

    let max: u64 = 0xFFFF_FFFF_FFFF_FFFF;
    print_u64(udiv(max, 2));
    putc(b' ');
    print_u64(udiv(max, 0xFFFF_FFFF));
    putc(b'\n');
    exit(0)
}

panic fn on_panic() -> ! {
    exit(1)
}

// QEMU `virt`'s RAM laid out as ADR 0030 had it: the image in the first
// 64 MiB, a 1 MiB stack, `.data` and `.bss` in the last 64 MiB.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}
