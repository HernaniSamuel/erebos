// The board of the tests on thumbv7m: QEMU `mps2-an385`, a Cortex-M3 (ADR
// 0074, 0077). The harness gives each program a copy of it as `board.ers`,
// which the program declares with `mod board;`. It offers what ADR 0077
// lists: `putc`, `exit` and `SCRATCH`, and `print` (ADR 0117), and
// `print_u32` and `print_u64` (ADR 0120), and holds the machine's `memory`
// block. It stops QEMU with an `asm` expression (ADR 0079) and has no C file.

// 4 MiB of RAM at 0 hold the image; the 4 MiB at 0x2000_0000 hold a 1 MiB
// stack at their start, then `.data` and `.bss`.
memory {
    region IMAGE { origin: 0x0000_0000, size: 0x0040_0000 }
    region RAM { origin: 0x2000_0000, size: 0x0040_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}

// The registers of the CMSDK UART that `putc` uses: its data register, its
// state (bit 0 is "transmit buffer full"), its control (bit 0 enables the
// transmitter) and its baud divisor.
const UART_DATA: *mut volatile u32 = 0x4000_4000 as *mut volatile u32;
const UART_STATE: *mut volatile u32 = 0x4000_4004 as *mut volatile u32;
const UART_CTRL: *mut volatile u32 = 0x4000_4008 as *mut volatile u32;
const UART_BAUDDIV: *mut volatile u32 = 0x4000_4010 as *mut volatile u32;

/// The first address of the 16 MiB of RAM at 0x2100_0000, which the
/// `memory` block leaves out: 64 KiB that no section occupies and `_start`
/// never writes, zero when QEMU starts.
pub const SCRATCH: usize = 0x2100_0000;

// Writes one byte to the UART. The divisor is the smallest QEMU accepts and
// must be set before the transmitter is enabled.
pub fn putc(byte: u8) {
    // Sound: the four constants are the addresses of the registers of the
    // machine's UART that the comment above names; writing the divisor, then
    // the control, then the data only configures and feeds it, and reading
    // its state has no effect.
    unsafe {
        *UART_BAUDDIV = 16;
        *UART_CTRL = 1;
        while (*UART_STATE & 1) != 0 {}
        *UART_DATA = byte as u32;
    }
}

// Writes the bytes of `s` to the UART, in order, through `putc` (ADR 0117).
pub fn print(s: &[u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc(s[i]);
        i += 1;
    }
}

// Writes `n` in decimal to the UART, through `putc`. The digits are written
// from the least significant to the end of a buffer of ten bytes (`u32::MAX`
// has ten), then sent from the most significant. This is the loop that stands
// for the recursion `if n >= 10 { print_u32(n / 10); } putc(b'0' + (n % 10) as
// u8)`, which Erebos does not allow (ADR 0120).
pub fn print_u32(n: u32) {
    let mut digits: [u8; 10] = [0; 10];
    let mut count: usize = 0;
    let mut rest: u32 = n;
    loop {
        digits[9 - count] = b'0' + (rest % 10) as u8;
        count += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    let mut i: usize = 0;
    while i < count {
        putc(digits[10 - count + i]);
        i += 1;
    }
}

// Writes `n` in decimal to the UART, through `putc`: `print_u32` for 64 bits,
// with a buffer of twenty bytes (`u64::MAX` has twenty).
pub fn print_u64(n: u64) {
    let mut digits: [u8; 20] = [0; 20];
    let mut count: usize = 0;
    let mut rest: u64 = n;
    loop {
        digits[19 - count] = b'0' + (rest % 10) as u8;
        count += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    let mut i: usize = 0;
    while i < count {
        putc(digits[20 - count + i]);
        i += 1;
    }
}

// Stops QEMU: 0 passes, any other code fails with it as the exit status. The
// request is SYS_EXIT_EXTENDED (0x20) with the reason ADP_Stopped_ApplicationExit
// (0x20026) and `code`, which QEMU, started with `-semihosting-config
// enable=on`, turns into its exit status. `bkpt 0xab` takes the request number
// in r0 and the address of the two-word block in r1, and leaves a result in r0
// that the request does not need.
pub fn exit(code: u32) -> ! {
    let block: [u32; 2] = [0x20026, code];
    // Sound: the semihosting request reads the two-word `block`, which lives
    // through the call, and the machine stops.
    unsafe {
        asm("bkpt 0xab", inout("r0") 0x20 as u32 => _, in("r1") &raw const block, options(nostack));
    }
    loop {}
}
