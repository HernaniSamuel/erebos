// The board of the tests on riscv32: QEMU `virt` (ADR 0010, 0077). The
// harness gives each program a copy of it as `board.ers`, which the program
// declares with `mod board;`. It offers what ADR 0077 lists: `putc`, `exit`
// and `SCRATCH`, and `print` (ADR 0117), and `print_u32` and `print_u64` (ADR
// 0120), and holds the machine's `memory` block.

// QEMU `virt`'s RAM in two regions of 64 MiB: the image in the first, and
// in the second a 1 MiB stack at its start, then `.data` and `.bss`.
memory {
    region IMAGE { origin: 0x8000_0000, size: 0x0400_0000 }
    region RAM { origin: 0x8400_0000, size: 0x0400_0000 }
    code in IMAGE;
    data in RAM;
    stack in RAM { size: 0x0010_0000 }
}

// The transmit register of the 16550 UART, and the test finisher.
const UART: *mut volatile u8 = 0x1000_0000 as *mut volatile u8;
const FINISHER: *mut volatile u32 = 0x0010_0000 as *mut volatile u32;

/// 16 MiB into `IMAGE`, far above the program: 64 KiB that no section
/// occupies and `_start` never writes, zero when QEMU starts.
pub const SCRATCH: usize = 0x8100_0000;

// Writes one byte to the UART.
pub fn putc(byte: u8) {
    // Sound: `UART` is the address of the transmit register of the machine's
    // UART, and a byte written there only sends it.
    unsafe { *UART = byte; }
}

// Writes the bytes of `s` to the UART, in order, through `putc` (ADR 0117).
pub fn print(s: &[u8]) {
    let mut i: usize = 0;
    while i < len(s) {
        putc(s[i]);
        i += 1;
    }
}

// Writes `n` in decimal to the UART, through `putc`. The digits are written
// from the least significant to the end of a buffer of ten bytes (`u32::MAX`
// has ten), then sent from the most significant. This is the loop that stands
// for the recursion `if n >= 10 { print_u32(n / 10); } putc(b'0' + (n % 10) as
// u8)`, which Erebos does not allow (ADR 0120).
pub fn print_u32(n: u32) {
    let mut digits: [u8; 10] = [0; 10];
    let mut count: usize = 0;
    let mut rest: u32 = n;
    loop {
        digits[9 - count] = b'0' + (rest % 10) as u8;
        count += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    let mut i: usize = 0;
    while i < count {
        putc(digits[10 - count + i]);
        i += 1;
    }
}

// Writes `n` in decimal to the UART, through `putc`: `print_u32` for 64 bits,
// with a buffer of twenty bytes (`u64::MAX` has twenty).
pub fn print_u64(n: u64) {
    let mut digits: [u8; 20] = [0; 20];
    let mut count: usize = 0;
    let mut rest: u64 = n;
    loop {
        digits[19 - count] = b'0' + (rest % 10) as u8;
        count += 1;
        rest /= 10;
        if rest == 0 {
            break;
        }
    }
    let mut i: usize = 0;
    while i < count {
        putc(digits[20 - count + i]);
        i += 1;
    }
}

// Stops QEMU: 0 passes, any other code fails with it as the exit status.
pub fn exit(code: u32) -> ! {
    // Sound: `FINISHER` is the address of the machine's test finisher, which
    // stops QEMU with the code written.
    unsafe { *FINISHER = if code == 0 { 0x5555 } else { (code << 16) | 0x3333 }; }
    loop {}
}
